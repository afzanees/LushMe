<%- include('partials/header', { title: 'Dashboard' }) %>
<%- include('partials/sidebar', { admin }) %>

<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet"/>

  <style>
    :root {
      --primary: #4f46e5;
      --primary-light: #eef2ff;
      --primary-hover: #4338ca;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --info: #3b82f6;
      --text: #1e293b;
      --muted: #64748b;
      --border: #e2e8f0;
      --bg: #f8fafc;
      --card: #ffffff;
      --radius: 12px;
      --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.06);
      --shadow-lg: 0 8px 30px rgba(0,0,0,0.12);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    .content-main {
      padding: 28px 32px;
    }

    /* PAGE HEADER */
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .page-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text);
      margin: 0;
    }

    .page-title span {
      color: var(--primary);
    }

    /* SEARCH BAR */
    .search-bar-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .search-input-group {
      display: flex;
      align-items: center;
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 50px;
      padding: 6px 14px;
      gap: 8px;
      transition: border-color 0.2s;
      width: 320px;
    }

    .search-input-group:focus-within {
      border-color: var(--primary);
    }

    .search-input-group i {
      color: var(--muted);
      font-size: 0.85rem;
    }

    .search-input-group input {
      border: none;
      outline: none;
      background: transparent;
      font-size: 0.875rem;
      color: var(--text);
      width: 100%;
    }

    .btn-search {
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: 8px 18px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-search:hover { background: var(--primary-hover); }

    .btn-clear {
      font-size: 0.8rem;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--border);
      border-radius: 50px;
      padding: 7px 14px;
      transition: all 0.2s;
    }

    .btn-clear:hover { color: var(--danger); border-color: var(--danger); }

    /* LAYOUT */
    .category-layout {
      display: block;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 6px;
    }

    .form-control {
      width: 100%;
      padding: 9px 12px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-size: 0.875rem;
      color: var(--text);
      background: var(--bg);
      transition: border-color 0.2s, box-shadow 0.2s;
      box-sizing: border-box;
      font-family: 'DM Sans', sans-serif;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
    }

    textarea.form-control {
      resize: vertical;
      min-height: 90px;
    }

    .file-upload-label {
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1.5px dashed var(--border);
      border-radius: 8px;
      padding: 12px;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
      background: var(--bg);
    }

    .file-upload-label:hover {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .file-upload-label i {
      color: var(--primary);
      font-size: 1.2rem;
    }

    .file-upload-label span {
      font-size: 0.8rem;
      color: var(--muted);
    }

    #categoryImageInput { display: none; }

    #imagePreview {
      width: 100%;
      max-height: 120px;
      object-fit: cover;
      border-radius: 8px;
      margin-top: 10px;
      display: none;
    }

    .error-message {
      color: var(--danger);
      font-size: 0.75rem;
      margin-top: 4px;
      display: none;
    }

    /* ADD CATEGORY BUTTON */
    .btn-add-category {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 10px 20px;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      font-family: 'DM Sans', sans-serif;
    }

    .btn-add-category:hover { background: var(--primary-hover); }
    .btn-add-category:active { transform: scale(0.98); }

    /* ADD MODAL GRID */
    .add-modal-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .add-modal-grid .full-width { grid-column: 1 / -1; }

    .btn-modal-create {
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 9px 22px;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      transition: background 0.2s;
    }

    .btn-modal-create:hover { background: var(--primary-hover); }

    /* TABLE CARD */
    .table-card {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .table-responsive { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }

    thead tr {
      background: var(--bg);
      border-bottom: 2px solid var(--border);
    }

    thead th {
      padding: 13px 14px;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.15s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f8faff; }

    tbody td {
      padding: 12px 14px;
      vertical-align: middle;
      color: var(--text);
    }

    .cat-img {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      object-fit: cover;
      cursor: pointer;
      border: 1.5px solid var(--border);
      transition: transform 0.2s;
    }

    .cat-img:hover { transform: scale(1.08); }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 50px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.03em;
    }

    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-danger  { background: #fee2e2; color: #991b1b; }

    /* ACTION BUTTONS */
    .action-group {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 5px 11px;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: filter 0.15s, transform 0.1s;
      white-space: nowrap;
      font-family: 'DM Sans', sans-serif;
    }

    .btn-action:hover { filter: brightness(0.92); }
    .btn-action:active { transform: scale(0.96); }

    .btn-edit    { background: #eff6ff; color: #2563eb; }
    .btn-delete  { background: #fef2f2; color: #dc2626; }
    .btn-list    { background: #f0fdf4; color: #16a34a; }
    .btn-unlist  { background: #fafafa; color: #64748b; }
    .btn-offer   { background: #fffbeb; color: #d97706; }
    .btn-rm-offer{ background: #fff1f2; color: #e11d48; }
    .btn-sub     { background: #f5f3ff; color: #7c3aed; }

    /* PAGINATION */
    .pagination-wrap {
      display: flex;
      justify-content: center;
      padding: 20px;
      gap: 6px;
    }

    .page-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1.5px solid var(--border);
      color: var(--text);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.15s;
    }

    .page-link:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-light); }
    .page-link.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* MODALS */
    .modal-content {
      border-radius: var(--radius);
      border: none;
      box-shadow: var(--shadow-lg);
    }

    .modal-header {
      border-bottom: 1px solid var(--border);
      padding: 18px 24px;
    }

    .modal-title {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1rem;
    }

    .modal-body { padding: 24px; }

    .modal-footer {
      border-top: 1px solid var(--border);
      padding: 16px 24px;
      gap: 10px;
    }

    .modal-edit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .modal-edit-grid .full-width {
      grid-column: 1 / -1;
    }

    .btn-modal-cancel {
      background: var(--bg);
      color: var(--muted);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      padding: 9px 20px;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
    }

    .btn-modal-save {
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 9px 22px;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      transition: background 0.2s;
    }

    .btn-modal-save:hover { background: var(--primary-hover); }

    .existing-image-preview {
      width: 72px;
      height: 72px;
      object-fit: cover;
      border-radius: 10px;
      border: 2px solid var(--border);
    }

    /* SUBCATEGORIES LIST */
    .subcategory-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .subcategory-list li {
      font-size: 0.78rem;
      color: var(--muted);
      padding: 2px 0;
    }

    .subcategory-list li::before {
      content: "›";
      margin-right: 5px;
      color: var(--primary);
    }

    .no-sub {
      font-size: 0.78rem;
      color: #c0c0c0;
      font-style: italic;
    }

    @media (max-width: 900px) {
      .category-layout {
        grid-template-columns: 1fr;
      }

      .add-card {
        position: static;
      }

      .modal-edit-grid {
        grid-template-columns: 1fr;
      }

      .search-input-group { width: 100%; }
    }
  </style>
</head>

<body>
<section class="content-main">

  <!-- PAGE HEADER -->
  <div class="page-header">
    <h2 class="page-title">Category <span>Management</span></h2>
    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <form action="/admin/category/" method="get" class="search-bar-wrap">
        <div class="search-input-group">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Search categories…" name="search" value="<%= searchQuery || '' %>"/>
        </div>
        <button class="btn-search" type="submit">Search</button>
        <% if (searchQuery) { %>
          <a href="/admin/category" class="btn-clear">Clear</a>
        <% } %>
      </form>
      <button class="btn-add-category" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <i class="fas fa-plus"></i> Add Category
      </button>
    </div>
  </div>

  <!-- MAIN LAYOUT -->
  <div class="category-layout">

    <!-- TABLE CARD -->
    <div class="table-card">
      <div class="table-responsive">
        <table id="customerTable">
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Description</th>
              <th>Image</th>
              <th>Offer</th>
              <th>Valid Until</th>
              <th>Status</th>
              <th>Subcategories</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% cat.forEach((category, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td class="cat-name"><strong><%= category.name %></strong></td>
              <td style="max-width:160px; color:var(--muted)"><%= category.description %></td>
              <td>
                <img class="cat-img"
                  src="/uploads/categoryImages/<%= category.categoryImage %>"
                  alt="img"
                  onclick="openImageModal('/uploads/categoryImages/<%= category.categoryImage %>')"
                />
              </td>
              <td>
                <% if (category.categoryOffer && category.categoryOffer > 0) { %>
                  <span style="color:var(--success); font-weight:700;"><%= category.categoryOffer %>%</span>
                <% } else { %>
                  <span style="color:#c0c0c0">—</span>
                <% } %>
              </td>
              <td style="color:var(--muted); font-size:0.8rem;">
                <%
                  let formattedDate = category.offerValidUntil
                    ? new Date(category.offerValidUntil).toLocaleDateString('en-GB')
                    : "—";
                %>
                <%= formattedDate %>
              </td>
              <td>
                <% if (category.isListed) { %>
                  <span class="badge badge-success">Listed</span>
                <% } else { %>
                  <span class="badge badge-danger">Unlisted</span>
                <% } %>
              </td>
              <td>
                <% if (category.subcategories && category.subcategories.length > 0) { %>
                  <ul class="subcategory-list">
                    <% category.subcategories.forEach(sub => { %>
                      <li><%= sub.name %><% if (sub.offer) { %> (<%= sub.offer %>%)<% } %></li>
                    <% }) %>
                  </ul>
                <% } else { %>
                  <span class="no-sub">None</span>
                <% } %>
              </td>
              <td>
                <div class="action-group">
                  <!-- Edit -->
                  <button class="btn-action btn-edit"
                    title="Edit"
                    data-bs-toggle="modal"
                    data-bs-target="#editCategoryModal"
                    onclick="populateEditModal('<%= category._id %>', '<%= category.name %>', '<%= category.description %>', '<%= category.categoryImage %>')">
                    <i class="fas fa-pen"></i> Edit
                  </button>

                  <!-- List / Unlist -->
                  <% if (category.isListed) { %>
                    <button class="btn-action btn-unlist" onclick="unlistCategory('<%= category._id %>')">
                      <i class="fas fa-eye-slash"></i> Unlist
                    </button>
                  <% } else { %>
                    <button class="btn-action btn-list" onclick="listCategory('<%= category._id %>')">
                      <i class="fas fa-eye"></i> List
                    </button>
                  <% } %>

                  <!-- Offer -->
                  <% if (!category.categoryOffer || category.categoryOffer === 0) { %>
                    <button class="btn-action btn-offer" onclick="addOffer('<%= category._id %>')">
                      <i class="fas fa-tag"></i> Add Offer
                    </button>
                  <% } else { %>
                    <button class="btn-action btn-rm-offer" onclick="deleteOffer('<%= category._id %>')">
                      <i class="fas fa-times"></i> Remove Offer
                    </button>
                  <% } %>

                  <!-- Subcategory -->
                  <button class="btn-action btn-sub" onclick="addSubcategory('<%= category._id %>')">
                    <i class="fas fa-sitemap"></i> Sub
                  </button>

                  <!-- Delete -->
                  <button class="btn-action btn-delete" onclick="deleteCategory('<%= category._id %>')">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <div id="noResults" style="display:none; text-align:center; padding:2rem; color:#64748b;">
          No customers match your search.
        </div>
      </div>

      <!-- PAGINATION -->
      <div class="pagination-wrap">
        <% if (currentPage > 1) { %>
          <a class="page-link" href="?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>">
            <i class="fas fa-chevron-left" style="font-size:0.7rem"></i>
          </a>
        <% } %>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a class="page-link <%= currentPage === i ? 'active' : '' %>"
             href="?page=<%= i %><%= searchQuery ? '&search=' + searchQuery : '' %>"><%= i %></a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a class="page-link" href="?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>">
            <i class="fas fa-chevron-right" style="font-size:0.7rem"></i>
          </a>
        <% } %>
      </div>
    </div>
  </div>

</section>

<!-- ============ ADD CATEGORY MODAL ============ -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form id="categoryForm" class="modal-content" enctype="multipart/form-data" method="POST" action="/admin/addCategory">
      <div class="modal-header">
        <h5 class="modal-title" id="addCategoryModalLabel">
          <i class="fas fa-plus-circle" style="color:var(--primary); margin-right:8px;"></i>Add New Category
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="add-modal-grid">
          <div>
            <label class="form-label">Category Name</label>
            <input type="text" name="name" placeholder="e.g. Electronics" class="form-control" id="product_name"/>
            <div id="name-error" class="error-message"></div>
          </div>
          <div>
            <label class="form-label">Category Image</label>
            <label class="file-upload-label" for="categoryImageInput">
              <i class="fas fa-cloud-upload-alt"></i>
              <span>Click to upload image</span>
            </label>
            <input type="file" name="categoryImage" id="categoryImageInput" accept="image/*"/>
            <p id="imageError" style="color:red; margin-top:5px;"></p>
            <img id="imagePreview" src="" alt="Preview" style="width:100%; max-height:100px; object-fit:cover; border-radius:8px; margin-top:10px; display:none;"/>
          </div>
          <div class="full-width">
            <label class="form-label">Description</label>
            <textarea name="description" placeholder="Short description…" class="form-control" id="descriptionId" rows="3"></textarea>
            <div id="description-error" class="error-message"></div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn-modal-create"><i class="fas fa-plus" style="margin-right:6px;"></i>Create Category</button>
      </div>
    </form>
  </div>
</div>

<!-- ============ EDIT CATEGORY MODAL ============ -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form id="editCategoryForm" class="modal-content" enctype="multipart/form-data" method="POST" action="#">
      <input type="hidden" id="edit-category-id" name="categoryId"/>
      <div class="modal-header">
        <h5 class="modal-title" id="editCategoryModalLabel">
          <i class="fas fa-pen" style="color:var(--primary); margin-right:8px;"></i>Edit Category
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="modal-edit-grid">
          <div>
            <label class="form-label">Category Name</label>
            <input type="text" name="name" class="form-control" id="edit-category-name" required/>
          </div>
          <div style="display:flex; align-items:flex-end; gap:12px;">
            <div>
              <label class="form-label">Current Image</label><br/>
              <img id="existing-category-image" src="" alt="Current" class="existing-image-preview"/>
            </div>
          </div>
          <div class="full-width">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" id="edit-category-description" rows="3" required></textarea>
          </div>
          <div class="full-width">
            <label class="form-label">Change Image <span style="color:var(--muted); font-weight:400;">(optional)</span></label>
            <input type="file" name="categoryImage" id="edit-category-image-upload" class="form-control" accept="image/png, image/jpeg"/>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn-modal-save"><i class="fas fa-check" style="margin-right:6px;"></i>Save Changes</button>
      </div>
    </form>
  </div>
</div>

<!-- IMAGE PREVIEW MODAL -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content p-3 text-center">
      <img id="modalImage" src="" alt="Full Image" class="img-fluid rounded" style="max-height:400px; object-fit:contain;"/>
      <button type="button" class="btn-modal-cancel mt-3" data-bs-dismiss="modal">Close</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script>
  // ---- ADD FORM ----
  document.getElementById('categoryForm').addEventListener('submit', handleFormSubmit);

  function handleFormSubmit(event) {
    event.preventDefault();
    if (!validateForm()) return;
    const formData = new FormData();
    formData.append("name", document.getElementById("product_name").value);
    formData.append("description", document.getElementById("descriptionId").value);
    formData.append("categoryImage", document.getElementById("categoryImageInput").files[0]);
    fetch('/admin/addCategory', { method: 'POST', body: formData })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('addCategoryModal')).hide();
          Swal.fire({ icon: 'success', title: 'Success', text: 'Category added!' }).then(() => location.reload());
        } else {
          Swal.fire({ icon: 'error', title: 'Error', text: data.message });
        }
      })
      .catch(() => Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong' }));
  }

  function validateForm() {
    clearErrorMessages();
    const name = document.getElementById("product_name").value.trim();
    const description = document.getElementById("descriptionId").value.trim();
    let isValid = true;
    if (!name) { displayErrorMessage("name-error", "Please enter a name"); isValid = false; }
    else if (!/^[a-zA-Z\s]+$/.test(name)) { displayErrorMessage("name-error", "Name should contain only alphabetic characters"); isValid = false; }
    if (!description) { displayErrorMessage("description-error", "Please enter a description"); isValid = false; }
    return isValid;
  }

  function displayErrorMessage(id, msg) {
    const el = document.getElementById(id);
    el.innerText = msg;
    el.style.display = "block";
  }

  function clearErrorMessages() {
    document.querySelectorAll('.error-message').forEach(el => { el.innerText = ""; el.style.display = "none"; });
  }

  // ---- IMAGE PREVIEW ----
  document.getElementById("categoryImageInput").addEventListener("change", function () {
    const preview = document.getElementById("imagePreview");
    if (this.files[0]) {
      const reader = new FileReader();
      reader.onload = e => { preview.src = e.target.result; preview.style.display = "block"; };
      reader.readAsDataURL(this.files[0]);
    } else {
      preview.style.display = "none";
    }
  });

  // Reset add modal on close
  document.getElementById('addCategoryModal').addEventListener('hidden.bs.modal', function () {
    document.getElementById('categoryForm').reset();
    document.getElementById('imagePreview').style.display = 'none';
    clearErrorMessages();
  });

  // ---- OPEN IMAGE MODAL ----
  function openImageModal(src) {
    document.getElementById("modalImage").src = src;
    new bootstrap.Modal(document.getElementById("imagePreviewModal")).show();
  }

  // ---- EDIT MODAL ----
  document.addEventListener("DOMContentLoaded", function () {
    document.getElementById("editCategoryForm").addEventListener("submit", function (e) {
      e.preventDefault();
      const categoryId = document.getElementById('edit-category-id').value;
      fetch(`/admin/editCategory/${categoryId}`, { method: "POST", body: new FormData(e.target) })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            Swal.fire({ icon: "success", title: "Updated!", text: data.message }).then(() => {
              bootstrap.Modal.getInstance(document.getElementById('editCategoryModal')).hide();
              location.reload();
            });
          } else {
            Swal.fire("Error", data.message || "Something went wrong", "error");
          }
        })
        .catch(() => Swal.fire("Error", "Server error!", "error"));
    });

    window.populateEditModal = function (id, name, description, image) {
      document.getElementById('edit-category-id').value = id;
      document.getElementById('edit-category-name').value = name;
      document.getElementById('edit-category-description').value = description;
      document.getElementById('existing-category-image').src = `/uploads/categoryImages/${image}`;
      document.getElementById('editCategoryForm').action = `/admin/editCategory/${id}`;
    };
  });

  // ---- LIST / UNLIST ----
  function unlistCategory(id) {
    Swal.fire({ title: 'Unlist this category?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Yes, unlist' })
      .then(result => {
        if (result.isConfirmed) {
          fetch(`/admin/unlistCategory?id=${id}`).then(r => r.json()).then(data => {
            if (data.success) Swal.fire('Unlisted!', '', 'success').then(() => location.reload());
            else Swal.fire('Error', data.message, 'error');
          });
        }
      });
  }

  function listCategory(id) {
    Swal.fire({ title: 'List this category?', icon: 'question', showCancelButton: true, confirmButtonText: 'Yes, list it' })
      .then(result => {
        if (result.isConfirmed) {
          fetch(`/admin/ListCategory?id=${id}`).then(r => r.json()).then(data => {
            if (data.success) Swal.fire('Listed!', '', 'success').then(() => location.reload());
            else Swal.fire('Error', data.message, 'error');
          });
        }
      });
  }

  // ---- DELETE ----
  function deleteCategory(categoryId) {
    Swal.fire({ title: "Delete category?", text: "This is permanent!", icon: "warning", showCancelButton: true, confirmButtonColor: "#ef4444", confirmButtonText: "Yes, delete" })
      .then(result => {
        if (result.isConfirmed) {
          fetch(`/admin/deleteCategory/${categoryId}`, { method: 'DELETE' }).then(r => r.json()).then(data => {
            if (data.success) Swal.fire("Deleted!", data.message, "success").then(() => location.reload());
            else Swal.fire("Error!", data.message, "error");
          });
        }
      });
  }

  // ---- ADD OFFER ----
  function addOffer(categoryId) {
    const today = new Date().toISOString().split('T')[0];
    Swal.fire({
      title: 'Add Category Offer',
      html: `<div style="text-align:left">
        <label style="font-size:0.8rem;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.04em">Offer Percentage</label>
        <input type="number" id="percentage" class="swal2-input" placeholder="1–99" min="1" max="99">
        <label style="font-size:0.8rem;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.04em">Valid Until</label>
        <input type="date" id="validUntil" class="swal2-input" min="${today}">
      </div>`,
      showCancelButton: true,
      confirmButtonText: 'Add Offer',
      focusConfirm: false,
      preConfirm: () => {
        const percentage = parseInt(document.getElementById('percentage').value);
        const validUntil = document.getElementById('validUntil').value;
        if (!percentage || percentage < 1 || percentage > 99) { Swal.showValidationMessage('Enter valid percentage (1–99)'); return false; }
        if (!validUntil) { Swal.showValidationMessage('Select a valid date'); return false; }
        return fetch('/admin/addCategoryOffer', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ categoryId, percentage, validUntil }) })
          .then(r => r.json()).then(data => { if (!data.status) throw new Error(data.message); return data; })
          .catch(err => Swal.showValidationMessage(`Error: ${err.message}`));
      }
    }).then(result => {
      if (result.isConfirmed) Swal.fire({ icon: 'success', title: 'Offer Added!', text: result.value.message, timer: 1500, showConfirmButton: false }).then(() => location.reload());
    });
  }

  function deleteOffer(categoryId) {
    Swal.fire({ title: 'Remove offer?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Yes, remove' })
      .then(result => {
        if (result.isConfirmed) {
          fetch('/admin/removeCategoryOffer', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ categoryId }) })
            .then(r => r.json()).then(data => {
              if (data.status) Swal.fire('Removed!', 'Offer removed.', 'success').then(() => location.reload());
              else Swal.fire('Error!', data.message, 'error');
            });
        }
      });
  }

  // ---- SUBCATEGORY ----
  function addSubcategory(categoryId) {
    Swal.fire({
      title: 'Add Subcategory',
      input: 'text',
      inputPlaceholder: 'Subcategory name',
      showCancelButton: true,
      confirmButtonText: 'Add',
      preConfirm: (name) => {
        if (!name.trim()) { Swal.showValidationMessage('Please enter a name'); return false; }
        return fetch('/admin/addSubcategory', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ categoryId, subcategoryName: name }) })
          .then(r => r.json()).then(data => { if (!data.status) throw new Error(data.message); return data; })
          .catch(err => Swal.showValidationMessage(`Error: ${err.message}`));
      }
    }).then(result => {
      if (result.isConfirmed) Swal.fire('Added!', result.value.message, 'success').then(() => location.reload());
    });
  }

  const input = document.getElementById('searchInput');
  const rows = document.querySelectorAll('#customerTable tbody tr ');
  const noResults = document.getElementById('noResults');

  input.addEventListener('input', function () {
    const search = this.value.toLowerCase();
    let found = false;

    rows.forEach(row => {
      const text = row.textContent.toLowerCase();

      if (text.includes(search)) {
        row.style.display = '';
        found = true;
      } else {
        row.style.display = 'none';
      }
    });

    // Show "no results" message
    noResults.style.display = found ? 'none' : 'block';
  });


  const inputs = document.getElementById('categoryImageInput');
  const preview = document.getElementById('imagePreview');
  const error = document.getElementById('imageError');

  inputs.addEventListener('change', function () {
    const file = this.files[0];

    if (!file) return;

    const allowedTypes = ['image/png', 'image/jpeg', 'image/webp'];

    // ❌ Invalid file
    if (!allowedTypes.includes(file.type)) {
      error.textContent = "Only PNG, JPG, and WEBP images are allowed!";
      preview.style.display = "none";
      this.value = ""; // clear input
      return;
    }

    // ✅ Valid file
    error.textContent = "";

    const reader = new FileReader();
    reader.onload = function (e) {
      preview.src = e.target.result;
      preview.style.display = "block";
    };

    reader.readAsDataURL(file);
  });


</script>


<%- include('partials/footer') %>
