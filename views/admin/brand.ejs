<section class="content-main">

  <!-- PAGE HEADER -->
  <div class="page-header">
    <h2 class="page-title">Brand <span>Management</span></h2>
    <button class="btn-add" onclick="openAddModal()">
      <i class="fas fa-plus"></i> Add Brand
    </button>
  </div>

  <!-- TABLE -->
  <div class="table-card">
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Brand Name</th>
            <th>Description</th>
            <th class="center">Image</th>
            <th class="center">Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% brands.forEach((brand, i) => { %>
          <tr>
            <td class="sl-no"><%= i + 1 %></td>
            <td><span class="brand-name"><%= brand.name %></span></td>
            <td><span class="brand-desc"><%= brand.description || '—' %></span></td>
            <td class="center">
              <% if (brand.brandImage) { %>
                <img src="/uploads/brands/<%= brand.brandImage %>" class="brand-img" alt="<%= brand.name %>"/>
              <% } else { %>
                <span class="no-img"><i class="fas fa-image"></i></span>
              <% } %>
            </td>
            <td class="center">
              <% if (brand.isListed) { %>
                <span class="badge badge-success">Listed</span>
              <% } else { %>
                <span class="badge badge-danger">Unlisted</span>
              <% } %>
            </td>
            <td>
              <div class="action-group">
                <button class="btn-action btn-edit"
                  onclick="openEditModal('<%= brand._id %>', `<%= brand.name.replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`, `<%= (brand.description || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\').replace(/\r?\n/g, ' ') %>`)">
                  <i class="fas fa-pen"></i> Edit
                </button>
                <button class="btn-action btn-delete" onclick="deleteBrand('<%= brand._id %>')">
                  <i class="fas fa-trash"></i> Delete
                </button>
                <% if (brand.isListed) { %>
                  <button class="btn-action btn-unlist" onclick="toggleBrandStatus('<%= brand._id %>')">
                    <i class="fas fa-eye-slash"></i> Unlist
                  </button>
                <% } else { %>
                  <button class="btn-action btn-list" onclick="toggleBrandStatus('<%= brand._id %>')">
                    <i class="fas fa-eye"></i> List
                  </button>
                <% } %>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</section>

