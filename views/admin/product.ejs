<div class="pm-page">

  <!-- Header -->
  <div class="pm-header">
    <div class="pm-title">
      <div class="pm-title-icon">🛍️</div>
      <div>
        <h3>Products</h3>
        <p>Manage your product catalogue</p>
      </div>
    </div>
    <div class="pm-controls">
      <form id="searchForm" method="GET" action="/admin/products" style="display:flex;align-items:center;gap:8px;margin:0;">
        <div class="pm-search-wrap">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
          <input type="text" name="search" id="searchInput"
            placeholder="Search products or brands..."
            value="<%= searchQuery || '' %>"
            autocomplete="off" />
        </div>
        <% if (searchQuery) { %>
          <a href="/admin/products" class="btn-clear">Clear</a>
        <% } %>
      </form>
      <a href="/admin/addProducts" class="btn-add-product">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        Add Product
      </a>
    </div>
  </div>

  <!-- Stats -->
  <div class="pm-stats">
    <div class="stat-card">
      <div class="stat-icon blue">📦</div>
      <div class="stat-info">
        <div class="stat-label">Total Products</div>
        <div class="stat-val blue"><%= products ? products.length : 0 %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green">✅</div>
      <div class="stat-info">
        <div class="stat-label">Available</div>
        <div class="stat-val green"><%= products ? products.filter(p => !p.isBlocked && p.status && p.status.toLowerCase() === 'available').length : 0 %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon amber">⏳</div>
      <div class="stat-info">
        <div class="stat-label">Out of Stock</div>
        <div class="stat-val amber"><%= products ? products.filter(p => p.status && p.status.toLowerCase() === 'out of stock').length : 0 %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon red">🚫</div>
      <div class="stat-info">
        <div class="stat-label">Discontinued</div>
        <div class="stat-val red"><%= products ? products.filter(p => p.status && p.status.toLowerCase() === 'discontinued').length : 0 %></div>
      </div>
    </div>
  </div>

  <!-- Table Card -->
  <div class="pm-card">

    <!-- Filter Row -->
    <div class="pm-filter-row">
      <span class="filter-label">Filter</span>
      <button class="filter-chip active" onclick="setFilter('all', this)">All</button>
      <button class="filter-chip" onclick="setFilter('available', this)">
        <span class="dot" style="background:#16a34a;"></span> Available
      </button>
      <button class="filter-chip" onclick="setFilter('out of stock', this)">
        <span class="dot" style="background:#ca8a04;"></span> Out of Stock
      </button>
      <button class="filter-chip" onclick="setFilter('discontinued', this)">
        <span class="dot" style="background:#dc2626;"></span> Discontinued
      </button>
    </div>

    <div class="pm-table-wrap">
      <table class="pm-table" id="productTable">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>Status</th>
            <th>Offer</th>
            <th>Valid Until</th>
            <th>Block / Delete</th>
            <th>Offer Mgmt</th>
            <th>Edit</th>
            <th>Variants</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
              <% let statusLower = product.status ? product.status.toLowerCase() : ''; %>
              <tr data-status="<%= statusLower %>">

                <!-- Product -->
                <td>
                  <div class="product-name"><%= product.name %></div>
                  <div class="product-meta"><%= product.brand?.name || product.brand %></div>
                </td>

                <!-- Category -->
                <td>
                  <span class="cat-chip"><%= product.category?.name || 'N/A' %></span>
                  <div class="subcat-text"><%= product.subCategoryDetails ? product.subCategoryDetails.name : '—' %></div>
                </td>

                <!-- Status Badge -->
                <td>
                  <% if (product.isBlocked) { %>
                    <span class="badge-pm badge-blocked">
                      <span class="dot" style="background:#94a3b8;"></span> Not Available
                    </span>
                  <% } else if (statusLower === 'available') { %>
                    <span class="badge-pm badge-available">
                      <span class="dot" style="background:#16a34a;"></span> Available
                    </span>
                  <% } else if (statusLower === 'out of stock') { %>
                    <span class="badge-pm badge-outofstock">
                      <span class="dot" style="background:#ca8a04;"></span> Out of Stock
                    </span>
                  <% } else { %>
                    <span class="badge-pm badge-discontinued">
                      <span class="dot" style="background:#dc2626;"></span> Discontinued
                    </span>
                  <% } %>
                </td>

                <!-- Offer -->
                <td>
                  <% if (product.productOffer && product.productOffer > 0) { %>
                    <span class="offer-pill"><%= product.productOffer %>% off</span>
                  <% } else { %>
                    <span class="no-data">—</span>
                  <% } %>
                </td>

                <!-- Valid Until -->
                <td>
                  <% let formattedDate = product.offerValidUntil
                      ? new Date(product.offerValidUntil).toLocaleDateString('en-GB')
                      : null; %>
                  <% if (formattedDate) { %>
                    <span style="font-size:12px;color:#475569;"><%= formattedDate %></span>
                  <% } else { %>
                    <span class="no-data">—</span>
                  <% } %>
                </td>

                <!-- Block / Delete -->
                <td>
                  <div class="action-group">
                    <% if (!product.isBlocked) { %>
                      <button class="btn-act danger" onclick="confirmBlockProduct('<%= product._id %>')">Block</button>
                    <% } else { %>
                      <button class="btn-act success" onclick="confirmUnblockProduct('<%= product._id %>')">Unblock</button>
                    <% } %>
                    <button class="btn-act danger" onclick="confirmDeleteProduct('<%= product._id %>')" title="Delete">
                      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                        <path d="M10 11v6M14 11v6M9 6V4h6v2"/>
                      </svg>
                    </button>
                  </div>
                </td>

                <!-- Offer Mgmt -->
                <td>
                  <% if (!product.productOffer || product.productOffer === 0) { %>
                    <button class="btn-act primary" onclick="addOffer('<%= product._id %>')">Add Offer</button>
                  <% } else { %>
                    <button class="btn-act danger" onclick="deleteOffer('<%= product._id %>')">Remove</button>
                  <% } %>
                </td>

                <!-- Edit -->
                <td>
                  <a href="/admin/editProduct?id=<%= product._id %>" class="btn-act info">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                      <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                    Edit
                  </a>
                </td>

                <!-- Variants -->
                <td>
                  <a href="/admin/product/<%= product._id %>/variants" class="btn-act dark">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M12 5v14M5 12h14"/>
                    </svg>
                    Variants
                  </a>
                </td>

              </tr>
            <% }) %>
          <% } else { %>
            <tr class="empty-row">
              <td colspan="9">No products found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Footer -->
    <div class="pm-footer">
      <span class="pm-footer-text">
        Page <%= currentPage %> of <%= totalPages %> &middot; <%= products ? products.length : 0 %> results
      </span>
      <div style="font-size:12px;color:#94a3b8;">Use pagination below to navigate</div>
