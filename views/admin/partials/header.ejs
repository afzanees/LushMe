  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Admin Dashboard" %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link
  rel="stylesheet"
