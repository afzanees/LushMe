  function validateProductName(value) {
    if (!value || value.trim() === '') {
      return 'Product name is required.';
    }
    const trimmed = value.trim();
    if (trimmed.length < 3) {
      return 'Product name must be at least 3 characters long.';
    }
    if (trimmed.length > 100) {
      return 'Product name must not exceed 100 characters.';
    }
    if (!/[a-zA-Z0-9]/.test(trimmed)) {
      return 'Product name must contain at least one letter or number.';
    }
    if (/^[^a-zA-Z0-9]+$/.test(trimmed)) {
      return 'Product name cannot contain only special characters.';
    }
    if (!/^[a-zA-Z0-9]/.test(trimmed)) {
      return 'Product name must start with a letter or number.';
    }
    return null;
