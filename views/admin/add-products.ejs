<%- include('partials/header', { title: 'Add Product' }) %>
<%- include('partials/sidebar', { admin }) %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css">

<style>
  .form-section {
    background: #fff;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(0,0,0,0.05);
  }
  input.is-invalid, select.is-invalid, textarea.is-invalid {
    border-color: red !important;
  }
  .text-danger {
    font-size: 0.9em;
    color: red;
  }
</style>

<div class="container mt-5">
  <h3 class="mb-4">Add New Product</h3>
  <form id="productForm" class="row g-4 form-section" enctype="multipart/form-data" onsubmit="return validateForm(event)" novalidate>

    <div class="col-md-12">

      <label class="form-label">Product Name</label>
      <input type="text" id="name" name="name" class="form-control" required>
      <div id="name-error" class="text-danger"></div>

      <label class="form-label mt-3">Description</label>
      <textarea id="description" name="description" class="form-control" rows="4" required></textarea>
      <div id="description-error" class="text-danger"></div>

      <!-- Category -->
      <label class="form-label mt-3">Category</label>
      <select id="category" name="category" class="form-select" required>
        <option value="" disabled selected>Select Category</option>
        <% cat.forEach(c => { %>
          <option value="<%= c._id %>"><%= c.name %></option>
        <% }) %>
      </select>
      <div id="category-error" class="text-danger"></div>

      <!-- Subcategory -->
      <label class="form-label mt-3">Subcategory</label>
      <select id="subcategory" name="subcategory" class="form-select" required>
        <option value="" disabled selected>Select Subcategory</option>
        <% subcat.forEach(sc => { %>
          <option value="<%= sc._id %>"><%= sc.name %></option>
        <% }) %>
      </select>
      <div id="subcategory-error" class="text-danger"></div>

      <!-- Brand -->
      <label class="form-label mt-3">Brand</label>
      <select id="brand" name="brand" class="form-select" required>
        <option value="" disabled selected>Select Brand</option>
        <% brand.forEach(b => { %>
          <option value="<%= b._id %>"><%= b.name %></option>
        <% }) %>
      </select>
      <div id="brand-error" class="text-danger"></div>

      
      <label class="form-label mt-3">Status</label>
      <select id="status" name="status" class="form-control">
        <option value="">Select Status</option>
        <option value="Available">Available</option>
        <option value="Out Of Stock">Out Of Stock</option>
      </select>
      <div id="status-error" class="text-danger"></div>

    </div>

    <div class="col-12 d-flex justify-content-end mt-3">
      <button type="reset" class="btn btn-outline-secondary me-2" id="resetBtn">Cancel</button>
      <button type="submit" class="btn btn-dark">Save</button>
    </div>

  </form>
</div>

<!-- SCRIPTS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<script>
  // --------------------- CATEGORY → SUBCATEGORY ----------------------
  const categories = <%- JSON.stringify(cat) %>;
  const categorySelect = document.getElementById('category');
  const subcategorySelect = document.getElementById('subcategory');

  categorySelect.addEventListener('change', function () {
    const selectedCatId = this.value;
    subcategorySelect.innerHTML = '<option value="" disabled selected>Select Subcategory</option>';

    const selectedCategory = categories.find(c => c._id === selectedCatId);
    if (selectedCategory && selectedCategory.subcategories) {
      selectedCategory.subcategories.forEach(subcat => {
        const option = document.createElement('option');
        option.value = subcat._id;
        option.textContent = subcat.name;
        subcategorySelect.appendChild(option);
      });
    }
  });

  // --------------------- FORM VALIDATION + SUBMIT ----------------------
  let isSubmitting = false;

  function validateProductName(value) {
    if (!value || value.trim() === '') {
      return 'Product name is required.';
    }
    const trimmed = value.trim();
    if (trimmed.length < 3) {
      return 'Product name must be at least 3 characters long.';
    }
    if (trimmed.length > 100) {
      return 'Product name must not exceed 100 characters.';
    }
    if (!/[a-zA-Z0-9]/.test(trimmed)) {
      return 'Product name must contain at least one letter or number.';
    }
    if (/^[^a-zA-Z0-9]+$/.test(trimmed)) {
      return 'Product name cannot contain only special characters.';
    }
    if (!/^[a-zA-Z0-9]/.test(trimmed)) {
      return 'Product name must start with a letter or number.';
    }
    return null;
  }

  function validateDescription(value) {
    if (!value || value.trim() === '') {
      return 'Description is required.';
    }
    const trimmed = value.trim();
    if (trimmed.length < 10) {
      return 'Description must be at least 10 characters long.';
    }
    if (trimmed.length > 2000) {
      return 'Description must not exceed 2000 characters.';
    }
    return null;
  }

  function validateDropdown(value, fieldName) {
    if (!value || value.trim() === '') {
      return `${fieldName} is required.`;
    }
    return null;
  }

  function showError(fieldId, errorMessage) {
    const field = document.getElementById(fieldId);
    const errorDiv = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.remove('is-valid');
      field.classList.add('is-invalid');
    }
    if (errorDiv) {
      errorDiv.textContent = errorMessage;
    }
  }

  function clearError(fieldId) {
    const field = document.getElementById(fieldId);
    const errorDiv = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.remove('is-invalid');
      field.classList.add('is-valid');
    }
    if (errorDiv) {
      errorDiv.textContent = '';
    }
  }

  function clearFieldError(fieldId) {
    const field = document.getElementById(fieldId);
    const errorDiv = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.remove('is-invalid', 'is-valid');
    }
    if (errorDiv) {
      errorDiv.textContent = '';
    }
  }

  function validateForm(e) {
    e.preventDefault();
    
    if (isSubmitting) {
      return false;
    }
    
    let isValid = true;

    // Clear all previous validations
    ['name', 'description', 'category', 'subcategory', 'brand', 'status'].forEach(clearFieldError);

    // Validate product name
    const nameValue = document.getElementById('name').value;
    const nameError = validateProductName(nameValue);
    if (nameError) {
      showError('name', nameError);
      isValid = false;
    }

    // Validate description
    const descValue = document.getElementById('description').value;
    const descError = validateDescription(descValue);
    if (descError) {
      showError('description', descError);
      isValid = false;
    }

    // Validate category
    const categoryValue = document.getElementById('category').value;
    const categoryError = validateDropdown(categoryValue, 'Category');
    if (categoryError) {
      showError('category', categoryError);
      isValid = false;
    }

    // Validate subcategory
    const subcategoryValue = document.getElementById('subcategory').value;
    const subcategoryError = validateDropdown(subcategoryValue, 'Subcategory');
    if (subcategoryError) {
      showError('subcategory', subcategoryError);
      isValid = false;
    }

    // Validate brand
    const brandValue = document.getElementById('brand').value;
    const brandError = validateDropdown(brandValue, 'Brand');
    if (brandError) {
      showError('brand', brandError);
      isValid = false;
    }

    // Validate status
    const statusValue = document.getElementById('status').value;
    const statusError = validateDropdown(statusValue, 'Status');
    if (statusError) {
      showError('status', statusError);
      isValid = false;
    }

    if (!isValid) {
      Swal.fire('Validation Error', 'Please fix all errors before submitting.', 'warning');
      return false;
    }

    // Prevent double submission
    isSubmitting = true;
    const submitBtn = document.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
    }

    const formData = new FormData(document.getElementById('productForm'));
    fetch('/admin/addProducts', { method: 'POST', body: formData })
      .then(res => res.json())
      .then(data => {
        isSubmitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Save';
        }
        
        if (data.success) {
          Swal.fire('Success', 'Product added successfully!', 'success').then(() => {
            window.location.href = '/admin/products';
          });
        } else {
          Swal.fire('Error', data.message || 'Failed to add product.', 'error');
        }
      })
      .catch(err => {
        isSubmitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Save';
        }
        Swal.fire('Error', 'Unexpected error occurred.', 'error');
      });

    return false;
  }
  
  // Real-time validation for product name
  document.getElementById('name').addEventListener('input', function() {
    const error = validateProductName(this.value);
    if (error) {
      showError('name', error);
    } else if (this.value.trim()) {
      clearError('name');
    } else {
      clearFieldError('name');
    }
  });

  // Real-time validation for description
  document.getElementById('description').addEventListener('input', function() {
    const error = validateDescription(this.value);
    if (error) {
      showError('description', error);
    } else if (this.value.trim()) {
      clearError('description');
    } else {
      clearFieldError('description');
    }
  });

  // Real-time validation for dropdowns
  ['category', 'subcategory', 'brand', 'status'].forEach(fieldId => {
    const field = document.getElementById(fieldId);
    if (field) {
      field.addEventListener('change', function() {
        const fieldName = fieldId.charAt(0).toUpperCase() + fieldId.slice(1);
        const error = validateDropdown(this.value, fieldName);
        if (error) {
          showError(fieldId, error);
        } else {
          clearError(fieldId);
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>
