<%- include('partials/header', { title: 'Product Management' }) %>
<%- include('partials/sidebar', { admin }) %>
<style>
#variant-preview img, .cropper-container img {
  max-width: 100% !important;
}
.cropper-container {
  max-width:140px !important;
  max-height:160px !important;
  margin:auto;
}
.variant-preview {
  width: 140px;
  height: 160px;
  border: 1px solid #ddd;
  border-radius: 6px;
  overflow: hidden;
  margin: auto;
  background: #f8f8f8;
}

/* Ensure preview image fits inside box */
.variant-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Force cropper wrapper to stay same size */
.cropper-container {
  width: 140px !important;
  height: 160px !important;
  margin: auto;
}

/* Prevent cropper from pushing layout */
.cropper-container img {
  max-width: none !important;
  object-fit: cover;
}

.variant-image-thumb {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: 4px;
  border: 1px solid #ddd;
  margin: 2px;
}
</style>
<section class="container my-4">
  <h2 class="mb-4">Manage Variants for Product: <%= product.name %></h2>

  <!-- Variant List -->
  <div class="table-responsive mb-4">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th style="width: 5%;">#</th>
          <th style="width: 10%;">Color</th>
          <th style="width: 10%;">Regular Price</th>
          <th style="width: 10%;">Final Price</th>
          <th style="width: 10%;">Quantity</th>
          <th style="width: 30%;">Images</th>
          <th style="width: 25%;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!product.variants || product.variants.length === 0) { %>
          <tr><td colspan="7" class="text-center">No variants found.</td></tr>
        <% } else { %>
          <% product.variants.forEach((variant, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><input type="text" value="<%= variant.color %>" disabled></td>
              <td>₹<%= variant.regularPrice %></td>
              <td>₹<%= variant.salePrice.toFixed(2) %></td>
              <td><%= variant.quantity %></td>
              <td>
                <div class="d-flex flex-wrap">
                  <% console.log('Variant:', variant._id, 'productImage:', variant.productImage); %>
                  <% if (variant.productImage && variant.productImage.length > 0) { %>
                    <% variant.productImage.forEach((image, imgIndex) => { %>
                      <% console.log('Image path:', image); %>
                      <img src="/<%= image %>" alt="Variant Image <%= imgIndex + 1 %>" class="variant-image-thumb" onerror="console.error('Failed to load:', this.src); this.style.border='2px solid red';" />
                    <% }); %>
                  <% } else { %>
                    <small class="text-muted">No images</small>
                  <% } %>
                </div>
              </td>


              <td class="actions-cell">
                <!-- <a href="/admin/product/<%= product._id %>/variants/<%= variant._id %>/edit" class="btn btn-info btn-sm" title="Edit">
                  <i class="fas fa-edit"></i>
                </a> -->
                <button class="btn btn-info btn-sm" onclick='openEditVariantModal("<%= variant._id %>", "<%= variant.color %>", "<%= variant.regularPrice %>", "<%= variant.salePrice %>", "<%= variant.quantity %>", <%- JSON.stringify(variant.productImage || []) %>)' title="Edit">
                  <i class="fas fa-edit"></i>
                </button>
                
                <form method="POST" action="/admin/product/<%= product._id %>/variants/<%= variant._id %>/delete" style="display:inline;">
                  <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this variant?');" title="Delete">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Add Variant Form -->
  <div class="card p-4">
    <h3>Add New Variant</h3>
<form id="addVariantForm" action="/admin/product/<%= product._id %>/variants/add" method="POST" enctype="multipart/form-data">   
     <input type="hidden" name="productId" value="<%= product._id %>" />

      <div class="mb-3">
        <label for="color" class="form-label">Color</label>
        <input
        type="text"
        id="color"
        name="color"
        class="form-control"
        placeholder="Enter color name or hex code"
        required
      />
      
      </div>

      <div class="mb-3">
        <label for="price" class="form-label">Regular Price</label>
        <input
          type="text"
          id="regularPrice"
          name="regularPrice"
          placeholder="Enter the regular price"
          class="form-control"
          required
        />
      </div>
            <div class="mb-3">
        <label for="price" class="form-label">Final Price</label>
        <input
          type="text"
          id="salePrice"
          name="salePrice"
          placeholder="Enter the final price"
          class="form-control"
          required
        />
      </div>

      <div class="mb-3">
        <label for="quantity" class="form-label">Quantity</label>
        <div class="input-group">
          <button type="button" id="decrement">-</button>
          <input
            type="number"
            id="quantity"
            name="quantity"
            min="0"
            value="0"
            required
          />
          <button type="button" id="increment">+</button>
        </div>
      </div>

<!-- 
      image -->
    <!-- Variant Images Upload (4 Required) -->
<div class="mb-4">
  <label class="form-label fw-bold">Variant Images (4 Required)</label>

  <div class="row g-3">
    <% for (let i = 1; i <= 4; i++) { %>
      <div class="col-6 text-center">

        <input type="file" id="image<%= i %>" name="image<%= i %>" accept="image/*"
               class="form-control mb-2" onchange="previewVariantImage(event, <%= i %>)">

        <div id="previewBox<%= i %>" class="variant-preview d-none">

          <img id="previewImg<%= i %>" style="width:100%;height:100%;object-fit:cover;border-radius:6px;">
        </div>

        <button type="button" id="cropBtn<%= i %>" class="btn btn-sm btn-outline-dark mt-2 d-none"
                onclick="cropVariantImage(<%= i %>)">Crop</button>

        <input type="hidden" id="croppedImage<%= i %>" name="croppedImage<%= i %>">
      </div>
    <% } %>
  </div>
</div>


      <button type="submit" class="btn btn-primary">Add Variant</button>
    </form>
  </div>
</section>
<!-- Edit Variant Modal -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-labelledby="editVariantModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <form id="editVariantForm" method="POST" enctype="multipart/form-data">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editVariantModalLabel">Edit Variant</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="variantId" name="variantId" />

            <div class="mb-3">
              <label for="editColor" class="form-label">Color</label>
              <input type="text" class="form-control" id="editColor" name="color" required />
            </div>

            <div class="mb-3">
              <label for="editRegularPrice" class="form-label">Regular Price</label>
              <input type="text" class="form-control" id="editRegularPrice" name="regularPrice" required />
            </div>

            <div class="mb-3">
              <label for="editSalePrice" class="form-label">Final Price</label>
              <input type="text" class="form-control" id="editSalePrice" name="salePrice" required />
            </div>

            <div class="mb-3">
              <label for="editQuantity" class="form-label">Quantity</label>
              <input type="number" class="form-control" id="editQuantity" name="quantity" min="0" required />
            </div>

            <!-- Edit Variant Images -->
            <div class="mb-4">
              <label class="form-label fw-bold">Update Variant Images (Optional)</label>
              <div class="row g-3">
                <% for (let i = 1; i <= 4; i++) { %>
                  <div class="col-6 text-center">
                    <label class="form-label">Image <%= i %></label>
                    
                    <!-- Current Image Display -->
                    <div id="currentImage<%= i %>" class="mb-2 position-relative" style="display: inline-block;">
                      <img id="currentImg<%= i %>" src="" alt="Current Image <%= i %>" class="variant-image-thumb d-none" style="width: 100px; height: 100px;">
                      <button type="button" id="deleteImgBtn<%= i %>" class="btn btn-sm btn-danger position-absolute top-0 end-0 d-none" 
                              style="padding: 2px 6px; font-size: 10px;" onclick="deleteCurrentImage(<%= i %>)" title="Delete Image">
                        <i class="fas fa-times"></i>
                      </button>
                      <div id="noImage<%= i %>" class="text-muted small">No image</div>
                      <input type="hidden" id="deleteImage<%= i %>" name="deleteImage<%= i %>" value="false">
                    </div>

                    <input type="file" id="editImage<%= i %>" name="image<%= i %>" accept="image/*"
                           class="form-control mb-2" onchange="previewEditVariantImage(event, <%= i %>)">

                    <div id="editPreviewBox<%= i %>" class="variant-preview d-none">
                      <img id="editPreviewImg<%= i %>" style="width:100%;height:100%;object-fit:cover;border-radius:6px;">
                    </div>

                    <button type="button" id="editCropBtn<%= i %>" class="btn btn-sm btn-outline-dark mt-2 d-none"
                            onclick="cropEditVariantImage(<%= i %>)">Crop</button>

                    <input type="hidden" id="editCroppedImage<%= i %>" name="croppedImage<%= i %>">
                  </div>
                <% } %>
              </div>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
<script>

let cropperInstances = {};
let editCropperInstances = {};

function previewVariantImage(event, index) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = document.getElementById(`previewImg${index}`);
    const box = document.getElementById(`previewBox${index}`);
    const cropBtn = document.getElementById(`cropBtn${index}`);

    img.src = e.target.result;
    box.classList.remove("d-none");
    cropBtn.classList.remove("d-none");

    // Destroy previous cropper if exists
    if (cropperInstances[index]) {
      cropperInstances[index].destroy();
    }

    // IMPORTANT → Remove object-fit before starting crop
    img.style.objectFit = "contain";

    // Start cropper
    cropperInstances[index] = new Cropper(img, {
      aspectRatio: 1,
      viewMode: 2,
      autoCropArea: 0.8,
      responsive: true,
      zoomOnWheel: true,
    });
  };
  reader.readAsDataURL(file);
}

function cropVariantImage(index) {
  const cropper = cropperInstances[index];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const croppedImage = canvas.toDataURL("image/webp", 0.9);

  document.getElementById(`croppedImage${index}`).value = croppedImage;
  
  const img = document.getElementById(`previewImg${index}`);
  img.src = croppedImage;
  img.style.objectFit = "cover"; // return back after crop

  cropper.destroy();
  cropperInstances[index] = null;

  Swal.fire("Done", "Image cropped successfully!", "success");
}

// Edit Variant Image Functions
function previewEditVariantImage(event, index) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = document.getElementById(`editPreviewImg${index}`);
    const box = document.getElementById(`editPreviewBox${index}`);
    const cropBtn = document.getElementById(`editCropBtn${index}`);

    img.src = e.target.result;
    box.classList.remove("d-none");
    cropBtn.classList.remove("d-none");

    // Destroy previous cropper if exists
    if (editCropperInstances[index]) {
      editCropperInstances[index].destroy();
    }

    // Remove object-fit before starting crop
    img.style.objectFit = "contain";

    // Start cropper
    editCropperInstances[index] = new Cropper(img, {
      aspectRatio: 1,
      viewMode: 2,
      autoCropArea: 0.8,
      responsive: true,
      zoomOnWheel: true,
    });
  };
  reader.readAsDataURL(file);
}

function cropEditVariantImage(index) {
  const cropper = editCropperInstances[index];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const croppedImage = canvas.toDataURL("image/webp", 0.9);

  document.getElementById(`editCroppedImage${index}`).value = croppedImage;
  
  const img = document.getElementById(`editPreviewImg${index}`);
  img.src = croppedImage;
  img.style.objectFit = "cover";

  cropper.destroy();
  editCropperInstances[index] = null;

  Swal.fire("Done", "Image cropped successfully!", "success");
}

// Delete current image function
function deleteCurrentImage(index) {
  Swal.fire({
    title: 'Are you sure?',
    text: "Do you want to delete this image?",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, delete it!'
  }).then((result) => {
    if (result.isConfirmed) {
      const currentImg = document.getElementById(`currentImg${index}`);
      const noImage = document.getElementById(`noImage${index}`);
      const deleteImgBtn = document.getElementById(`deleteImgBtn${index}`);
      const deleteImageInput = document.getElementById(`deleteImage${index}`);
      
      // Hide current image and show "no image"
      currentImg.src = '';
      currentImg.classList.add('d-none');
      deleteImgBtn.classList.add('d-none');
      noImage.classList.remove('d-none');
      
      // Mark for deletion
      deleteImageInput.value = 'true';
      
      Swal.fire('Deleted!', 'Image marked for deletion.', 'success');
    }
  });
}
</script>
<script>
  const quantityInput = document.getElementById('quantity');
  document.getElementById('increment').addEventListener('click', () => {
    quantityInput.value = parseInt(quantityInput.value || '0') + 1;
  });
  document.getElementById('decrement').addEventListener('click', () => {
    if (parseInt(quantityInput.value) > 0) {
      quantityInput.value = parseInt(quantityInput.value) - 1;
    }
  });

  function isValidColorName(colorName) {
  const regex = /^[A-Za-z0-9\s\-]+$/;
  return regex.test(colorName.trim());
}

  // Validate price (e.g.positive numbers)
  function isValidPrice(price) {
    const priceRegex = /^\d+(\.\d{1,2})?$/;
    return priceRegex.test(price.trim());
  }

  // Validate quantity (non-negative integer)
  function isValidQuantity(qty) {
    const n = Number(qty);
    return Number.isInteger(n) && n >= 0;
  }

  document.getElementById('addVariantForm').addEventListener('submit', function(e) {
    const color = document.getElementById('color').value.trim();
    const regularPrice = document.getElementById('regularPrice').value.trim();
    const salePrice = document.getElementById('salePrice').value.trim();
    const quantity = document.getElementById('quantity').value.trim();

    function showError(message) {
      Swal.fire({
        icon: 'error',
        title: 'Validation Error',
        text: message,
      });
    }

    if (!isValidColorName(color)) {
      e.preventDefault();
      showError('Please enter a valid CSS color name (e.g., red, blue, green).');
      return;
    }

    if (isNaN(regularPrice) || regularPrice <= 0) {
  e.preventDefault();
  showError('Regular price must be greater than zero.');
  return;
}

if (isNaN(salePrice) || salePrice <= 0) {
  e.preventDefault();
  showError('Final price must be greater than zero.');
  return;
}

if (parseFloat(salePrice) > parseFloat(regularPrice)) {
  e.preventDefault();
  showError('Final price cannot be higher than regular price.');
  return;
}

  if (isNaN(quantity) || quantity < 0) {
    e.preventDefault();
    showError('Quantity must be a non-negative number.');
    return;
  }
  });
</script>
<script>
  function openEditVariantModal(id, color, regularPrice, salePrice, quantity, images) {
    console.log('Opening modal with images:', images);
    
    // Clean up any existing croppers
    for (let i = 1; i <= 4; i++) {
      if (editCropperInstances[i]) {
        editCropperInstances[i].destroy();
        editCropperInstances[i] = null;
      }
      // Reset image fields
      const editImage = document.getElementById(`editImage${i}`);
      const editPreviewBox = document.getElementById(`editPreviewBox${i}`);
      const editCropBtn = document.getElementById(`editCropBtn${i}`);
      const editCroppedImage = document.getElementById(`editCroppedImage${i}`);
      const deleteImageInput = document.getElementById(`deleteImage${i}`);
      
      if (editImage) editImage.value = '';
      if (editPreviewBox) editPreviewBox.classList.add('d-none');
      if (editCropBtn) editCropBtn.classList.add('d-none');
      if (editCroppedImage) editCroppedImage.value = '';
      if (deleteImageInput) deleteImageInput.value = 'false';

      // Display current images
      const currentImg = document.getElementById(`currentImg${i}`);
      const noImage = document.getElementById(`noImage${i}`);
      const deleteImgBtn = document.getElementById(`deleteImgBtn${i}`);
      
      console.log(`Image ${i}:`, images && images[i - 1] ? images[i - 1] : 'No image');
      
      if (images && images[i - 1]) {
        const imagePath = '/' + images[i - 1];
        console.log(`Setting image ${i} src to:`, imagePath);
        currentImg.src = imagePath;
        currentImg.classList.remove('d-none');
        deleteImgBtn.classList.remove('d-none');
        noImage.classList.add('d-none');
      } else {
        currentImg.src = '';
        currentImg.classList.add('d-none');
        deleteImgBtn.classList.add('d-none');
        noImage.classList.remove('d-none');
      }
    }
    
    const modal = new bootstrap.Modal(document.getElementById('editVariantModal'));
    document.getElementById('variantId').value = id;
    document.getElementById('editColor').value = color;
    document.getElementById('editRegularPrice').value = regularPrice;
    document.getElementById('editSalePrice').value = salePrice;
    document.getElementById('editQuantity').value = quantity;
    modal.show();
  
    // Update the form action dynamically to include the variant ID
    document.getElementById('editVariantForm').action = `/admin/product/<%= product._id %>/variants/${id}/edit`;
  }
  
</script>

<%- include('partials/footer') %>