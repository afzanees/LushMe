    return;
  }

  const maxSize = 5 * 1024 * 1024;
  if (file.size > maxSize) {
    Swal.fire({ icon: 'error', title: 'File Too Large', text: 'Maximum allowed size is 5MB.' });
    event.target.value = '';
    return;
  }



  const reader = new FileReader();
  reader.onload = function(e) {
    const wrap    = document.getElementById(`editCropperWrap${i}`);
