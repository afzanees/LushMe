
<%- include('partials/header', { title: 'Product Management' }) %>
<%- include('partials/sidebar', { admin }) %>
<!-- Cropper.js CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
<style>
.variant-preview {
  width: 100%;
  max-width: 400px;
  height: 400px;
  border: 1px solid #ddd;
  border-radius: 6px;
  overflow: hidden;
  margin: auto;
  background: #f8f8f8;
}

/* Ensure preview image fits inside box */
.variant-preview img {
  width: 100%;
  height: 100%;
  display: block;
  max-width: 100%;
}

/* Allow cropper to use full space */
.cropper-container {
  max-width: 100%;
  margin: auto;
}

.variant-image-thumb {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: 4px;
  border: 1px solid #ddd;
  margin: 2px;
}

/* Edit modal current image display */
.current-image-display {
  width: 100%;
  max-width: 400px;
  height: 400px;
  border: 1px solid #ddd;
  border-radius: 6px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  position: relative;
}

.current-image-display img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
</style>
<section class="container my-4">
  <h2 class="mb-4">Manage Variants for Product: <%= product.name %></h2>

  <!-- Variant List -->
  <div class="table-responsive mb-4">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th style="width: 5%;">#</th>
          <th style="width: 10%;">Color</th>
          <th style="width: 10%;">Price</th>
          <th style="width: 10%;">Quantity</th>
          <th style="width: 30%;">Images</th>
          <th style="width: 25%;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!product.variants || product.variants.length === 0) { %>
          <tr><td colspan="7" class="text-center">No variants found.</td></tr>
        <% } else { %>
          <% product.variants.forEach((variant, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><input type="text" value="<%= variant.color %>" disabled></td>
              <td>₹<%= variant.price %></td>
              <td><%= variant.quantity %></td>
              <td>
                <div class="d-flex flex-wrap">
                  <% console.log('Variant:', variant._id, 'productImage:', variant.productImage); %>
                  <% if (variant.productImage && variant.productImage.length > 0) { %>
                    <% variant.productImage.forEach((image, imgIndex) => { %>
                      <% console.log('Image path:', image); %>
                      <img src="/<%= image %>" alt="Variant Image <%= imgIndex + 1 %>" class="variant-image-thumb" onerror="console.error('Failed to load:', this.src); this.style.border='2px solid red';" />
                    <% }); %>
                  <% } else { %>
                    <small class="text-muted">No images</small>
                  <% } %>
                </div>
              </td>


              <td class="actions-cell">
                <!-- <a href="/admin/product/<%= product._id %>/variants/<%= variant._id %>/edit" class="btn btn-info btn-sm" title="Edit">
                  <i class="fas fa-edit"></i>
                </a> -->
                <button class="btn btn-info btn-sm" 
                        data-variant-id="<%= variant._id %>"
                        data-variant-color="<%= variant.color %>"
                        data-variant-price="<%= variant.price %>"
                        data-variant-quantity="<%= variant.quantity %>"
                        data-variant-images='<%- JSON.stringify(variant.productImage || []) %>'
                        onclick="openEditVariantModalData(this)" 
                        title="Edit">
                  <i class="fas fa-edit"></i>
                </button>
                
                <form method="POST" action="/admin/product/<%= product._id %>/variants/<%= variant._id %>/delete" style="display:inline;">
                  <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this variant?');" title="Delete">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Add Variant Form -->
  <div class="card p-4">
    <h3>Add New Variant</h3>
<form id="addVariantForm" action="/admin/product/<%= product._id %>/variants/add" method="POST" enctype="multipart/form-data" novalidate>   
     <input type="hidden" name="productId" value="<%= product._id %>" />

      <div class="mb-3">
        <label for="color" class="form-label">Color</label>
        <input
        type="text"
        id="color"
        name="color"
        class="form-control"
        placeholder="Enter color name or hex code"
        required
      />
      <div id="color-error" class="text-danger small mt-1"></div>
      </div>

      <div class="mb-3">
        <label for="price" class="form-label">Price</label>
        <input
          type="text"
          id="price"
          name="price"
          placeholder="Enter the price"
          class="form-control"
          required
        />
        <div id="price-error" class="text-danger small mt-1"></div>
      </div>

      <div class="mb-3">
        <label for="quantity" class="form-label">Quantity</label>
        <div class="input-group">
          <button type="button" id="decrement">-</button>
          <input
            type="number"
            id="quantity"
            name="quantity"
            min="0"
            value="0"
            required
          />
          <button type="button" id="increment">+</button>
        </div>
        <div id="quantity-error" class="text-danger small mt-1"></div>
      </div>

<!-- 
      image -->
    <!-- Variant Images Upload (4 Required) -->
<div class="mb-4">
  <label class="form-label fw-bold">Variant Images (4 Required)</label>

  <div class="row g-3">
    <% for (let i = 1; i <= 4; i++) { %>
      <div class="col-6 text-center">

        <input type="file" id="image<%= i %>" name="image<%= i %>" accept="image/*"
               class="form-control mb-2" onchange="previewVariantImage(event, <%= i %>)">

                    <div id="previewBox<%= i %>" class="variant-preview d-none">
                      <img id="previewImg<%= i %>">
                    </div>

                    <button type="button" id="cropBtn<%= i %>" class="btn btn-sm btn-success mt-2 d-none"
                            onclick="cropVariantImage(<%= i %>)"><i class="fas fa-check"></i> Crop & Save</button>        <input type="hidden" id="croppedImage<%= i %>" name="croppedImage<%= i %>">
      </div>
    <% } %>
  </div>
</div>


      <button type="submit" class="btn btn-primary">Add Variant</button>
    </form>
  </div>
</section>
<!-- Edit Variant Modal -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-labelledby="editVariantModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <form id="editVariantForm" method="POST" enctype="multipart/form-data" novalidate>
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editVariantModalLabel">Edit Variant</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="variantId" name="variantId" />

            <div class="mb-3">
              <label for="editColor" class="form-label">Color</label>
              <input type="text" class="form-control" id="editColor" name="color" required />
              <div id="editColor-error" class="text-danger small mt-1"></div>
            </div>

            <div class="mb-3">
              <label for="editPrice" class="form-label">Price</label>
              <input type="text" class="form-control" id="editPrice" name="price" required />
              <div id="editPrice-error" class="text-danger small mt-1"></div>
            </div>

            <div class="mb-3">
              <label for="editQuantity" class="form-label">Quantity</label>
              <input type="number" class="form-control" id="editQuantity" name="quantity" min="0" required />
              <div id="editQuantity-error" class="text-danger small mt-1"></div>
            </div>

            <!-- Edit Variant Images -->
            <div class="mb-4">
              <label class="form-label fw-bold">Update Variant Images (4 Images)</label>
              <div class="row g-3">
                <% for (let i = 1; i <= 4; i++) { %>
                  <div class="col-md-6 text-center">
                    <label class="form-label">Image <%= i %></label>
                    
                    <!-- Combined Image Display Area -->
                    <div class="current-image-display mb-2" id="imageDisplay<%= i %>">
                      <!-- Current/Existing Image -->
                      <img id="currentImg<%= i %>" src="" alt="Current Image <%= i %>" class="d-none">
                      
                      <!-- Preview/New Image (will replace current image in same space) -->
                      <img id="editPreviewImg<%= i %>" class="d-none">
                      
                      <!-- No Image Placeholder -->
                      <div id="noImage<%= i %>" class="text-muted">No image</div>
                      
                      <!-- Delete Button for Current Image -->
                      <button type="button" id="deleteImgBtn<%= i %>" class="btn btn-sm btn-danger position-absolute top-0 end-0 d-none" 
                              style="padding: 4px 8px; font-size: 12px; z-index: 10;" onclick="deleteCurrentImage(<%= i %>)" title="Delete Image">
                        <i class="fas fa-times"></i>
                      </button>
                      
                      <input type="hidden" id="deleteImage<%= i %>" name="deleteImage<%= i %>" value="false">
                    </div>

                    <!-- File Input with Custom Display -->
                    <div class="mb-2">
                      <label for="editImage<%= i %>" class="btn btn-sm btn-outline-primary" id="fileLabel<%= i %>" style="cursor: pointer;">
                        <i class="fas fa-upload"></i> Choose File
                      </label>
                      <input type="file" id="editImage<%= i %>" name="image<%= i %>" accept="image/*"
                             class="d-none" onchange="previewEditVariantImage(event, <%= i %>)">
                      <div id="fileName<%= i %>" class="text-muted small mt-1"></div>
                      <button type="button" id="clearFile<%= i %>" class="btn btn-sm btn-danger mt-1 d-none" onclick="clearFileInput(<%= i %>)">
                        <i class="fas fa-times"></i> Remove
                      </button>
                    </div>

                    <!-- Crop Button -->
                    <button type="button" id="editCropBtn<%= i %>" class="btn btn-sm btn-success mt-2 d-none"
                            onclick="cropEditVariantImage(<%= i %>)"><i class="fas fa-check"></i> Crop & Save</button>

                    <input type="hidden" id="editCroppedImage<%= i %>" name="croppedImage<%= i %>">
                  </div>
                <% } %>
              </div>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
<script>

let cropperInstances = {};
let editCropperInstances = {};

function previewVariantImage(event, index) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = document.getElementById(`previewImg${index}`);
    const box = document.getElementById(`previewBox${index}`);
    const cropBtn = document.getElementById(`cropBtn${index}`);

    img.src = e.target.result;
    box.classList.remove("d-none");
    cropBtn.classList.remove("d-none");

    // Destroy previous cropper if exists
    if (cropperInstances[index]) {
      cropperInstances[index].destroy();
    }

    // Wait for image to load before initializing cropper
    img.onload = function() {
      // Only initialize if not already cropped
      if (!img.dataset.cropped) {
        // Start cropper with better settings
        cropperInstances[index] = new Cropper(img, {
          aspectRatio: 1,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.8,
          responsive: true,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          cropBoxMovable: true,
          cropBoxResizable: true,
          toggleDragModeOnDblclick: false,
          zoomable: true,
          zoomOnWheel: true,
          wheelZoomRatio: 0.1,
          minContainerWidth: 300,
          minContainerHeight: 300
        });
      }
    };
  };
  reader.readAsDataURL(file);
}

function cropVariantImage(index) {
  const cropper = cropperInstances[index];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const croppedImage = canvas.toDataURL("image/webp", 0.9);

  document.getElementById(`croppedImage${index}`).value = croppedImage;
  
  const img = document.getElementById(`previewImg${index}`);
  const box = document.getElementById(`previewBox${index}`);
  const cropBtn = document.getElementById(`cropBtn${index}`);
  
  // Destroy cropper completely
  cropper.destroy();
  cropperInstances[index] = null;
  
  // Remove onload handler to prevent reinitialization
  img.onload = null;
  
  // Mark image as cropped to prevent reinitialization
  img.dataset.cropped = 'true';
  
  // Update image to show cropped result
  img.src = croppedImage;
  img.style.objectFit = "cover";
  
  // Hide crop button after cropping
  if (cropBtn) cropBtn.classList.add("d-none");

  Swal.fire("Done", "Image cropped successfully!", "success");
}

// Edit Variant Image Functions
function previewEditVariantImage(event, index) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = document.getElementById(`editPreviewImg${index}`);
    const cropBtn = document.getElementById(`editCropBtn${index}`);
    const fileName = document.getElementById(`fileName${index}`);
    const clearFileBtn = document.getElementById(`clearFile${index}`);
    const currentImg = document.getElementById(`currentImg${index}`);
    const noImage = document.getElementById(`noImage${index}`);
    const deleteImgBtn = document.getElementById(`deleteImgBtn${index}`);

    // Show filename
    if (fileName) {
      fileName.textContent = `Selected: ${file.name}`;
      fileName.classList.add('text-success');
    }
    
    // Show clear button
    if (clearFileBtn) clearFileBtn.classList.remove('d-none');

    // Hide current image and "no image" text
    if (currentImg) currentImg.classList.add('d-none');
    if (noImage) noImage.classList.add('d-none');
    if (deleteImgBtn) deleteImgBtn.classList.add('d-none');

    // Show preview image in the same display area
    img.classList.remove('d-none');
    cropBtn.classList.remove('d-none');

    // Reset cropped flag for new upload
    img.dataset.cropped = '';
    
    img.src = e.target.result;

    // Destroy previous cropper if exists
    if (editCropperInstances[index]) {
      editCropperInstances[index].destroy();
    }

    // Wait for image to load before initializing cropper
    img.onload = function() {
      // Only initialize if not already cropped
      if (!img.dataset.cropped) {
        // Start cropper with better settings
        editCropperInstances[index] = new Cropper(img, {
          aspectRatio: 1,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.8,
          responsive: true,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          cropBoxMovable: true,
          cropBoxResizable: true,
          toggleDragModeOnDblclick: false,
          zoomable: true,
          zoomOnWheel: true,
          wheelZoomRatio: 0.1,
          minContainerWidth: 300,
          minContainerHeight: 300
        });
      }
    };
  };
  reader.readAsDataURL(file);
}

function cropEditVariantImage(index) {
  const cropper = editCropperInstances[index];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const croppedImage = canvas.toDataURL("image/webp", 0.9);

  document.getElementById(`editCroppedImage${index}`).value = croppedImage;
  
  const img = document.getElementById(`editPreviewImg${index}`);
    const box = document.getElementById(`editPreviewBox${index}`);
    const cropBtn = document.getElementById(`editCropBtn${index}`);
  
  // Destroy cropper completely
  cropper.destroy();
  editCropperInstances[index] = null;
  
  // Remove onload handler to prevent reinitialization
  img.onload = null;
  
  // Mark image as cropped to prevent reinitialization
  img.dataset.cropped = 'true';
  
  // Update image to show cropped result
  img.src = croppedImage;
  img.style.objectFit = "cover";
  
  // Hide crop button after cropping
  if (cropBtn) cropBtn.classList.add("d-none");

  Swal.fire("Done", "Image cropped successfully!", "success");
}

// Clear file input and reset preview
function clearFileInput(index) {
  const editImage = document.getElementById(`editImage${index}`);
  const editPreviewImg = document.getElementById(`editPreviewImg${index}`);
  const editCropBtn = document.getElementById(`editCropBtn${index}`);
  const editCroppedImage = document.getElementById(`editCroppedImage${index}`);
  const fileName = document.getElementById(`fileName${index}`);
  const clearFileBtn = document.getElementById(`clearFile${index}`);
  const currentImg = document.getElementById(`currentImg${index}`);
  const noImage = document.getElementById(`noImage${index}`);
  const deleteImgBtn = document.getElementById(`deleteImgBtn${index}`);
  const deleteImageInput = document.getElementById(`deleteImage${index}`);

  // Destroy cropper if exists
  if (editCropperInstances[index]) {
    editCropperInstances[index].destroy();
    editCropperInstances[index] = null;
  }

  // Clear file input
  if (editImage) editImage.value = '';
  
  // Hide preview image
  if (editPreviewImg) {
    editPreviewImg.src = '';
    editPreviewImg.classList.add('d-none');
    editPreviewImg.dataset.cropped = '';
  }
  if (editCropBtn) editCropBtn.classList.add('d-none');
  if (editCroppedImage) editCroppedImage.value = '';
  
  // Clear filename display
  if (fileName) {
    fileName.textContent = '';
    fileName.classList.remove('text-success');
  }
  
  // Hide clear button
  if (clearFileBtn) clearFileBtn.classList.add('d-none');

  // Restore current image if it was hidden and not marked for deletion
  if (currentImg && currentImg.src && deleteImageInput.value !== 'true') {
    currentImg.classList.remove('d-none');
    if (deleteImgBtn) deleteImgBtn.classList.remove('d-none');
    if (noImage) noImage.classList.add('d-none');
  } else {
    // Show "no image" if there's no current image
    if (noImage) noImage.classList.remove('d-none');
  }
}

// Delete current image function
function deleteCurrentImage(index) {
  Swal.fire({
    title: 'Are you sure?',
    text: "Do you want to delete this image?",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, delete it!'
  }).then((result) => {
    if (result.isConfirmed) {
      const currentImg = document.getElementById(`currentImg${index}`);
      const noImage = document.getElementById(`noImage${index}`);
      const deleteImgBtn = document.getElementById(`deleteImgBtn${index}`);
      const deleteImageInput = document.getElementById(`deleteImage${index}`);
      const editImage = document.getElementById(`editImage${index}`);
      const fileLabel = document.getElementById(`fileLabel${index}`);
      
      // Hide current image and show "no image"
      currentImg.src = '';
      currentImg.classList.add('d-none');
      deleteImgBtn.classList.add('d-none');
      noImage.classList.remove('d-none');
      
      // Mark for deletion
      deleteImageInput.value = 'true';
      
      // Enable file input for this position
      if (editImage) editImage.disabled = false;
      if (fileLabel) fileLabel.classList.remove('disabled');
      
      Swal.fire('Deleted!', 'Image deleted. You can now upload a new image in this position.', 'success');
    }
  });
}
</script>
<script>
  // Quantity increment/decrement
  const quantityInput = document.getElementById('quantity');
  document.getElementById('increment').addEventListener('click', () => {
    quantityInput.value = parseInt(quantityInput.value || '0') + 1;
    validateQuantity(quantityInput.value, 'quantity');
  });
  document.getElementById('decrement').addEventListener('click', () => {
    if (parseInt(quantityInput.value) > 0) {
      quantityInput.value = parseInt(quantityInput.value) - 1;
      validateQuantity(quantityInput.value, 'quantity');
    }
  });

  // Validation Functions
  function validateColor(value, fieldPrefix = '') {
    const fieldId = fieldPrefix ? `${fieldPrefix}Color` : 'color';
    if (!value || value.trim() === '') {
      return 'Color is required.';
    }
    const trimmed = value.trim();
    if (trimmed.length < 2) {
      return 'Color must be at least 2 characters long.';
    }
    if (trimmed.length > 50) {
      return 'Color must not exceed 50 characters.';
    }
    
    // Allow hex codes (#RRGGBB or #RGB)
    const hexPattern = /^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$/;
    if (hexPattern.test(trimmed)) {
      return null; // Valid hex code
    }
    
    // Allow color names (letters, spaces, hyphens, parentheses for rgb/rgba)
    const colorNamePattern = /^[A-Za-z0-9\s\-(),]+$/;
    if (!colorNamePattern.test(trimmed)) {
      return 'Color must be a valid name (e.g., Red, Sky Blue) or hex code (e.g., #FF5733).';
    }
    
    // Color names should start with a letter
    if (!/^[A-Za-z]/.test(trimmed)) {
      return 'Color name must start with a letter.';
    }
    
    return null;
  }

  function validatePrice(value, fieldPrefix = '') {
    if (!value || value.trim() === '') {
      return 'Price is required.';
    }
    const price = parseFloat(value);
    if (isNaN(price)) {
      return 'Price must be a valid number.';
    }
    if (price <= 0) {
      return 'Price must be greater than zero.';
    }
    if (price > 1000000) {
      return 'Price cannot exceed 1,000,000.';
    }
    if (!/^\d+(\.\d{1,2})?$/.test(value.trim())) {
      return 'Price can have at most 2 decimal places.';
    }
    return null;
  }

  function validateQuantity(value, fieldPrefix = '') {
    if (value === '' || value === null || value === undefined) {
      return 'Quantity is required.';
    }
    const qty = parseInt(value);
    if (isNaN(qty)) {
      return 'Quantity must be a valid number.';
    }
    if (qty < 0) {
      return 'Quantity cannot be negative.';
    }
    if (qty > 100000) {
      return 'Quantity cannot exceed 100,000.';
    }
    return null;
  }

  function showError(fieldId, errorMessage) {
    const field = document.getElementById(fieldId);
    const errorDiv = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.remove('is-valid');
      field.classList.add('is-invalid');
    }
    if (errorDiv) {
      errorDiv.textContent = errorMessage;
    }
  }

  function clearError(fieldId) {
    const field = document.getElementById(fieldId);
    const errorDiv = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.remove('is-invalid');
      field.classList.add('is-valid');
    }
    if (errorDiv) {
      errorDiv.textContent = '';
    }
  }

  function clearFieldError(fieldId) {
    const field = document.getElementById(fieldId);
    const errorDiv = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.remove('is-invalid', 'is-valid');
    }
    if (errorDiv) {
      errorDiv.textContent = '';
    }
  }

  // Real-time validation for Add Variant form
  document.getElementById('color').addEventListener('input', function() {
    const error = validateColor(this.value);
    if (error) {
      showError('color', error);
    } else if (this.value.trim()) {
      clearError('color');
    } else {
      clearFieldError('color');
    }
  });

  document.getElementById('price').addEventListener('input', function() {
    const error = validatePrice(this.value);
    if (error) {
      showError('price', error);
    } else if (this.value.trim()) {
      clearError('price');
    } else {
      clearFieldError('price');
    }
  });

  document.getElementById('quantity').addEventListener('input', function() {
    const error = validateQuantity(this.value);
    if (error) {
      showError('quantity', error);
    } else if (this.value !== '') {
      clearError('quantity');
    } else {
      clearFieldError('quantity');
    }
  });

  // Real-time validation for Edit Variant form
  document.getElementById('editColor').addEventListener('input', function() {
    const error = validateColor(this.value, 'edit');
    if (error) {
      showError('editColor', error);
    } else if (this.value.trim()) {
      clearError('editColor');
    } else {
      clearFieldError('editColor');
    }
  });

  document.getElementById('editPrice').addEventListener('input', function() {
    const error = validatePrice(this.value, 'edit');
    if (error) {
      showError('editPrice', error);
    } else if (this.value.trim()) {
      clearError('editPrice');
    } else {
      clearFieldError('editPrice');
    }
  });

  document.getElementById('editQuantity').addEventListener('input', function() {
    const error = validateQuantity(this.value, 'edit');
    if (error) {
      showError('editQuantity', error);
    } else if (this.value !== '') {
      clearError('editQuantity');
    } else {
      clearFieldError('editQuantity');
    }
  });

  // Add Variant Form Submission
  let isSubmittingAdd = false;
  document.getElementById('addVariantForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    if (isSubmittingAdd) {
      return false;
    }
    
    let isValid = true;
    
    // Clear all previous validations
    ['color', 'price', 'quantity'].forEach(clearFieldError);
    
    // Get values
    const colorValue = document.getElementById('color').value;
    const priceValue = document.getElementById('price').value;
    const quantityValue = document.getElementById('quantity').value;
    
    // Validate all fields
    const colorError = validateColor(colorValue);
    if (colorError) {
      showError('color', colorError);
      isValid = false;
    }
    
    const priceError = validatePrice(priceValue);
    if (priceError) {
      showError('price', priceError);
      isValid = false;
    }
    
    const quantityError = validateQuantity(quantityValue);
    if (quantityError) {
      showError('quantity', quantityError);
      isValid = false;
    }
    
    if (!isValid) {
      Swal.fire('Validation Error', 'Please fix all errors before submitting.', 'warning');
      return false;
    }
    
    // Prevent double submission
    isSubmittingAdd = true;
    const submitBtn = this.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Adding...';
    }
    
    // Submit the form
    this.submit();
  });

  // Edit Variant Form Submission
  let isSubmittingEdit = false;
  document.getElementById('editVariantForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    if (isSubmittingEdit) {
      return false;
    }
    
    let isValid = true;
    
    // Clear all previous validations
    ['editColor', 'editPrice', 'editQuantity'].forEach(clearFieldError);
    
    // Get values
    const colorValue = document.getElementById('editColor').value;
    const priceValue = document.getElementById('editPrice').value;
    const quantityValue = document.getElementById('editQuantity').value;
    
    // Validate all fields
    const colorError = validateColor(colorValue, 'edit');
    if (colorError) {
      showError('editColor', colorError);
      isValid = false;
    }
    
    const priceError = validatePrice(priceValue, 'edit');
    if (priceError) {
      showError('editPrice', priceError);
      isValid = false;
    }
    
    const quantityError = validateQuantity(quantityValue, 'edit');
    if (quantityError) {
      showError('editQuantity', quantityError);
      isValid = false;
    }
    
    if (!isValid) {
      Swal.fire('Validation Error', 'Please fix all errors before submitting.', 'warning');
      return false;
    }
    
    // Prevent double submission
    isSubmittingEdit = true;
    const submitBtn = this.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
    }
    
    // Submit the form
    this.submit();
  });
</script>
<script>
  // Helper function to read data attributes from button
  function openEditVariantModalData(button) {
    const id = button.getAttribute('data-variant-id');
    const color = button.getAttribute('data-variant-color');
    const price = button.getAttribute('data-variant-price');
    const quantity = button.getAttribute('data-variant-quantity');
    const images = JSON.parse(button.getAttribute('data-variant-images') || '[]');
    
    openEditVariantModal(id, color, price, quantity, images);
  }

  function openEditVariantModal(id, color, price, quantity, images) {
    console.log('Opening modal with images:', images);
    
    // Clean up any existing croppers
    for (let i = 1; i <= 4; i++) {
      if (editCropperInstances[i]) {
        editCropperInstances[i].destroy();
        editCropperInstances[i] = null;
      }
      // Reset image fields
      const editImage = document.getElementById(`editImage${i}`);
      const editPreviewBox = document.getElementById(`editPreviewBox${i}`);
      const editPreviewImg = document.getElementById(`editPreviewImg${i}`);
      const editCropBtn = document.getElementById(`editCropBtn${i}`);
      const editCroppedImage = document.getElementById(`editCroppedImage${i}`);
      const deleteImageInput = document.getElementById(`deleteImage${i}`);
      const fileName = document.getElementById(`fileName${i}`);
      const clearFileBtn = document.getElementById(`clearFile${i}`);
      
      if (editImage) editImage.value = '';
      if (editPreviewBox) editPreviewBox.classList.add('d-none');
      if (editPreviewImg) editPreviewImg.dataset.cropped = ''; // Reset cropped flag
      if (editCropBtn) editCropBtn.classList.add('d-none');
      if (editCroppedImage) editCroppedImage.value = '';
      if (deleteImageInput) deleteImageInput.value = 'false';
      if (fileName) {
        fileName.textContent = '';
        fileName.classList.remove('text-success');
      }
      if (clearFileBtn) clearFileBtn.classList.add('d-none');

      // Display current images
      const currentImg = document.getElementById(`currentImg${i}`);
      const noImage = document.getElementById(`noImage${i}`);
      const deleteImgBtn = document.getElementById(`deleteImgBtn${i}`);
      
      console.log(`Image ${i}:`, images && images[i - 1] ? images[i - 1] : 'No image');
      
      if (images && images[i - 1]) {
        const imagePath = '/' + images[i - 1];
        console.log(`Setting image ${i} src to:`, imagePath);
        currentImg.src = imagePath;
        currentImg.classList.remove('d-none');
        deleteImgBtn.classList.remove('d-none');
        noImage.classList.add('d-none');
      } else {
        currentImg.src = '';
        currentImg.classList.add('d-none');
        deleteImgBtn.classList.add('d-none');
        noImage.classList.remove('d-none');
      }
    }
    
    const modal = new bootstrap.Modal(document.getElementById('editVariantModal'));
    document.getElementById('variantId').value = id;
    document.getElementById('editColor').value = color;
    document.getElementById('editPrice').value = price;
    document.getElementById('editQuantity').value = quantity;
    modal.show();
  
    // Update the form action dynamically to include the variant ID
    document.getElementById('editVariantForm').action = `/admin/product/<%= product._id %>/variants/${id}/edit`;
  }
  
</script>

