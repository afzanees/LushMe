  const fields = [
    { id: 'color',        validate: () => validateColor(document.getElementById('color').value),                       getValue: () => document.getElementById('color').value.trim() },
    { id: 'regularPrice', validate: () => validatePrice(document.getElementById('regularPrice').value, 'Regular price'), getValue: () => document.getElementById('regularPrice').value.trim() },
