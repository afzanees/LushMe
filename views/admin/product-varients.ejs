<!-- Edit Variant Modal -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-labelledby="editVariantModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <form id="editVariantForm" method="POST" enctype="multipart/form-data">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editVariantModalLabel">Edit Variant</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="variantId" name="variantId" />

            <div class="mb-3">
              <label for="editColor" class="form-label">Color</label>
              <input type="text" class="form-control" id="editColor" name="color" required />
            </div>

            <div class="mb-3">
              <label for="editRegularPrice" class="form-label">Regular Price</label>
              <input type="text" class="form-control" id="editRegularPrice" name="regularPrice" required />
            </div>

            <div class="mb-3">
              <label for="editSalePrice" class="form-label">Final Price</label>
              <input type="text" class="form-control" id="editSalePrice" name="salePrice" required />
            </div>

            <div class="mb-3">
              <label for="editQuantity" class="form-label">Quantity</label>
              <input type="number" class="form-control" id="editQuantity" name="quantity" min="0" required />
            </div>

            <!-- Edit Variant Images -->
            <div class="mb-4">
              <label class="form-label fw-bold">Update Variant Images (4 Images)</label>
              <div class="row g-3">
                <% for (let i = 1; i <= 4; i++) { %>
                  <div class="col-md-6 text-center">
                    <label class="form-label">Image <%= i %></label>
                    
                    <!-- Combined Image Display Area -->
                    <div class="current-image-display mb-2" id="imageDisplay<%= i %>">
                      <!-- Current/Existing Image -->
                      <img id="currentImg<%= i %>" src="" alt="Current Image <%= i %>" class="d-none">
                      
                      <!-- Preview/New Image (will replace current image in same space) -->
                      <img id="editPreviewImg<%= i %>" class="d-none">
                      
                      <!-- No Image Placeholder -->
                      <div id="noImage<%= i %>" class="text-muted">No image</div>
                      
                      <!-- Delete Button for Current Image -->
                      <button type="button" id="deleteImgBtn<%= i %>" class="btn btn-sm btn-danger position-absolute top-0 end-0 d-none" 
                              style="padding: 4px 8px; font-size: 12px; z-index: 10;" onclick="deleteCurrentImage(<%= i %>)" title="Delete Image">
                        <i class="fas fa-times"></i>
                      </button>
                      
                      <input type="hidden" id="deleteImage<%= i %>" name="deleteImage<%= i %>" value="false">
                    </div>

                    <!-- File Input with Custom Display -->
                    <div class="mb-2">
                      <label for="editImage<%= i %>" class="btn btn-sm btn-outline-primary" id="fileLabel<%= i %>" style="cursor: pointer;">
                        <i class="fas fa-upload"></i> Choose File
                      </label>
                      <input type="file" id="editImage<%= i %>" name="image<%= i %>" accept="image/*"
                             class="d-none" onchange="previewEditVariantImage(event, <%= i %>)">
                      <div id="fileName<%= i %>" class="text-muted small mt-1"></div>
                      <button type="button" id="clearFile<%= i %>" class="btn btn-sm btn-danger mt-1 d-none" onclick="clearFileInput(<%= i %>)">
                        <i class="fas fa-times"></i> Remove
                      </button>
                    </div>

                    <!-- Crop Button -->
                    <button type="button" id="editCropBtn<%= i %>" class="btn btn-sm btn-success mt-2 d-none"
                            onclick="cropEditVariantImage(<%= i %>)"><i class="fas fa-check"></i> Crop & Save</button>

                    <input type="hidden" id="editCroppedImage<%= i %>" name="croppedImage<%= i %>">
                  </div>
                <% } %>
              </div>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
<script>

let cropperInstances = {};
let editCropperInstances = {};

function previewVariantImage(event, index) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = document.getElementById(`previewImg${index}`);
    const box = document.getElementById(`previewBox${index}`);
    const cropBtn = document.getElementById(`cropBtn${index}`);

    img.src = e.target.result;
    box.classList.remove("d-none");
    cropBtn.classList.remove("d-none");

    // Destroy previous cropper if exists
    if (cropperInstances[index]) {
      cropperInstances[index].destroy();
    }

    // Wait for image to load before initializing cropper
    img.onload = function() {
      // Only initialize if not already cropped
      if (!img.dataset.cropped) {
        // Start cropper with better settings
        cropperInstances[index] = new Cropper(img, {
          aspectRatio: 1,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.8,
          responsive: true,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          cropBoxMovable: true,
          cropBoxResizable: true,
          toggleDragModeOnDblclick: false,
          zoomable: true,
          zoomOnWheel: true,
          wheelZoomRatio: 0.1,
          minContainerWidth: 300,
          minContainerHeight: 300
        });
      }
    };
  };
  reader.readAsDataURL(file);
}

function cropVariantImage(index) {
  const cropper = cropperInstances[index];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const croppedImage = canvas.toDataURL("image/webp", 0.9);

  document.getElementById(`croppedImage${index}`).value = croppedImage;
  
  const img = document.getElementById(`previewImg${index}`);
  const box = document.getElementById(`previewBox${index}`);
  const cropBtn = document.getElementById(`cropBtn${index}`);
  
  // Destroy cropper completely
  cropper.destroy();
  cropperInstances[index] = null;
  
  // Remove onload handler to prevent reinitialization
  img.onload = null;
  
  // Mark image as cropped to prevent reinitialization
  img.dataset.cropped = 'true';
  
  // Update image to show cropped result
  img.src = croppedImage;
  img.style.objectFit = "cover";
  
  // Hide crop button after cropping
  if (cropBtn) cropBtn.classList.add("d-none");

  Swal.fire("Done", "Image cropped successfully!", "success");
}

// Edit Variant Image Functions
function previewEditVariantImage(event, index) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = document.getElementById(`editPreviewImg${index}`);
    const cropBtn = document.getElementById(`editCropBtn${index}`);
    const fileName = document.getElementById(`fileName${index}`);
    const clearFileBtn = document.getElementById(`clearFile${index}`);
    const currentImg = document.getElementById(`currentImg${index}`);
    const noImage = document.getElementById(`noImage${index}`);
    const deleteImgBtn = document.getElementById(`deleteImgBtn${index}`);

    // Show filename
    if (fileName) {
      fileName.textContent = `Selected: ${file.name}`;
      fileName.classList.add('text-success');
    }
    
    // Show clear button
    if (clearFileBtn) clearFileBtn.classList.remove('d-none');

    // Hide current image and "no image" text
    if (currentImg) currentImg.classList.add('d-none');
    if (noImage) noImage.classList.add('d-none');
    if (deleteImgBtn) deleteImgBtn.classList.add('d-none');

    // Show preview image in the same display area
    img.classList.remove('d-none');
    cropBtn.classList.remove('d-none');

    // Reset cropped flag for new upload
    img.dataset.cropped = '';
    
    img.src = e.target.result;

    // Destroy previous cropper if exists
    if (editCropperInstances[index]) {
      editCropperInstances[index].destroy();
    }

    // Wait for image to load before initializing cropper
    img.onload = function() {
      // Only initialize if not already cropped
      if (!img.dataset.cropped) {
        // Start cropper with better settings
        editCropperInstances[index] = new Cropper(img, {
          aspectRatio: 1,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.8,
          responsive: true,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          cropBoxMovable: true,
          cropBoxResizable: true,
          toggleDragModeOnDblclick: false,
          zoomable: true,
          zoomOnWheel: true,
          wheelZoomRatio: 0.1,
          minContainerWidth: 300,
          minContainerHeight: 300
        });
      }
    };
  };
  reader.readAsDataURL(file);
}

function cropEditVariantImage(index) {
  const cropper = editCropperInstances[index];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const croppedImage = canvas.toDataURL("image/webp", 0.9);

  document.getElementById(`editCroppedImage${index}`).value = croppedImage;
  
  const img = document.getElementById(`editPreviewImg${index}`);
    const box = document.getElementById(`editPreviewBox${index}`);
    const cropBtn = document.getElementById(`editCropBtn${index}`);
  
  // Destroy cropper completely
  cropper.destroy();
  editCropperInstances[index] = null;
  
  // Remove onload handler to prevent reinitialization
  img.onload = null;
  
  // Mark image as cropped to prevent reinitialization
  img.dataset.cropped = 'true';
  
  // Update image to show cropped result
  img.src = croppedImage;
  img.style.objectFit = "cover";
  
  // Hide crop button after cropping
  if (cropBtn) cropBtn.classList.add("d-none");

  Swal.fire("Done", "Image cropped successfully!", "success");
}

// Clear file input and reset preview
function clearFileInput(index) {
  const editImage = document.getElementById(`editImage${index}`);
  const editPreviewImg = document.getElementById(`editPreviewImg${index}`);
  const editCropBtn = document.getElementById(`editCropBtn${index}`);
  const editCroppedImage = document.getElementById(`editCroppedImage${index}`);
  const fileName = document.getElementById(`fileName${index}`);
  const clearFileBtn = document.getElementById(`clearFile${index}`);
  const currentImg = document.getElementById(`currentImg${index}`);
  const noImage = document.getElementById(`noImage${index}`);
  const deleteImgBtn = document.getElementById(`deleteImgBtn${index}`);
  const deleteImageInput = document.getElementById(`deleteImage${index}`);

  // Destroy cropper if exists
  if (editCropperInstances[index]) {
    editCropperInstances[index].destroy();
    editCropperInstances[index] = null;
  }

  // Clear file input
  if (editImage) editImage.value = '';
  
  // Hide preview image
  if (editPreviewImg) {
    editPreviewImg.src = '';
    editPreviewImg.classList.add('d-none');
    editPreviewImg.dataset.cropped = '';
  }
  if (editCropBtn) editCropBtn.classList.add('d-none');
  if (editCroppedImage) editCroppedImage.value = '';
  
  // Clear filename display
  if (fileName) {
    fileName.textContent = '';
    fileName.classList.remove('text-success');
  }
  
  // Hide clear button
  if (clearFileBtn) clearFileBtn.classList.add('d-none');

  // Restore current image if it was hidden and not marked for deletion
  if (currentImg && currentImg.src && deleteImageInput.value !== 'true') {
    currentImg.classList.remove('d-none');
    if (deleteImgBtn) deleteImgBtn.classList.remove('d-none');
    if (noImage) noImage.classList.add('d-none');
  } else {
    // Show "no image" if there's no current image
    if (noImage) noImage.classList.remove('d-none');
  }
}

// Delete current image function
function deleteCurrentImage(index) {
  Swal.fire({
    title: 'Are you sure?',
    text: "Do you want to delete this image?",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, delete it!'
  }).then((result) => {
    if (result.isConfirmed) {
      const currentImg = document.getElementById(`currentImg${index}`);
      const noImage = document.getElementById(`noImage${index}`);
      const deleteImgBtn = document.getElementById(`deleteImgBtn${index}`);
      const deleteImageInput = document.getElementById(`deleteImage${index}`);
      const editImage = document.getElementById(`editImage${index}`);
      const fileLabel = document.getElementById(`fileLabel${index}`);
      
      // Hide current image and show "no image"
      currentImg.src = '';
      currentImg.classList.add('d-none');
      deleteImgBtn.classList.add('d-none');
      noImage.classList.remove('d-none');
      
      // Mark for deletion
      deleteImageInput.value = 'true';
      
      // Enable file input for this position
      if (editImage) editImage.disabled = false;
      if (fileLabel) fileLabel.classList.remove('disabled');
      
      Swal.fire('Deleted!', 'Image deleted. You can now upload a new image in this position.', 'success');
    }
  });
}
</script>
<script>
  const quantityInput = document.getElementById('quantity');
  document.getElementById('increment').addEventListener('click', () => {
    quantityInput.value = parseInt(quantityInput.value || '0') + 1;
  });
  document.getElementById('decrement').addEventListener('click', () => {
    if (parseInt(quantityInput.value) > 0) {
      quantityInput.value = parseInt(quantityInput.value) - 1;
    }
  });

  function isValidColorName(colorName) {
  const regex = /^[A-Za-z0-9\s\-]+$/;
  return regex.test(colorName.trim());
}

  // Validate price (e.g.positive numbers)
  function isValidPrice(price) {
    const priceRegex = /^\d+(\.\d{1,2})?$/;
    return priceRegex.test(price.trim());
  }

  // Validate quantity (non-negative integer)
  function isValidQuantity(qty) {
    const n = Number(qty);
    return Number.isInteger(n) && n >= 0;
  }

  document.getElementById('addVariantForm').addEventListener('submit', function(e) {
