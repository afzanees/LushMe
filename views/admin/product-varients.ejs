}

function cropEditVariantImage(i) {
  const cropper = editCropperInstances[i];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const dataUrl = canvas.toDataURL('image/webp', 0.9);
  document.getElementById(`editCroppedImage${i}`).value = dataUrl;

  const wrap    = document.getElementById(`editCropperWrap${i}`);
  const img     = document.getElementById(`editPreviewImg${i}`);
  const cropBtn = document.getElementById(`editCropBtn${i}`);
  const cp      = document.getElementById(`editCroppedPreview${i}`);

  cropper.destroy();
  editCropperInstances[i] = null;
  img.onload = null;
  img.dataset.cropped = 'true';
  wrap.classList.remove('visible');
  cropBtn.classList.remove('visible');
  cp.src = dataUrl;
  cp.style.display = 'block';

  Swal.fire({ icon: 'success', title: 'Cropped!', text: 'Image cropped successfully', timer: 1200, showConfirmButton: false });
}

/* ── Delete current image in edit modal ── */
function deleteCurrentImage(i) {
  Swal.fire({
    title: 'Remove this image?',
    text: 'You can upload a new one in its place.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#dc2626',
    cancelButtonColor: '#64748b',
    confirmButtonText: 'Yes, remove'
  }).then(result => {
    if (!result.isConfirmed) return;
    const cur    = document.getElementById(`currentImg${i}`);
    const ph     = document.getElementById(`editPlaceholder${i}`);
    const delBtn = document.getElementById(`deleteImgBtn${i}`);
    const flag   = document.getElementById(`deleteImage${i}`);

    cur.src = '';
    cur.style.display = 'none';
    delBtn.classList.remove('visible');
    ph.style.display = 'flex';
    flag.value = 'true';
  });
}

/* ── Open edit modal ── */
function openEditVariantModalData(button) {
  const id           = button.getAttribute('data-variant-id');
  const color        = button.getAttribute('data-variant-color');
  const regularPrice = button.getAttribute('data-variant-regularPrice');
  const salePrice    = button.getAttribute('data-variant-salePrice');
  const quantity     = button.getAttribute('data-variant-quantity');
  const images       = JSON.parse(button.getAttribute('data-variant-images') || '[]');

  /* Clean up previous state */
  for (let i = 1; i <= 4; i++) {
    if (editCropperInstances[i]) { editCropperInstances[i].destroy(); editCropperInstances[i] = null; }

    const editImg  = document.getElementById(`editImage${i}`);
    const prevImg  = document.getElementById(`editPreviewImg${i}`);
    const cropBtn  = document.getElementById(`editCropBtn${i}`);
    const croppedH = document.getElementById(`editCroppedImage${i}`);
    const flag     = document.getElementById(`deleteImage${i}`);
    const wrap     = document.getElementById(`editCropperWrap${i}`);
    const cp       = document.getElementById(`editCroppedPreview${i}`);
    const cur      = document.getElementById(`currentImg${i}`);
    const ph       = document.getElementById(`editPlaceholder${i}`);
    const delBtn   = document.getElementById(`deleteImgBtn${i}`);

    if (editImg)  editImg.value = '';
    if (prevImg)  { prevImg.src = ''; prevImg.dataset.cropped = ''; }
    if (croppedH) croppedH.value = '';
    if (flag)     flag.value = 'false';
    if (wrap)     wrap.classList.remove('visible');
    if (cropBtn)  cropBtn.classList.remove('visible');
    if (cp)       { cp.src = ''; cp.style.display = 'none'; }

    if (images[i - 1]) {
      cur.src = '/' + images[i - 1];
      cur.style.display = 'block';
      ph.style.display = 'none';
      delBtn.classList.add('visible');
    } else {
      cur.src = '';
      cur.style.display = 'none';
      ph.style.display = 'flex';
      delBtn.classList.remove('visible');
    }
  }

  document.getElementById('variantId').value        = id;
  document.getElementById('editColor').value         = color;
  document.getElementById('editRegularPrice').value  = regularPrice;
  document.getElementById('editSalePrice').value     = salePrice;
  document.getElementById('editQuantity').value      = quantity;
  document.getElementById('editVariantForm').action  = `/admin/product/<%= product._id %>/variants/${id}/edit`;

  /* Clear validation state */
  ['editColor','editRegularPrice','editSalePrice','editQuantity'].forEach(clearFieldError);

  new bootstrap.Modal(document.getElementById('editVariantModal')).show();
}

/* ── Qty stepper ── */
const qtyInput = document.getElementById('quantity');
document.getElementById('increment').addEventListener('click', () => {
  qtyInput.value = parseInt(qtyInput.value || '0') + 1;
});
document.getElementById('decrement').addEventListener('click', () => {
  if (parseInt(qtyInput.value) > 0) qtyInput.value = parseInt(qtyInput.value) - 1;
});

/* ── Validation helpers ── */
function validateColor(value) {
  if (!value || !value.trim()) return 'Color is required.';
  const t = value.trim();
  if (t.length < 2) return 'Color must be at least 2 characters.';
  if (t.length > 50) return 'Color must not exceed 50 characters.';
  if (/^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$/.test(t)) return null;
  if (!/^[A-Za-z][A-Za-z0-9\s\-(),]*$/.test(t)) return 'Enter a valid color name or hex code (e.g. #FF5733).';
  return null;
}

function validatePrice(value, fieldLabel) {
  if (!value || !value.trim()) return `${fieldLabel} is required.`;
  const p = parseFloat(value);
  if (isNaN(p)) return `${fieldLabel} must be a valid number.`;
  if (p <= 0) return `${fieldLabel} must be greater than zero.`;
  if (p > 1000000) return `${fieldLabel} cannot exceed ₹10,00,000.`;
  if (!/^\d+(\.\d{1,2})?$/.test(value.trim())) return `${fieldLabel} can have at most 2 decimal places.`;
  return null;
}

function validateSaleVsRegular(saleVal, regularVal) {
  const s = parseFloat(saleVal);
  const r = parseFloat(regularVal);
  if (!isNaN(s) && !isNaN(r) && s >= r) return 'Sale price must be less than regular price.';
  return null;
}

function validateQuantity(value) {
  if (value === '' || value === null || value === undefined) return 'Quantity is required.';
  const q = parseInt(value);
  if (isNaN(q)) return 'Quantity must be a valid number.';
  if (q < 0) return 'Quantity cannot be negative.';
  if (q > 100000) return 'Quantity cannot exceed 1,00,000.';
  return null;
}

function showError(id, msg) {
  const field = document.getElementById(id);
  const err   = document.getElementById(`${id}-error`);
  if (field) { field.classList.remove('is-valid'); field.classList.add('is-invalid'); }
  if (err)   err.textContent = msg;
}

function clearError(id) {
  const field = document.getElementById(id);
  const err   = document.getElementById(`${id}-error`);
  if (field) { field.classList.remove('is-invalid'); field.classList.add('is-valid'); }
  if (err)   err.textContent = '';
}

function clearFieldError(id) {
  const field = document.getElementById(id);
  const err   = document.getElementById(`${id}-error`);
  if (field) field.classList.remove('is-invalid','is-valid');
  if (err)   err.textContent = '';
}

/* ── Real-time validation: Add form ── */
document.getElementById('color').addEventListener('input', function() {
  const e = validateColor(this.value);
  e ? showError('color', e) : (this.value.trim() ? clearError('color') : clearFieldError('color'));
});

document.getElementById('regularPrice').addEventListener('input', function() {
  const e = validatePrice(this.value, 'Regular price');
  if (e) { showError('regularPrice', e); return; }
  const saleErr = validateSaleVsRegular(document.getElementById('salePrice').value, this.value);
  if (saleErr) { showError('salePrice', saleErr); } else { clearError('regularPrice'); clearFieldError('salePrice'); if (document.getElementById('salePrice').value) clearError('salePrice'); }
});

document.getElementById('salePrice').addEventListener('input', function() {
  const e = validatePrice(this.value, 'Sale price');
  if (e) { showError('salePrice', e); return; }
  const cmpErr = validateSaleVsRegular(this.value, document.getElementById('regularPrice').value);
  cmpErr ? showError('salePrice', cmpErr) : clearError('salePrice');
});

document.getElementById('quantity').addEventListener('input', function() {
  const e = validateQuantity(this.value);
  e ? showError('quantity', e) : (this.value !== '' ? clearError('quantity') : clearFieldError('quantity'));
});

/* ── Real-time validation: Edit form ── */
document.getElementById('editColor').addEventListener('input', function() {
  const e = validateColor(this.value);
  e ? showError('editColor', e) : (this.value.trim() ? clearError('editColor') : clearFieldError('editColor'));
});

document.getElementById('editRegularPrice').addEventListener('input', function() {
  const e = validatePrice(this.value, 'Regular price');
  if (e) { showError('editRegularPrice', e); return; }
  const cmpErr = validateSaleVsRegular(document.getElementById('editSalePrice').value, this.value);
  if (cmpErr) showError('editSalePrice', cmpErr); else { clearError('editRegularPrice'); if (document.getElementById('editSalePrice').value) clearError('editSalePrice'); }
});

document.getElementById('editSalePrice').addEventListener('input', function() {
  const e = validatePrice(this.value, 'Sale price');
  if (e) { showError('editSalePrice', e); return; }
  const cmpErr = validateSaleVsRegular(this.value, document.getElementById('editRegularPrice').value);
  cmpErr ? showError('editSalePrice', cmpErr) : clearError('editSalePrice');
});

document.getElementById('editQuantity').addEventListener('input', function() {
  const e = validateQuantity(this.value);
  e ? showError('editQuantity', e) : (this.value !== '' ? clearError('editQuantity') : clearFieldError('editQuantity'));
});

/* ── Form submit helpers ── */
function validateAndSubmit(fields, form, submitBtn) {
  let valid = true;
  fields.forEach(f => { clearFieldError(f.id); });

  fields.forEach(f => {
    const err = f.validate();
    if (err) { showError(f.id, err); valid = false; }
    else if (f.getValue() !== '') clearError(f.id);
  });

  if (!valid) {
    Swal.fire({ icon: 'warning', title: 'Validation Error', text: 'Please fix the highlighted fields.' });
    return false;
  }

  submitBtn.disabled = true;
  const orig = submitBtn.innerHTML;
  submitBtn.innerHTML = '<span style="font-size:12px;">Saving…</span>';

  const formData = new FormData(form);
  fetch(form.action, { method: 'POST', body: formData })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        Swal.fire({ icon: 'success', title: 'Success!', text: data.message || 'Done', timer: 1500, showConfirmButton: false })
          .then(() => { window.location.href = data.redirectUrl || window.location.href; });
      } else {
        Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Something went wrong' });
        submitBtn.disabled = false;
        submitBtn.innerHTML = orig;
      }
    })
    .catch(() => {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Unexpected error. Please try again.' });
      submitBtn.disabled = false;
      submitBtn.innerHTML = orig;
    });

  return true;
}

