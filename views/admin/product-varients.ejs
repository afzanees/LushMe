<<<<<<< HEAD
<%- include('partials/header', { title: 'Manage Variants' }) %>
<%- include('partials/sidebar', { admin }) %>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">

<style>
  body {
    font-family: "DM Sans", sans-serif;
    background-color: #f1f5f9;
    color: #1e293b;
  }

  .vp-page { padding: 28px 24px; }

  /* Header */
  .vp-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: 9px;
    border: 1px solid #e2e8f0;
    background: #fff;
    font-size: 13px;
    color: #475569;
    font-family: "DM Sans", sans-serif;
    text-decoration: none;
    transition: background 0.15s;
  }
  .btn-back:hover { background: #f8fafc; color: #1e293b; text-decoration: none; }

  .vp-title h2 {
    font-family: "Syne", sans-serif;
    font-size: 21px;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  .vp-title p { font-size: 13px; color: #64748b; margin: 0; }

  .product-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    padding: 3px 10px;
    border-radius: 6px;
    margin-left: 6px;
    letter-spacing: 0.2px;
  }

  /* Variants Table Card */
  .vp-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 22px;
  }

  .vp-card-header {
    padding: 16px 20px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .vp-card-header h5 {
    font-family: "Syne", sans-serif;
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    color: #1e293b;
  }

  .variant-count {
    font-size: 12px;
    background: #f1f5f9;
    color: #64748b;
    padding: 2px 9px;
    border-radius: 20px;
    font-weight: 500;
  }

  .vp-table-wrap { overflow-x: auto; }

  .vp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    min-width: 820px;
  }

  .vp-table thead tr { background: #1e293b; }

  .vp-table thead th {
    color: #94a3b8;
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 12px 18px;
    text-align: left;
    white-space: nowrap;
  }

  .vp-table tbody tr {
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.1s;
  }

  .vp-table tbody tr:last-child { border-bottom: none; }
  .vp-table tbody tr:hover { background: #f8fafc; }

  .vp-table td {
    padding: 13px 18px;
    vertical-align: middle;
    color: #1e293b;
  }

  /* Color chip */
  .color-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 500;
    background: #f1f5f9;
    color: #475569;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
    flex-shrink: 0;
  }

  /* Price */
  .price-text { font-weight: 500; }
  .sale-price { color: #16a34a; }
  .regular-price { color: #94a3b8; font-size: 12px; text-decoration: line-through; }

  /* Qty chip */
  .qty-chip {
    display: inline-block;
    background: #f1f5f9;
    color: #475569;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 500;
  }

  /* Thumb images */
  .thumb-row { display: flex; flex-wrap: wrap; gap: 4px; }

  .thumb-img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 7px;
    border: 1px solid #e2e8f0;
  }

  /* Action buttons */
  .action-group { display: flex; align-items: center; gap: 6px; }

  .btn-act {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 30px;
    padding: 0 11px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    font-family: "DM Sans", sans-serif;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.15s;
    white-space: nowrap;
    background: none;
  }
  .btn-act:hover { opacity: 0.82; text-decoration: none; }
  .btn-act.info   { background: #e0f2fe; color: #0369a1; border-color: #bae6fd; }
  .btn-act.danger { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }

  /* Empty state */
  .empty-state { text-align: center; padding: 40px 24px; color: #94a3b8; }
  .empty-state p { font-size: 14px; margin: 0; }

  /* Add Variant Form Card */
  .form-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
  }

  .form-card-header {
    padding: 16px 22px;
    border-bottom: 1px solid #f1f5f9;
  }

  .form-card-header h5 {
    font-family: "Syne", sans-serif;
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    color: #1e293b;
  }

  .form-card-body { padding: 22px 24px; }

  /* Form fields */
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }

  .field-group { display: flex; flex-direction: column; gap: 5px; }

  .field-group label {
    font-size: 12px;
    font-weight: 500;
    color: #475569;
  }

  .field-input {
    border: 1px solid #e2e8f0;
    border-radius: 9px;
    padding: 9px 13px;
    font-size: 13px;
    font-family: "DM Sans", sans-serif;
    color: #1e293b;
    background: #fff;
    outline: none;
    height: 38px;
    transition: border-color 0.15s;
  }

  .field-input:focus { border-color: #94a3b8; box-shadow: 0 0 0 3px rgba(148,163,184,0.15); }
  .field-input.is-invalid { border-color: #fca5a5; }
  .field-input.is-valid   { border-color: #86efac; }

  .field-error { font-size: 11px; color: #dc2626; min-height: 16px; }

  /* Qty stepper */
  .qty-stepper {
    display: flex;
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 9px;
    overflow: hidden;
    height: 38px;
  }

  .qty-stepper button {
    width: 36px;
    height: 38px;
    border: none;
    background: #f8fafc;
    color: #475569;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    flex-shrink: 0;
    font-family: "DM Sans", sans-serif;
  }

  .qty-stepper button:hover { background: #f1f5f9; }

  .qty-stepper input {
    flex: 1;
    border: none;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    font-family: "DM Sans", sans-serif;
    color: #1e293b;
    outline: none;
    background: #fff;
  }

  /* Image Upload Grid */
  .image-section-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #94a3b8;
    margin-bottom: 14px;
  }

  .image-upload-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 22px;
  }

  .image-slot {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .image-slot-label {
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
    text-align: center;
  }

  .image-preview-box {
    width: 100%;
    aspect-ratio: 1;
    border: 1.5px dashed #cbd5e1;
    border-radius: 10px;
    overflow: hidden;
    background: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .image-preview-box.has-image { border-style: solid; border-color: #e2e8f0; }

  .image-preview-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .image-preview-box img.visible { display: block; }

  .upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    color: #cbd5e1;
    font-size: 11px;
  }

  .upload-placeholder svg { width: 22px; height: 22px; }

  .delete-img-btn {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #dc2626;
    color: #fff;
    border: none;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    z-index: 10;
  }

  .delete-img-btn.visible { display: flex; }

  .image-slot input[type="file"] { display: none; }

  .btn-choose-file {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 30px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    font-family: "DM Sans", sans-serif;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #475569;
    cursor: pointer;
    transition: background 0.15s;
    width: 100%;
  }

  .btn-choose-file:hover { background: #f8fafc; }

  .btn-crop {
    display: none;
    width: 100%;
    height: 30px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    font-family: "DM Sans", sans-serif;
    border: 1px solid #bbf7d0;
    background: #dcfce7;
    color: #15803d;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    gap: 5px;
    transition: opacity 0.15s;
  }

  .btn-crop.visible { display: flex; }
  .btn-crop:hover { opacity: 0.82; }

  /* Cropper container */
  .cropper-wrap {
    display: none;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .cropper-wrap.visible { display: block; }
  .cropper-wrap img { max-width: 100%; display: block; }

  /* Submit button */
  .btn-submit {
    background: #1e293b;
    color: #fff;
    border: none;
    border-radius: 9px;
    padding: 0 22px;
    height: 40px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: "DM Sans", sans-serif;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: background 0.15s;
  }
  .btn-submit:hover { background: #334155; }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  /* Modal overrides */
  .modal-content {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    font-family: "DM Sans", sans-serif;
  }

  .modal-header {
    border-bottom: 1px solid #f1f5f9;
    padding: 18px 22px;
  }

  .modal-title {
    font-family: "Syne", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1e293b;
  }

  .modal-body { padding: 22px; }

  .modal-footer {
    border-top: 1px solid #f1f5f9;
    padding: 16px 22px;
    gap: 8px;
  }

  .btn-modal-cancel {
    height: 36px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #fff;
    font-size: 13px;
    color: #475569;
    font-family: "DM Sans", sans-serif;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-modal-cancel:hover { background: #f8fafc; }
</style>

<div class="vp-page">

  <!-- Header -->
  <div class="vp-header">
    <a href="/admin/products" class="btn-back">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Products
    </a>
    <div class="vp-title">
      <h2>
        Manage Variants
        <span class="product-badge"><%= product.name %></span>
      </h2>
      <p>Add, edit or remove product variants</p>
    </div>
  </div>

  <!-- Variants Table -->
  <div class="vp-card">
    <div class="vp-card-header">
      <h5>Existing Variants</h5>
      <span class="variant-count"><%= product.variants ? product.variants.length : 0 %> variant<%= (!product.variants || product.variants.length !== 1) ? 's' : '' %></span>
    </div>
    <div class="vp-table-wrap">
      <table class="vp-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Color</th>
            <th>Regular Price</th>
            <th>Sale Price</th>
            <th>Qty</th>
            <th>Images</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!product.variants || product.variants.length === 0) { %>
            <tr>
              <td colspan="7">
                <div class="empty-state">
                  <p>No variants found. Add your first variant below.</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% product.variants.forEach((variant, index) => { %>
              <tr>
                <td style="color:#94a3b8;font-size:12px;"><%= index + 1 %></td>
                <td>
                  <span class="color-chip">
                    <span class="color-dot" style="background:<%= variant.color %>;"></span>
                    <%= variant.color %>
                  </span>
                </td>
                <td><span class="regular-price">₹<%= variant.regularPrice %></span></td>
                <td><span class="price-text sale-price">₹<%= variant.salePrice %></span></td>
                <td><span class="qty-chip"><%= variant.quantity %></span></td>
                <td>
                  <div class="thumb-row">
                    <% if (variant.productImage && variant.productImage.length > 0) { %>
                      <% variant.productImage.forEach((img, imgIdx) => { %>
                        <img src="/<%= img %>" alt="Image <%= imgIdx+1 %>" class="thumb-img"
                             onerror="this.style.opacity='0.3';">
                      <% }) %>
                    <% } else { %>
                      <span style="font-size:12px;color:#94a3b8;">No images</span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="action-group">
                    <button class="btn-act info"
                      data-variant-id="<%= variant._id %>"
                      data-variant-color="<%= variant.color %>"
                      data-variant-regularPrice="<%= variant.regularPrice %>"
                      data-variant-salePrice="<%= variant.salePrice %>"
                      data-variant-quantity="<%= variant.quantity %>"
                      data-variant-images='<%- JSON.stringify(variant.productImage || []) %>'
                      onclick="openEditVariantModalData(this)">
                      <i class="fas fa-edit" style="font-size:11px;"></i> Edit
                    </button>
                    <form method="POST" action="/admin/product/<%= product._id %>/variants/<%= variant._id %>/delete" style="display:inline;">
                      <button type="submit" class="btn-act danger" onclick="return confirm('Delete this variant?')">
                        <i class="fas fa-trash-alt" style="font-size:11px;"></i> Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Variant Form -->
  <div class="form-card">
    <div class="form-card-header">
      <h5>Add New Variant</h5>
    </div>
    <div class="form-card-body">
      <form id="addVariantForm" action="/admin/product/<%= product._id %>/variants/add" method="POST" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="productId" value="<%= product._id %>">

        <div class="form-grid">
          <!-- Color -->
          <div class="field-group">
            <label for="color">Color</label>
            <input type="text" id="color" name="color" class="field-input" placeholder="e.g. Red or #FF0000" required>
            <span class="field-error" id="color-error"></span>
          </div>

          <!-- Regular Price -->
          <div class="field-group">
            <label for="regularPrice">Regular Price (₹)</label>
            <input type="text" id="regularPrice" name="regularPrice" class="field-input" placeholder="e.g. 1499" required>
            <span class="field-error" id="regularPrice-error"></span>
          </div>

          <!-- Sale Price -->
          <div class="field-group">
            <label for="salePrice">Sale Price (₹)</label>
            <input type="text" id="salePrice" name="salePrice" class="field-input" placeholder="e.g. 999" required>
            <span class="field-error" id="salePrice-error"></span>
          </div>

          <!-- Quantity -->
          <div class="field-group">
            <label>Quantity</label>
            <div class="qty-stepper">
              <button type="button" id="decrement">−</button>
              <input type="number" id="quantity" name="quantity" min="0" value="0" required>
              <button type="button" id="increment">+</button>
            </div>
            <span class="field-error" id="quantity-error"></span>
          </div>
        </div>

        <!-- Image Upload -->
        <div class="image-section-label">Variant Images (4 Required)</div>
        <div class="image-upload-grid">
          <% for (let i = 1; i <= 4; i++) { %>
            <div class="image-slot">
              <div class="image-section-label" style="text-align:center;">Image <%= i %></div>
              <div class="image-preview-box" id="previewBox<%= i %>">
                <div class="upload-placeholder" id="placeholder<%= i %>">
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Click to upload
                </div>
                <div class="cropper-wrap" id="cropperWrap<%= i %>">
                  <img id="previewImg<%= i %>">
                </div>
                <img id="croppedPreview<%= i %>" class="visible" style="display:none;width:100%;height:100%;object-fit:cover;">
              </div>
              <input type="file" id="image<%= i %>" name="image<%= i %>" accept="image/jpeg,image/jpg,image/png,image/webp"
                     onchange="previewVariantImage(event, <%= i %>)">
              <label for="image<%= i %>" class="btn-choose-file">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                Choose File
              </label>
              <button type="button" class="btn-crop" id="cropBtn<%= i %>" onclick="cropVariantImage(<%= i %>)">
                <i class="fas fa-crop-alt" style="font-size:11px;"></i> Crop & Save
              </button>
              <input type="hidden" id="croppedImage<%= i %>" name="croppedImage<%= i %>">
            </div>
          <% } %>
        </div>

        <button type="submit" class="btn-submit" id="addSubmitBtn">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Add Variant
        </button>
      </form>
    </div>
  </div>

</div>

<!-- Edit Variant Modal -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form id="editVariantForm" method="POST" enctype="multipart/form-data" novalidate>
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Variant</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="variantId" name="variantId">

          <div class="form-grid">
            <div class="field-group">
              <label for="editColor">Color</label>
              <input type="text" id="editColor" name="color" class="field-input" required>
              <span class="field-error" id="editColor-error"></span>
            </div>
            <div class="field-group">
              <label for="editRegularPrice">Regular Price (₹)</label>
              <input type="text" id="editRegularPrice" name="regularPrice" class="field-input" required>
              <span class="field-error" id="editRegularPrice-error"></span>
            </div>
            <div class="field-group">
              <label for="editSalePrice">Sale Price (₹)</label>
              <input type="text" id="editSalePrice" name="salePrice" class="field-input" required>
              <span class="field-error" id="editSalePrice-error"></span>
            </div>
            <div class="field-group">
              <label for="editQuantity">Quantity</label>
              <input type="number" id="editQuantity" name="quantity" class="field-input" min="0" required>
              <span class="field-error" id="editQuantity-error"></span>
            </div>
          </div>

          <div class="image-section-label" style="margin-top:4px;">Update Images</div>
          <div class="image-upload-grid">
            <% for (let i = 1; i <= 4; i++) { %>
              <div class="image-slot">
                <div class="image-section-label" style="text-align:center;">Image <%= i %></div>
                <div class="image-preview-box" id="editPreviewBox<%= i %>">
                  <img id="currentImg<%= i %>" src="" alt="Current" style="display:none;width:100%;height:100%;object-fit:cover;">
                  <div class="upload-placeholder" id="editPlaceholder<%= i %>">
                    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="22" height="22">
