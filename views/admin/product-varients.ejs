<!-- Cropper.js CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
<style>
.variant-preview {
  width: 100%;
  max-width: 400px;
  height: 400px;
  border: 1px solid #ddd;
  border-radius: 6px;
  overflow: hidden;
  margin: auto;
  background: #f8f8f8;
}

/* Ensure preview image fits inside box */
.variant-preview img {
  width: 100%;
  height: 100%;
  display: block;
  max-width: 100%;
}

/* Allow cropper to use full space */
.cropper-container {
  max-width: 100%;
  margin: auto;
}

.variant-image-thumb {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: 4px;
  border: 1px solid #ddd;
  margin: 2px;
}

/* Edit modal current image display */
.current-image-display {
  width: 100%;
  max-width: 400px;
  height: 400px;
  border: 1px solid #ddd;
  border-radius: 6px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  position: relative;
}

.current-image-display img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
</style>
<section class="container my-4">
  <h2 class="mb-4">Manage Variants for Product: <%= product.name %></h2>

  <!-- Variant List -->
  <div class="table-responsive mb-4">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th style="width: 5%;">#</th>
          <th style="width: 10%;">Color</th>
          <th style="width: 10%;">Regular Price</th>
          <th style="width: 10%;">Final Price</th>
          <th style="width: 10%;">Quantity</th>
          <th style="width: 30%;">Images</th>
          <th style="width: 25%;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!product.variants || product.variants.length === 0) { %>
          <tr><td colspan="7" class="text-center">No variants found.</td></tr>
        <% } else { %>
          <% product.variants.forEach((variant, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><input type="text" value="<%= variant.color %>" disabled></td>
              <td>₹<%= variant.regularPrice %></td>
              <td>₹<%= variant.salePrice.toFixed(2) %></td>
              <td><%= variant.quantity %></td>
              <td>
                <div class="d-flex flex-wrap">
                  <% console.log('Variant:', variant._id, 'productImage:', variant.productImage); %>
                  <% if (variant.productImage && variant.productImage.length > 0) { %>
                    <% variant.productImage.forEach((image, imgIndex) => { %>
                      <% console.log('Image path:', image); %>
                      <img src="/<%= image %>" alt="Variant Image <%= imgIndex + 1 %>" class="variant-image-thumb" onerror="console.error('Failed to load:', this.src); this.style.border='2px solid red';" />
                    <% }); %>
                  <% } else { %>
                    <small class="text-muted">No images</small>
                  <% } %>
                </div>
              </td>


              <td class="actions-cell">
                <!-- <a href="/admin/product/<%= product._id %>/variants/<%= variant._id %>/edit" class="btn btn-info btn-sm" title="Edit">
                  <i class="fas fa-edit"></i>
                </a> -->
                <button class="btn btn-info btn-sm" onclick='openEditVariantModal("<%= variant._id %>", "<%= variant.color %>", "<%= variant.regularPrice %>", "<%= variant.salePrice %>", "<%= variant.quantity %>", <%- JSON.stringify(variant.productImage || []) %>)' title="Edit">
                  <i class="fas fa-edit"></i>
                </button>
                
                <form method="POST" action="/admin/product/<%= product._id %>/variants/<%= variant._id %>/delete" style="display:inline;">
                  <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this variant?');" title="Delete">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Add Variant Form -->
