<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

<script>
/* ── Cropper state ── */
let cropperInstances     = {};
let editCropperInstances = {};

/* ── ADD FORM: image preview + crop ── */
function previewVariantImage(event, i) {
  const file = event.target.files[0];
  if (!file) return;

//image validation
  const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
  if (!allowedTypes.includes(file.type)) {
    Swal.fire({ 
      icon: 'error', 
      title: 'Invalid File', 
      text: `"${file.type || 'this file type'}" is not allowed. Only JPG, PNG and WEBP images are accepted.` 
    });
    event.target.value = ''; // reset input
    return;
  }

  const maxSize = 5 * 1024 * 1024;
  if (file.size > maxSize) {
    Swal.fire({ icon: 'error', title: 'File Too Large', text: 'Maximum allowed size is 5MB.' });
    event.target.value = '';
    return;
  }


  const reader = new FileReader();
  reader.onload = function(e) {
    const wrap    = document.getElementById(`cropperWrap${i}`);
    const img     = document.getElementById(`previewImg${i}`);
    const cropBtn = document.getElementById(`cropBtn${i}`);
    const ph      = document.getElementById(`placeholder${i}`);
    const cp      = document.getElementById(`croppedPreview${i}`);

    cp.style.display = 'none';
    ph.style.display  = 'none';
    wrap.classList.add('visible');
    cropBtn.classList.add('visible');
    img.src = e.target.result;
    img.dataset.cropped = '';

    if (cropperInstances[i]) { cropperInstances[i].destroy(); }

    img.onload = function() {
      if (!img.dataset.cropped) {
        cropperInstances[i] = new Cropper(img, {
          aspectRatio: 1, viewMode: 1, dragMode: 'move',
          autoCropArea: 0.8, responsive: true, restore: false,
          guides: true, center: true, highlight: false,
          cropBoxMovable: true, cropBoxResizable: true
        });
      }
    };
  };
  reader.readAsDataURL(file);
}

function cropVariantImage(i) {
  const cropper = cropperInstances[i];
  if (!cropper) return;

  const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
  const dataUrl = canvas.toDataURL('image/webp', 0.9);
  document.getElementById(`croppedImage${i}`).value = dataUrl;

  const wrap    = document.getElementById(`cropperWrap${i}`);
  const img     = document.getElementById(`previewImg${i}`);
  const cropBtn = document.getElementById(`cropBtn${i}`);
  const cp      = document.getElementById(`croppedPreview${i}`);

  cropper.destroy();
  cropperInstances[i] = null;
  img.onload = null;
  img.dataset.cropped = 'true';
  wrap.classList.remove('visible');
  cropBtn.classList.remove('visible');
  cp.src = dataUrl;
  cp.style.display = 'block';

  Swal.fire({ icon: 'success', title: 'Cropped!', text: 'Image cropped successfully', timer: 1200, showConfirmButton: false });
}

/* ── EDIT MODAL: image preview + crop ── */
function previewEditVariantImage(event, i) {
  const file = event.target.files[0];
  if (!file) return;

   // image validation
   const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
  if (!allowedTypes.includes(file.type)) {
    Swal.fire({ 
      icon: 'error', 
