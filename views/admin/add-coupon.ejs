<%- include('partials/header', { title: 'Coupon Management' }) %>
<%- include('partials/sidebar', { admin }) %>

<style>
  .error-message {
    color: red;
  }
</style>
<div class="container my-5">
  <div class="card shadow rounded p-4">
    <h2 class="mb-4 text-center text-uppercase text-primary">Add New Coupon</h2>

    <form id="couponForm">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Coupon Name</label>
          <input type="text" name="name" class="form-control" id="name" placeholder="Eg: Summer sale" maxlength="80" required>
          <div class="error-message" id="nameError"></div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Coupon Code</label>
          <input
            type="text"
            name="code"
            class="form-control text-uppercase"
            id="code"
            placeholder="Eg: SAVE20"
      
            minlength="5"
            maxlength="20"
            pattern="[A-Za-z0-9]{5,}"
            required
          >
          <div class="error-message" id="codeError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Coupon Type</label>
          <select name="type" class="form-select" id="type">
            <option value="percentage">Percentage (%)</option>
            <option value="fixed">Fixed Amount (INR)</option>
          </select>
          <div class="error-message" id="couponTypeError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Discount Value</label>
          <div class="input-group">
            <span class="input-group-text" id="discountPrefix">%</span>
            <input type="number" name="value" class="form-control" id="value" placeholder="Eg: 10 or 100"  min="1" step="1" >
          </div>
          <div class="error-message" id="discountError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Minimum Order Amount (INR)</label>
          <input type="number" name="minOrderAmount" id="minOrderAmount" class="form-control" placeholder="Eg: 500"  min="500" step="1" required>
          <div class="error-message" id="minAmountError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Usage Limit (Total)</label>
          <input type="number" name="usageLimit" id="usageLimit" class="form-control" value="1"  min="1" step="1" required>
          <div class="error-message" id="limitError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Usage Limit Per User</label>
          <input type="number" name="usagePerUser" id="usagePerUser" class="form-control" value="1" min="1" step="1" required>
          <div class="error-message" id="limitPerUserError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Starting Date</label>
          <input type="date" name="startingDate" id="startingDate" class="form-control" required>
          <div class="error-message" id="startdateError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Expiry Date</label>
          <input type="date" name="expiryDate" id="expiryDate" class="form-control" required>
          <div class="error-message" id="enddateError"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Status</label>
          <select name="status" id="status" class="form-select">
            <option value="Active" selected>Active</option>
            <option value="Inactive">Inactive</option>
          </select>
          <div class="error-message" id="statusError"></div>
        </div>
      </div>

      <div class="mt-4 d-flex justify-content-between">
        <a href="/admin/coupon" class="btn btn-outline-secondary">Back</a>
        <button type="submit" class="btn btn-primary px-4">Create Coupon</button>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const getLocalISODate = (date = new Date()) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  };

  const form = document.getElementById("couponForm");
  const fieldIds = [
    "name", "code", "type", "value", "minOrderAmount",
    "usageLimit", "usagePerUser", "startingDate", "expiryDate", "status",
  ];
  const errorMap = {
    name: document.getElementById("nameError"),
    code: document.getElementById("codeError"),
    type: document.getElementById("couponTypeError"),
    value: document.getElementById("discountError"),
    minOrderAmount: document.getElementById("minAmountError"),
    usageLimit: document.getElementById("limitError"),
    usagePerUser: document.getElementById("limitPerUserError"),
    startingDate: document.getElementById("startdateError"),
    expiryDate: document.getElementById("enddateError"),
    status: document.getElementById("statusError"),
  };

  const startingDateInput = document.getElementById("startingDate");
  const expiryDateInput = document.getElementById("expiryDate");
  const typeInput = document.getElementById("type");
  const today = getLocalISODate();
  startingDateInput.min = today;

  const setError = (key, message) => {
    if (errorMap[key]) errorMap[key].innerText = message;
  };

  const getFormValues = () => ({
    couponName: document.getElementById("name").value.trim(),
    couponCode: document.getElementById("code").value.trim().toUpperCase(),
    couponType: typeInput.value,
    discountValue: Number(document.getElementById("value").value),
    minAmount: Number(document.getElementById("minOrderAmount").value),
    usageLimit: Number(document.getElementById("usageLimit").value),
    usagePerUser: Number(document.getElementById("usagePerUser").value),
    startingDate: startingDateInput.value,
    expiryDate: expiryDateInput.value,
    status: document.getElementById("status").value,
  });

  const touchedFields = new Set();
  let hasSubmitted = false;

  const validationRules = {
    name: (values) => {
      if (values.couponName.length < 5) return "Coupon name must be at least 5 characters long";
      const alnumCount = values.couponName.replace(/[^A-Za-z0-9]/g, "").length;
      if (alnumCount < 3) return "Coupon name must contain at least 3 letters or numbers";
      return "";
    },
    code: (values) => (!values.couponCode || !/^[A-Z0-9]{5,}$/.test(values.couponCode)
      ? "Please enter a valid coupon code (minimum 5 alphanumeric characters)"
      : ""),
    type: (values) => (!values.couponType ? "Please select coupon type" : ""),
    value: (values) => {
      if (!Number.isFinite(values.discountValue) || values.discountValue <= 0) return "Discount must be greater than 0";
      if (values.couponType === "percentage" && values.discountValue > 100) return "Percentage discount must be between 1 and 100";
      return "";
    },
    minOrderAmount: (values) => (!Number.isFinite(values.minAmount) || values.minAmount < 500
      ? "Minimum amount must be INR 500 or more"
      : ""),
    usageLimit: (values) => (!Number.isInteger(values.usageLimit) || values.usageLimit < 1
      ? "Usage limit should be at least 1"
      : ""),
    usagePerUser: (values) => {
      if (!Number.isInteger(values.usagePerUser) || values.usagePerUser < 1) return "Usage per user should be at least 1";
      if (values.usagePerUser > values.usageLimit) return "Usage per user cannot be greater than usage limit";
      return "";
    },
    startingDate: (values) => (!values.startingDate || values.startingDate < today
      ? "Starting date should be today or later"
      : ""),
    expiryDate: (values) => (!values.expiryDate || values.expiryDate <= values.startingDate
      ? "Expiry date should be greater than start date"
      : ""),
    status: (values) => (!values.status ? "Please select status" : ""),
  };

  const validateForm = (showAll = false) => {
    const values = getFormValues();
    let isValid = true;

    Object.keys(errorMap).forEach((fieldKey) => {
      const message = validationRules[fieldKey](values);
      const shouldShow = showAll || hasSubmitted || touchedFields.has(fieldKey);

      if (shouldShow) {
        setError(fieldKey, message);
      } else {
        setError(fieldKey, "");
      }

      if (message) isValid = false;
    });

    return { isValid, values };
  };

  startingDateInput.addEventListener("change", function () {
    expiryDateInput.min = this.value || today;
    touchedFields.add("startingDate");
    touchedFields.add("expiryDate");
    validateForm(false);
  });

  typeInput.addEventListener("change", function () {
    const prefixSpan = document.getElementById("discountPrefix");
    prefixSpan.textContent = this.value === "percentage" ? "%" : "INR";
    touchedFields.add("type");
    touchedFields.add("value");
    validateForm(false);
  });

  fieldIds.forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    const eventType = el.tagName === "SELECT" || el.type === "date" ? "change" : "input";
    el.addEventListener(eventType, () => {
      touchedFields.add(id);
      validateForm(false);
    });
    el.addEventListener("blur", () => {
      touchedFields.add(id);
      validateForm(false);
    });
  });

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    hasSubmitted = true;
    const { isValid, values } = validateForm(true);
    if (!isValid) return;

    const formData = {
      name: values.couponName,
      code: values.couponCode,
      type: values.couponType,
      offerPrice: values.discountValue,
      minimumPrice: values.minAmount,
      usageLimit: values.usageLimit,
      usagePerUser: values.usagePerUser,
      startingDate: values.startingDate,
      expiryDate: values.expiryDate,
      status: values.status,
    };

    try {
      const response = await fetch("/admin/coupons/add", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(formData),
      });

      const result = await response.json();
      if (response.ok && result.success) {
        Swal.fire({
          icon: "success",
          title: "Coupon Added",
          text: "Coupon added successfully",
          timer: 1200,
          showConfirmButton: false,
        }).then(() => {
          window.location.href = "/admin/coupon";
        });
      } else {
        Swal.fire({
          icon: "warning",
          title: "Oops",
          text: result.message || "Something went wrong",
          timer: 1500,
          showConfirmButton: false,
        });
      }
    } catch (error) {
      console.error("Error while adding coupon", error);
      Swal.fire({
        icon: "error",
        title: "Error",
        text: error.message || "Internal server error",
      });
    }
  });
</script>
<%- include('partials/footer') %>
