<style>
  .search-box {
    display: flex; align-items: center; gap: 8px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0 14px; height: 42px; max-width: 360px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .search-box:focus-within {
    border-color: #94a3b8;
    box-shadow: 0 0 0 3px rgba(148,163,184,0.15);
  }
  .search-box svg { color: #94a3b8; flex-shrink: 0; }
  .search-box input {
    border: none; outline: none; background: transparent;
    font-size: 14px; color: #1e293b;
    font-family: "DM Sans", sans-serif; flex: 1;
  }
  .search-box input::placeholder { color: #cbd5e1; }
  .count-label { font-size: 13px; color: #64748b; margin-top: 6px; }
  mark { background: #fef9c3; color: #713f12; border-radius: 2px; padding: 0 1px; }
</style>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-9 col-lg-10 mx-auto py-4">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="content-title card-title">Customers</h2>
      </div>

      <!-- Search Bar -->
      <header class="card-header text-center mb-2">
        <form id="searchForm" method="GET" action="/admin/users">
          <div class="search-box mx-auto">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input
              type="text"
              name="search"
              id="searchInput"
              placeholder="Search customers..."
              value="<%= searchQuery || '' %>"
              autocomplete="off"
            />
          </div>
        </form>
      </header>
      <div class="count-label text-center mb-3" id="countLabel">
        Showing <%= data.length %> customers
      </div>

      <!-- Table -->
      <div class="card p-3 shadow-sm">
        <table class="table table-striped text-center align-middle" id="customerTable">
          <thead>
            <tr>
              <th><b>Name</b></th>
              <th><b>Email</b></th>
              <th><b>Phone No</b></th>
              <th><b>Action</b></th>
            </tr>
          </thead>
          <tbody>
            <% for(let i = 0; i < data.length; i++) { %>
            <tr>
              <td><%= data[i].username %></td>
              <td><%= data[i].email %></td>
              <td><%= data[i].phone ? data[i].phone : 'Not provided' %></td>
              <td>
                <% if(data[i].isBlocked === false) { %>
                  <a href="/admin/blockCustomer?id=<%= data[i]._id %>" class="btn btn-danger btn-sm">Block</a>
                <% } else { %>
                  <a href="/admin/unblockCustomer?id=<%= data[i]._id %>" class="btn btn-success btn-sm">Unblock</a>
                <% } %>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
        <div id="noResults" style="display:none; text-align:center; padding:2rem; color:#64748b;">
          No customers match your search.
        </div>
      </div>

      <!-- Pagination -->
      <div class="mt-4">
        <nav>
          <ul class="pagination justify-content-center">

            <%
              const delta = 2;
              let pages = [];
              let lastRenderedPage = null;

              for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) {
                  pages.push(i);
                }
              }
            %>

            <!-- Previous -->
            <% if (currentPage > 1) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>">&#8249;</a>
              </li>
            <% } else { %>
              <li class="page-item disabled"><span class="page-link">&#8249;</span></li>
            <% } %>

            <!-- Page Numbers -->
            <% pages.forEach(function(i) { %>
              <% if (lastRenderedPage !== null && i - lastRenderedPage > 1) { %>
                <li class="page-item disabled"><span class="page-link">…</span></li>
              <% } %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"><%= i %></a>
              </li>
              <% lastRenderedPage = i; %>
            <% }); %>

            <!-- Next -->
            <% if (currentPage < totalPages) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>">&#8250;</a>
              </li>
            <% } else { %>
              <li class="page-item disabled"><span class="page-link">&#8250;</span></li>
            <% } %>

          </ul>
        </nav>
      </div>

    </div>
  </div>
</div>

