            <li class="page-item <%= i===currentPage ? 'active':'' %>">
              <a class="page-link" href="/shop?page=<%= i %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </div>

    </div>
  </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Auto-submit filter selects
  document.querySelectorAll(".sidebar-filter select").forEach(select => {
    select.addEventListener("change", () => {
      select.form.submit();
    });
  });

  // Sort auto-submit (already works, but ensure consistency)
  // const sortSelect = document.querySelector("select[name='sort']");
  // if(sortSelect){
  //   sortSelect.addEventListener("change", () => {
  //     sortSelect.form.submit();
  //   });
  // }

  // Clear Filters Button redirects to shop (reset)
  const clearBtn = document.querySelector(".btn.btn-outline-secondary.w-100");
  if(clearBtn){
    clearBtn.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.href = "/shop";
    });
  }


  // Wishlist
  function markWishlisted(btn){
    if (!btn) return;
    const icon = btn.querySelector('i');
    if (icon) {
      icon.classList.remove('fa-regular');
      icon.classList.add('fa-solid', 'text-danger');
    }
    btn.title = 'Already in wishlist';
  }

  function addToWishlist(productId, e, btn){
    e && e.preventDefault();
    const icon = btn ? btn.querySelector('i') : null;
    const alreadyWishlisted = icon && icon.classList.contains('fa-solid');

    if (alreadyWishlisted) {
      return Swal.fire({
        icon: 'info',
        title: 'Info',
        text: 'Already in wishlist'
      });
    }

    $.post('/addToWishlist', { productId })
      .done(resp => {
        if(resp.status){ 
          markWishlisted(btn);
          Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: 'Added to wishlist',
            showConfirmButton: false,
            timer: 1500
          });
        }
        else{ 
          markWishlisted(btn);
          Swal.fire({
            icon: 'info',
            title: 'Info',
            text: resp.message || 'Already in wishlist'
          });
        }
      })
      .fail((xhr, status, error) => {
        console.error('Wishlist error:', xhr, status, error);
        if (xhr.status === 401) {
          Swal.fire({
            icon: 'warning',
            title: 'Please Login',
            text: 'You need to login to add items to wishlist',
            confirmButtonText: 'Go to Login'
          }).then(() => {
            window.location.href = '/login';
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Failed',
            text: xhr.responseJSON?.message || 'Failed to add to wishlist'
          });
        }
      });
  }

</script>

