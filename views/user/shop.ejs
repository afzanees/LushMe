      <!-- PRODUCTS GRID -->
       <div class="position-relative">
      <div class="row g-4">
        <% products.forEach(product => { %>
          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card h-100 shadow-sm text-center">
              <% 
                // Get all variant images
                let variantImages = [];
                if (product.variants && product.variants.length > 0 && 
                    product.variants[0].productImage && product.variants[0].productImage.length > 0) {
                  variantImages = product.variants[0].productImage;
                }
              %>
              
<button
  class="wishlist-btn"
  onclick="addToWishlist('<%= product._id %>', event, this)"
  title="<%= wishlistIds.includes(product._id.toString()) ? 'Already in wishlist' : 'Add to wishlist' %>"
>
  <i class="<%= wishlistIds.includes(product._id.toString()) ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
</button>

              <!-- Image Carousel for Multiple Images -->
              <% if (variantImages.length > 0) { %>
                <div id="carousel-<%= product._id %>" class="carousel slide" data-bs-ride="false" style="height:260px;">
                  <div class="carousel-inner h-100">
                    <% variantImages.forEach((image, index) => { %>
                      <div class="carousel-item <%= index === 0 ? 'active' : '' %> h-100">
                        <img src="/<%= image %>" class="d-block w-100 h-100" style="object-fit:cover;" alt="<%= product.name %> - Image <%= index + 1 %>">
                      </div>
                    <% }) %>
                  </div>
                  
                  <!-- Navigation Controls (only show if more than 1 image) -->
                  <% if (variantImages.length > 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carousel-<%= product._id %>" data-bs-slide="prev" style="width: 10%;">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carousel-<%= product._id %>" data-bs-slide="next" style="width: 10%;">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Next</span>
                    </button>
                    
                    <!-- Image Indicators -->
                    <div class="carousel-indicators">
                      <% variantImages.forEach((image, index) => { %>
                        <button type="button" data-bs-target="#carousel-<%= product._id %>" data-bs-slide-to="<%= index %>" <%= index === 0 ? 'class="active" aria-current="true"' : '' %> aria-label="Slide <%= index + 1 %>"></button>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              <% } else { %>
                <!-- Placeholder if no images -->
                <img src="/images/placeholder.jpg" class="card-img-top" style="object-fit:cover; height:260px;" alt="<%= product.name %>">
              <% } %>

              <div class="card-body">
                <h6 class="fw-semibold"><%= product.name %></h6>
                <% if (product.brand && product.brand.name) { %>
                  <p class="text-muted small m-0"><%= product.brand.name %></p>
                <% } %>
                
                <% 
                  // Check if product is out of stock
                  const totalQty = (product.variants||[]).reduce((sum, v) => sum + (Number(v.quantity)||0), 0);
                  const isOutOfStock = totalQty <= 0 || product.status === "Out Of Stock";
                %>
                
                <% if (product.effectiveOffer > 0) { %>
                  <span class="badge bg-danger mb-1"><%= product.effectiveOffer %>% OFF</span>
                <% } %>
                
                <% if (product.displaySalePrice && product.displaySalePrice < product.displayRegularPrice) { %>
                  <p class="text-muted mb-0" style="font-size:13px;">
                    <del>&#8377; <%= product.displayRegularPrice.toLocaleString('en-IN') %></del>
                  </p>
                  <p class="fw-bold text-success mb-0" style="font-size:16px;">
                    &#8377; <%= product.displaySalePrice.toLocaleString('en-IN') %>
                  </p>
                <% } else if (product.displayRegularPrice) { %>
                  <p class="fw-bold mb-0">&#8377; <%= product.displayRegularPrice.toLocaleString('en-IN') %></p>
                <% } else { %>
                  <p class="text-muted">Price not available</p>
                <% } %>
                
                <a href="/productDetails/<%= product.slug %>" class="btn btn-dark btn-sm mt-2">View</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
       </div>

