<%- include("../partials/user/header") -%>

<style>
  .sidebar-filter { width: 260px; }
  .product-grid { flex: 1; }
  .filter-container { display:flex; gap:20px; }
  .top-bar { display:flex; justify-content:space-between; align-items:center; margin:20px 0; background-color:white; }
</style>

<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('images/bg-01.jpg');">
  <h2 class="ltext-105 cl0 txt-center">Shop</h2>
</section>

<div class="container my-5">
  <div class="filter-container">

    <!-- LEFT FILTERS -->
    <div class="sidebar-filter">
      <form action="/filter" method="GET" class="border p-3 rounded shadow-sm bg-light">
        <h5 class="fw-bold mb-3">Filters</h5>

        <!-- Search -->
        <!-- <div class="mb-3">
          <label class="form-label">Search</label>
          <input type="text" name="search" value="<%= search || '' %>" class="form-control" placeholder="Search products...">
        </div> -->

        <!-- Category -->
        <div class="mb-3">
          <label class="form-label">Category</label>
          <select name="category" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            <% category.forEach(cat => { %>
              <option value="<%= cat._id %>" <%= selectedCategory == cat._id ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Subcategory -->
        <div class="mb-3">
          <label class="form-label">Subcategory</label>
          <select name="subcategory" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            <% if(selectedCategory && category.find(c=>c._id==selectedCategory)){ %>
              <% category.find(c=>c._id==selectedCategory).subcategories.forEach(sub => { %>
                <option value="<%= sub._id %>" <%= selectedSubcategory == sub._id ? 'selected' : '' %>><%= sub.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <!-- Brand -->
        <div class="mb-3">
          <label class="form-label">Brand</label>
          <select name="brand" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            <% brands.forEach(b=>{ %>
            <option value="<%= b._id %>" <%= selectedBrand == b._id ? 'selected' : '' %>><%= b.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Price -->
        <div class="mb-3">
          <label class="form-label">Price</label>
          <select name="price" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="0-500" <%= selectedPrice=='0-500'?'selected':'' %>>₹0 - ₹500</option>
            <option value="500-1000" <%= selectedPrice=='500-1000'?'selected':'' %>>₹500 - ₹1000</option>
            <option value="1000-2000" <%= selectedPrice=='1000-2000'?'selected':'' %>>₹1000 - ₹2000</option>
            <option value="2000-4000" <%= selectedPrice=='2000-4000'?'selected':'' %>>₹2000 - ₹4000</option>
            <option value="4000+" <%= selectedPrice=='4000+'?'selected':'' %>>₹4000+</option>
          </select>
        </div>

        <a href="/shop" class="btn btn-outline-secondary w-100">Clear All</a>
      </form>
    </div>



    <!-- RIGHT SIDE PRODUCT AREA -->
    <div class="product-grid">

      <!-- SEARCH + SORT TOP BAR -->
<div class="top-bar">
<form action="/shop" method="GET" class="d-flex gap-2" style="max-width:350px;">
  
  <input 
    type="text" 
    name="search" 
    class="form-control" 
    placeholder="Search products..." 
    value="<%= search || '' %>"
  />

  <button type="submit" class="btn btn-dark">Search</button>

  <% if(search && search.trim() !== '') { %>
    <a href="/shop" class="btn btn-outline-secondary">Clear</a>
  <% } %>

</form>


<form action="/filter" method="GET" class="d-flex gap-2">
  <!-- keep current filters so sort doesn't clear them -->
  <input type="hidden" name="category"    value="<%= selectedCategory || '' %>">
  <input type="hidden" name="subcategory" value="<%= selectedSubcategory || '' %>">
  <input type="hidden" name="brand"       value="<%= selectedBrand || '' %>">
  <input type="hidden" name="price"       value="<%= selectedPrice || '' %>">
  <input type="hidden" name="color"       value="<%= selectedColor || '' %>">
  <input type="hidden" name="search"      value="<%= search || '' %>">

  <select name="sort" class="form-select" onchange="this.form.submit()">
    <option value="">Sort</option>
    <option value="price_asc"  <%= selectedSort==='price_asc'  ? 'selected' : '' %>>Price: Low to High</option>
    <option value="price_desc" <%= selectedSort==='price_desc' ? 'selected' : '' %>>Price: High to Low</option>
    <option value="name_asc"   <%= selectedSort==='name_asc'   ? 'selected' : '' %>>A - Z</option>
    <option value="name_desc"  <%= selectedSort==='name_desc'  ? 'selected' : '' %>>Z - A</option>
  </select>
</form>
</div>

          <%
function updateQuery(query, key, value) {
const params = new URLSearchParams(query);
if (value === null || value === '') params.delete(key);
else params.set(key, value);
return `/filter?${params.toString()}`;
}
%>
<div class="d-flex flex-wrap gap-2 mb-4">
<% if (selectedBrand) { %>
<a href="<%= updateQuery(query, 'brand', null) %>" class="badge rounded-pill bg-secondary text-white">
<%= brands.find(b => b._id.toString() === selectedBrand)?.name %> ×
</a>
<% } %>
<% if (selectedCategory) { %>
<a href="<%= updateQuery(query, 'category', null) %>" class="badge rounded-pill bg-secondary text-white">
<%= category.find(c => c._id.toString() === selectedCategory)?.name %> ×
</a>
<% } %>
<% if (selectedSubcategory) { %>
<a href="<%= updateQuery(query, 'subcategory', null) %>" class="badge rounded-pill bg-secondary text-white">
Subcategory ×
</a>
<% } %>
<% if (selectedPrice) { %>
<a href="<%= updateQuery(query, 'price', null) %>" class="badge rounded-pill bg-secondary text-white">
<%= selectedPrice === '4000+' ? '4000+ ₹' : selectedPrice + ' ₹' %> ×
</a>
<% } %>
<% if (selectedSort && selectedSort !== 'default') { %>
<a href="<%= updateQuery(query, 'sort', null) %>" class="badge rounded-pill bg-secondary text-white">
Sort: <%= selectedSort %> ×
</a>
<% } %>
</div>
     
      <!-- PRODUCTS GRID -->
      <div class="row g-4">
        <% products.forEach(product => { %>
          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card h-100 shadow-sm text-center">
              <% 
                // Get all variant images
                let variantImages = [];
                if (product.variants && product.variants.length > 0 && 
                    product.variants[0].productImage && product.variants[0].productImage.length > 0) {
                  variantImages = product.variants[0].productImage;
                }
              %>
              
              <!-- Image Carousel for Multiple Images -->
              <% if (variantImages.length > 0) { %>
                <div id="carousel-<%= product._id %>" class="carousel slide" data-bs-ride="false" style="height:260px;">
                  <div class="carousel-inner h-100">
                    <% variantImages.forEach((image, index) => { %>
                      <div class="carousel-item <%= index === 0 ? 'active' : '' %> h-100">
                        <img src="/<%= image %>" class="d-block w-100 h-100" style="object-fit:cover;" alt="<%= product.name %> - Image <%= index + 1 %>">
                      </div>
                    <% }) %>
                  </div>
                  
                  <!-- Navigation Controls (only show if more than 1 image) -->
                  <% if (variantImages.length > 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carousel-<%= product._id %>" data-bs-slide="prev" style="width: 10%;">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carousel-<%= product._id %>" data-bs-slide="next" style="width: 10%;">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Next</span>
                    </button>
                    
                    <!-- Image Indicators -->
                    <div class="carousel-indicators">
                      <% variantImages.forEach((image, index) => { %>
                        <button type="button" data-bs-target="#carousel-<%= product._id %>" data-bs-slide-to="<%= index %>" <%= index === 0 ? 'class="active" aria-current="true"' : '' %> aria-label="Slide <%= index + 1 %>"></button>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              <% } else { %>
                <!-- Placeholder if no images -->
                <img src="/images/placeholder.jpg" class="card-img-top" style="object-fit:cover; height:260px;" alt="<%= product.name %>">
              <% } %>

              <div class="card-body">
                <h6 class="fw-semibold"><%= product.name %></h6>
                <% if (product.brand && product.brand.name) { %>
                  <p class="text-muted small m-0"><%= product.brand.name %></p>
                <% } %>
                
                <% 
                  // Check if product is out of stock
                  const totalQty = (product.variants||[]).reduce((sum, v) => sum + (Number(v.quantity)||0), 0);
                  const isOutOfStock = totalQty <= 0 || product.status === "Out Of Stock";
                %>
                
                <% if (isOutOfStock) { %>
                  <span class="badge bg-danger mb-2">OUT OF STOCK</span>
                <% } %>
                
                <% if (product.displaySalePrice && product.displaySalePrice < product.displayRegularPrice) { %>
                  <p class="fw-bold text-danger">₹ <%= product.displaySalePrice %></p>
                  <p class="text-muted"><strike>₹ <%= product.displayRegularPrice %></strike></p>
                <% } else if (product.displayRegularPrice) { %>
                  <p class="fw-bold">₹ <%= product.displayRegularPrice %></p>
                <% } else { %>
                  <p class="text-muted">Price not available</p>
                <% } %>
                
                <a href="/productDetails?id=<%= product._id %>" class="btn btn-dark btn-sm mt-2">View</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- PAGINATION -->
      <div class="d-flex justify-content-center mt-4">
        <ul class="pagination">
          <% for(let i=1;i<=totalPages;i++){ %>
            <li class="page-item <%= i===currentPage ? 'active':'' %>">
              <a class="page-link" href="/shop?page=<%= i %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </div>

    </div>
  </div>
</div>

<script>
  // Auto-submit filter selects
  document.querySelectorAll(".sidebar-filter select").forEach(select => {
    select.addEventListener("change", () => {
      select.form.submit();
    });
  });

  // Sort auto-submit (already works, but ensure consistency)
  // const sortSelect = document.querySelector("select[name='sort']");
  // if(sortSelect){
  //   sortSelect.addEventListener("change", () => {
  //     sortSelect.form.submit();
  //   });
  // }

  // Clear Filters Button redirects to shop (reset)
  const clearBtn = document.querySelector(".btn.btn-outline-secondary.w-100");
  if(clearBtn){
    clearBtn.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.href = "/shop";
    });
  }

  // Wishlist action (keep your backend route)
  function addToWishlist(productId, event) {
    event.preventDefault();

    $.ajax({
      url: '/addToWishlist',
      method: 'POST',
      data: { productId },
      success: (response) => {
        if (response.status) {
          Swal.fire('Added to wishlist ✅', '', 'success');
          const btn = document.querySelector(`a[data-product-id="${productId}"]`);
          if (btn) btn.classList.add('wishlisted');
        } else {
          Swal.fire('Already in wishlist', '', 'info');
        }
      },
      error: () => {
        Swal.fire('Error', 'Failed to add to wishlist ❌', 'error');
      }
    });
  }

  window.addToWishlist = addToWishlist;
</script>

<%- include("../partials/user/footer") -%>