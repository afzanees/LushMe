<%- include("../partials/user/header") -%>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>
  body {
    font-family: "DM Sans", sans-serif;
    background-color: #f1f5f9;
    color: #1e293b;
  }

  .od-page { padding: 28px 24px; }

  /* Back + Header */
  .od-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: 9px;
    border: 1px solid #e2e8f0;
    background: #fff;
    font-size: 13px;
    color: #475569;
    font-family: "DM Sans", sans-serif;
    text-decoration: none;
    transition: background 0.15s;
  }
  .btn-back:hover { background: #f8fafc; color: #1e293b; text-decoration: none; }

  .od-title-block h2 {
    font-family: "Syne", sans-serif;
    font-size: 21px;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  .od-title-block p {
    font-size: 13px;
    color: #64748b;
    margin: 0;
  }

  .order-id-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.3px;
    margin-left: 6px;
  }

  /* Info Cards Row */
  .od-info-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }

  .od-info-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 20px 22px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .od-info-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
  }

  .od-info-icon.blue  { background: #eff6ff; color: #2563eb; }
  .od-info-icon.green { background: #f0fdf4; color: #16a34a; }
  .od-info-icon.amber { background: #fffbeb; color: #d97706; }

  .od-info-content h6 {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #94a3b8;
    margin: 0 0 8px;
  }

  .od-info-content p {
    font-size: 13px;
    color: #334155;
    margin: 0;
    line-height: 1.7;
  }

  .od-info-content strong { color: #1e293b; font-weight: 500; }

  /* Summary Bar */
  .od-summary-bar {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 32px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .summary-item { text-align: right; }

  .summary-item .s-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #94a3b8;
    margin-bottom: 2px;
  }

  .summary-item .s-val {
    font-family: "Syne", sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
  }

  .summary-item .s-val.highlight { color: #16a34a; }

  .summary-divider {
    width: 1px;
    height: 36px;
    background: #e2e8f0;
  }

  /* Items Table Card */
  .od-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
  }

  .od-card-header {
    padding: 16px 20px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .od-card-header h5 {
    font-family: "Syne", sans-serif;
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    color: #1e293b;
  }

  .items-count {
    font-size: 12px;
    background: #f1f5f9;
    color: #64748b;
    padding: 2px 8px;
    border-radius: 20px;
    font-weight: 500;
  }

  .od-table-wrap { overflow-x: auto; }

  .od-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    min-width: 900px;
  }

  .od-table thead tr { background: #1e293b; }

  .od-table thead th {
    color: #94a3b8;
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 12px 18px;
    text-align: left;
    white-space: nowrap;
  }

  .od-table tbody tr {
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.1s;
  }

  .od-table tbody tr:last-child { border-bottom: none; }
  .od-table tbody tr:hover { background: #f8fafc; }

  .od-table td {
    padding: 14px 18px;
    vertical-align: middle;
    color: #1e293b;
  }

  /* Product cell */
  .product-img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }

  .product-cell { display: flex; align-items: center; gap: 12px; }

  .product-info .p-name {
    font-weight: 500;
    font-size: 13px;
    color: #1e293b;
  }

  .product-info .p-color {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .color-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    display: inline-block;
  }

  .price-text { font-weight: 500; color: #1e293b; }
  .qty-chip {
    display: inline-block;
    background: #f1f5f9;
    color: #475569;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 500;
  }

  /* Item Status Badges */
  .ibadge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }

  .ibadge .dot { width: 6px; height: 6px; border-radius: 50%; }

  .ib-pending          { background: #f1f5f9;  color: #64748b; }
  .ib-confirmed        { background: #dcfce7;  color: #15803d; }
  .ib-shipped          { background: #dbeafe;  color: #1d4ed8; }
  .ib-delivered        { background: #dcfce7;  color: #15803d; }
  .ib-cancelled        { background: #fee2e2;  color: #b91c1c; }
  .ib-returned         { background: #e0f2fe;  color: #0369a1; }
  .ib-return-req       { background: #fef9c3;  color: #92400e; }
  .ib-cancel-req       { background: #fef9c3;  color: #92400e; }
  .ib-failed           { background: #fee2e2;  color: #b91c1c; }

  /* Action Buttons */
  .btn-act {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 11px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    font-family: "DM Sans", sans-serif;
    border: 1px solid transparent;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
    text-decoration: none;
  }

  .btn-act:hover { opacity: 0.82; }
  .btn-act.success { background: #dcfce7; color: #15803d; border-color: #bbf7d0; }
  .btn-act.danger  { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }
  .btn-act.warning { background: #fef9c3; color: #92400e; border-color: #fde68a; }
  .btn-act.no-action { background: #f1f5f9; color: #94a3b8; border-color: #e2e8f0; cursor: default; font-size: 11px; }

  /* Status select */
  .status-select {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #fff;
    font-size: 12px;
    font-family: "DM Sans", sans-serif;
    color: #1e293b;
    padding: 5px 10px;
    outline: none;
    cursor: pointer;
    min-width: 140px;
    transition: border-color 0.15s;
  }

  .status-select:focus { border-color: #94a3b8; }
  .status-select:disabled { background: #f8fafc; color: #94a3b8; cursor: default; }
</style>

<div class="od-page">

  <!-- Header -->
  <div class="od-header">
    <a href="/account" class="btn-back">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Back
    </a>
    <div class="od-title-block">
      <h2>
        Order Detail
        <span class="order-id-badge">#<%= order.orderId %></span>
      </h2>
      <p>Track your order items and request cancellation or return</p>
    </div>
  </div>

  <!-- Info Cards -->
  <div class="od-info-row">

    <!-- Customer -->
    <div class="od-info-card">
      <div class="od-info-icon blue">
        <i class="fas fa-user"></i>
      </div>
      <div class="od-info-content">
        <h6>Customer</h6>
        <p>
          <strong><%= (order.userId && (order.userId.username || order.userId.name)) || (user && (user.username || user.name)) || 'User' %></strong><br>
          <% if (order.userId.phone) { %><%= order.userId.phone %><% } %>
        </p>
      </div>
    </div>

    <!-- Order Info -->
    <div class="od-info-card">
      <div class="od-info-icon green">
        <i class="fas fa-receipt"></i>
      </div>
      <div class="od-info-content">
        <h6>Order Info</h6>
        <p>
          <strong>Payment:</strong> <%= order.paymentMethod.toUpperCase() %><br>
          <strong>Status:</strong>
          <%= ((order.paymentStatus || '').toLowerCase() === 'failed') ? 'Payment Failed' : (((order.status || '').charAt(0).toUpperCase() + (order.status || '').slice(1)) || 'Pending') %><br>
          <strong>Delivery Charge:</strong> ₹<%= Number(order.deliveryCharge || 0).toFixed(2) %>
          <% if ((order.paymentStatus || '').toLowerCase() === 'failed') { %>
            <br><span style="display:inline-flex;align-items:center;gap:5px;background:#fee2e2;color:#b91c1c;border-radius:20px;padding:2px 9px;font-size:11px;font-weight:500;margin-top:4px;">Payment Failed</span>
          <% } %>
        </p>
      </div>
    </div>

    <!-- Deliver To -->
    <div class="od-info-card">
      <div class="od-info-icon amber">
        <i class="fas fa-map-marker-alt"></i>
      </div>
      <div class="od-info-content">
        <h6>Deliver To</h6>
        <p>
          <%= order.address.houseNo %>,<br>
          <%= order.address.city %>, <%= order.address.state %><br>
          <% if (order.address.landmark) { %><%= order.address.landmark %>,<br><% } %>
          <%= order.address.pincode %>
        </p>
      </div>
    </div>

  </div>

  <!-- Summary Bar -->
  <div class="od-summary-bar">
    <div class="summary-item">
      <div class="s-label">Subtotal</div>
      <div class="s-val">₹<%= Number(order.totalPrice || 0).toFixed(2) %></div>
    </div>
    <div class="summary-divider"></div>
    <div class="summary-item">
      <div class="s-label">Delivery</div>
      <div class="s-val">₹<%= order.deliveryCharge.toFixed(2) %></div>
    </div>
    <div class="summary-divider"></div>
    <div class="summary-item">
      <div class="s-label">Grand Total</div>
      <div class="s-val highlight">₹<%= order.finalAmount.toFixed(2) %></div>
    </div>
  </div>

  <!-- Items Table -->
  <div class="od-card">
    <div class="od-card-header">
      <h5>Ordered Items</h5>
      <span class="items-count"><%= order.orderedItems.length %> item<%= order.orderedItems.length !== 1 ? 's' : '' %></span>
    </div>

    <div class="od-table-wrap">
      <table class="od-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Unit Price</th>
            <th>Qty</th>
            <th>Total</th>
            <th>Item Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% order.orderedItems.forEach((item, index) => { %>
            <%
              const isPaymentFailed = (order.paymentStatus || '').toLowerCase() === 'failed';
              const s = isPaymentFailed ? 'payment_failed' : (item.status || '').toLowerCase();
              const productName = item.productName || (item.product && item.product.name) || 'Product';
              const productImage = typeof item.productImage === 'string' ? item.productImage.replace(/\\/g, '/') : '';
              const color = item.color || (item.selectedVariant && item.selectedVariant.color) || 'N/A';
              const unitPrice = Number(item.finalPrice ?? item.price ?? 0);
              const itemIdx = Number.isInteger(item.originalIndex) ? item.originalIndex : index;

              const badgeClass =
                s === 'payment_failed'         ? 'ib-failed' :
                s === 'cancelled'              ? 'ib-cancelled' :
                s === 'delivered'              ? 'ib-delivered' :
                s === 'returned'               ? 'ib-returned' :
                s === 'cancellation_requested' ? 'ib-cancel-req' :
                s === 'return_requested'       ? 'ib-return-req' :
                s === 'shipped'                ? 'ib-shipped' :
                s === 'confirmed'              ? 'ib-confirmed' :
                'ib-pending';

              const dotColor =
                s === 'payment_failed'         ? '#dc2626' :
                s === 'cancelled'              ? '#dc2626' :
                s === 'delivered'              ? '#16a34a' :
                s === 'returned'               ? '#0369a1' :
                s === 'cancellation_requested' ? '#ca8a04' :
                s === 'return_requested'       ? '#ca8a04' :
                s === 'shipped'                ? '#2563eb' :
                s === 'confirmed'              ? '#16a34a' :
                '#94a3b8';

              const badgeLabel =
                s === 'payment_failed'         ? 'Payment Failed' :
                s === 'cancellation_requested' ? 'Cancel Requested' :
                s === 'return_requested'       ? 'Return Requested' :
                (s.charAt(0).toUpperCase() + s.slice(1));
            %>
            <tr>
              <!-- Product -->
              <td>
                <div class="product-cell">
                  <% if (productImage) { %>
                    <img src="/<%= productImage %>" alt="<%= productName %>" class="product-img">
                  <% } else { %>
                    <div class="product-img" style="background:#f1f5f9;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:18px;">
                      <i class="fas fa-image"></i>
                    </div>
                  <% } %>
                  <div class="product-info">
                    <div class="p-name"><%= productName %></div>
                    <div class="p-color">
                      <span class="color-dot" style="background:<%= color !== 'N/A' ? color : '#ccc' %>;"></span>
                      <%= color %>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Unit Price -->
              <td><span class="price-text">₹<%= unitPrice.toFixed(2) %></span></td>

              <!-- Qty -->
              <td><span class="qty-chip"><%= item.quantity %></span></td>

              <!-- Total -->
              <td><span class="price-text">₹<%= (unitPrice * Number(item.quantity || 0)).toFixed(2) %></span></td>

              <!-- Item Status -->
              <td>
                <span class="ibadge <%= badgeClass %>">
                  <span class="dot" style="background:<%= dotColor %>;"></span>
                  <%= badgeLabel %>
                </span>
              </td>

              <!-- Action -->
              <td>
                <% if (isPaymentFailed) { %>
                  <span class="btn-act no-action">No Action</span>

                <% } else if (s === 'cancellation_requested') { %>
                  <span class="btn-act no-action">Cancel Requested</span>

                <% } else if (s === 'return_requested') { %>
                  <span class="btn-act no-action">Return Requested</span>

                <% } else if (['delivered','returned','cancelled'].includes(s)) { %>
                  <% if (s === 'delivered') { %>
                    <button class="btn-act warning" onclick="requestReturn('<%= order.orderId %>', <%= itemIdx %>)">
                      <i class="fas fa-undo" style="font-size:11px;"></i> Request Return
                    </button>
                  <% } else { %>
                    <span class="btn-act no-action">—</span>
                  <% } %>

                <% } else { %>
                  <button class="btn-act danger" onclick="requestCancel('<%= order.orderId %>', <%= itemIdx %>)">
                    <i class="fas fa-times" style="font-size:11px;"></i> Cancel Item
                  </button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function requestCancel(orderId, itemIndex) {
    Swal.fire({
      title: 'Cancel This Item?',
      text: 'Please provide a reason for cancellation.',
      input: 'textarea',
      inputPlaceholder: 'Reason for cancellation...',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Submit',
      confirmButtonColor: '#dc2626',
      inputValidator: v => !v ? 'Please provide a reason!' : undefined
    }).then(result => {
      if (!result.isConfirmed) {
        return;
      }
      fetch('/cancelOrder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, itemIndex, reason: result.value })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({ icon: 'success', title: 'Submitted', text: data.message || 'Cancellation submitted', timer: 1800, showConfirmButton: false })
            .then(() => location.reload());
        } else {
          Swal.fire({ icon: 'error', title: 'Failed', text: data.message || 'Failed to cancel item' });
        }
      })
      .catch(() => Swal.fire({ icon: 'error', title: 'Error', text: 'Error cancelling item' }));
    });
  }

  function requestReturn(orderId, itemIndex) {
    Swal.fire({
      title: 'Request Return',
      text: 'Please provide a reason for return.',
      input: 'textarea',
      inputPlaceholder: 'Reason for return...',
      showCancelButton: true,
      confirmButtonText: 'Submit',
      confirmButtonColor: '#d97706',
      inputValidator: v => !v ? 'Please provide a reason!' : undefined
    }).then(result => {
      if (!result.isConfirmed) {
        return;
      }
      fetch('/orders/return-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, itemIndex, reason: result.value })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success || data.message) {
          Swal.fire({ icon: 'success', title: 'Submitted', text: data.message || 'Return request submitted', timer: 1800, showConfirmButton: false })
            .then(() => location.reload());
        } else {
          Swal.fire({ icon: 'error', title: 'Failed', text: data.message || 'Failed to submit return request' });
        }
      })
      .catch(() => Swal.fire({ icon: 'error', title: 'Error', text: 'Error submitting return request' }));
    });
  }
</script>

<%- include('../partials/user/footer') %>
