<script>
  document.addEventListener('DOMContentLoaded', function () {
    const incBtn = document.querySelector('.btn-increase');
    const decBtn = document.querySelector('.btn-decrease');
    const input = document.querySelector('.quantity-input');
  
    if (!incBtn || !decBtn || !input) {
      console.warn("Quantity input or buttons not found.");
      return;
    }
  
    incBtn.addEventListener('click', () => {
      let value = parseInt(input.value) || 1;
  
      if (value < 3) {
        input.value = value + 1;
      } else {
        Swal.fire({
          icon: 'warning',
          title: 'Limit Reached',
          text: 'You can only buy up to 3 units of this product.'
        });
        input.value = 3; // Force restore if exceeded
      }
    });
  
    decBtn.addEventListener('click', () => {
      let value = parseInt(input.value) || 1;
  
      if (value > 1) {
        input.value = value - 1;
      } else {
        Swal.fire({
          icon: 'info',
          title: 'Minimum Limit',
          text: 'You must order at least 1 unit.'
        });
        input.value = 1;
      }
    });
  });
  //image zoom
</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/elevatezoom/3.0.8/jquery.elevateZoom.min.js"></script>

<script>
  // Activate Lens Zoom on load
  $(document).ready(function(){
    $('#main-image').elevateZoom({
      zoomType: "lens",
      lensShape: "round",
      lensSize: 170,
      containLensZoom: true,
      borderSize: 1,
      cursor: "crosshair"
    });
  });

  // Change image on thumbnail click
  function changeImage(newSrc) {
    // Update source
    $('#main-image').attr('src', newSrc);
    $('#main-image').data('zoom-image', newSrc);

    // Remove old zoom glass
    $('.zoomContainer').remove();

    // Reapply zoom
    $('#main-image').elevateZoom({
      zoomType: "lens",
      lensShape: "round",
      lensSize: 170,
      containLensZoom: true,
      borderSize: 1,
      cursor: "crosshair"
    });
  }
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ratingContainers = document.querySelectorAll('.wrap-rating');
    ratingContainers.forEach(container => {
      const stars = container.querySelectorAll('.item-rating');
      const input = container.querySelector('input[name="rating"]');

      stars.forEach((star, index) => {
        star.addEventListener('click', () => {
          input.value = index + 1;
          stars.forEach((s, i) => {
            s.classList.toggle('zmdi-star', i <= index);
            s.classList.toggle('zmdi-star-outline', i > index);
          });
        });
      });
    });
  });
</script>

<script>
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.btn-delete-review');
    if (!btn) return;
  
    const productId = btn.getAttribute('data-product-id');
    const ratingId  = btn.getAttribute('data-rating-id');
  
    // Confirm (SweetAlert2 if available; fallback to confirm)
    let confirmed = true;
    if (window.Swal) {
      const res = await Swal.fire({
        title: 'Delete this review?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Delete',
        cancelButtonText: 'Cancel'
      });
      confirmed = res.isConfirmed;
    } else {
      confirmed = window.confirm('Delete this review?');
    }
    if (!confirmed) return;
  
    try {
      const resp = await fetch(`/product/${productId}/review/${ratingId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
       
      });
  
      const data = await resp.json();
      if (!resp.ok || !data.success) {
        throw new Error(data.error || 'Delete failed');
      }
  
      // Remove from DOM
      const row = document.getElementById(`review-${ratingId}`);
      if (row) row.remove();
  
      // Update count & empty state
      const countEl = document.getElementById('reviews-count');
      if (countEl) {
        const newCount = data.ratingsCount ?? Math.max(0, (parseInt(countEl.textContent || '1', 10) - 1));
        countEl.textContent = String(newCount);
      }
      const container = document.getElementById('reviews-container') || document; // adjust if needed
      const noMsg = document.getElementById('no-reviews-msg');
      const anyLeft = !!document.querySelector('[id^="review-"]');
      if (!anyLeft && noMsg) noMsg.style.display = '';
  
      if (window.Swal) {
        Swal.fire({ icon: 'success', title: 'Deleted', timer: 900, showConfirmButton: false });
      }
    } catch (err) {
      console.error(err);
      if (window.Swal) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message || 'Delete failed' });
      } else {
        alert('Delete failed');
      }
    }
  });
  </script>
  


