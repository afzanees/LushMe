<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Page</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">


  <link href="/css/login.css" rel="stylesheet">
</head>
<style>
  .password-box {
    position: relative;
  }
  
  .password-box .form-control {
    padding-right: 40px; /* space for eye icon */
  }
  
  .password-box .eye {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    color: gray;
    z-index: 5;
  }
  </style>
<body>

  <div class="container login-container row">
    <!-- Left Form Section -->
    <div class="col-md-6 form-section">
      <div class="text-center mb-4">
        <img class="p-0 " src="./images/logo.png" width="auto" height="40px"><use xlink:href=""></use> </a>
      </div>

      <!-- Google Login -->
      <button class="google-btn">
        <img src="https://www.google.com/favicon.ico" width="20" alt="Google Logo" />
        Login with Google
      </button>

      <!-- Divider -->
      <div class="divider">or</div>

      <!-- Server Error Message Display -->
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- Email/Password Form -->
      <form id="signform" method="post" action="/register">
        <div class="mb-3">
          <input type="text" id="username" class="form-control" name="username" placeholder="Username" value="<%= typeof formData !== 'undefined' ? formData.username || '' : '' %>" required />
        <div id="error1" class="error-message"></div>
        </div>
        <div class="mb-3">
          <input type="email" id="email" class="form-control" name="email" placeholder="Email" value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>" required />
          <div id="error2" class="error-message"></div>
        </div>
        <div class="mb-3">
          <input type="text" id="phone" class="form-control" name="phone" placeholder="Phone Number" value="<%= typeof formData !== 'undefined' ? formData.phone || '' : '' %>" required />
          <div id="error3" class="error-message"></div>
        </div>
        <div class="mb-3 password-box">
          <input type="password" id="password" class="form-control" name="password" placeholder="Password" required />
          <i class="fa fa-eye-slash eye" onclick="togglePassword('password', this)"></i>
          <div id="error4" class="error-message"></div>
        </div>
        <div class="mb-3 password-box" >
          <input type="password" id="cpassword" class="form-control" name="cpassword" placeholder="Confirm Password" required />
          <i class="fa fa-eye-slash eye" onclick="togglePassword('cpassword', this)"></i>
          <div id="error5" class="error-message"></div>
        </div>

        <div class="mb-3">
          <label class="form-label text-muted small">Have a referral code?</label>
          <input type="text" id="referralCode" class="form-control" name="referralCode" placeholder="Enter referral code (optional)" value="<%= typeof formData !== 'undefined' ? formData.referralCode || '' : '' %>" />
          <div id="error6" class="error-message"></div>
        </div>

        <button type="submit" class="login-btn">Register</button>
      </form>

      <div class="signup">
        Already have an account? <a href="/login">Login now...!</a>
      </div>


      
    </div>

    <!-- Right Image Section -->
    <div class="col-md-6 image-section p-0 ">
      <img src="./images/login3.jpg" alt="Beauty Model" />
    </div>
  </div>

</body>
</html>
</html>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Display server error message using SweetAlert -->
<% if (typeof message !== 'undefined' && message) { %>
<script>
  Swal.fire({
    icon: 'error',
    title: 'Registration Error',
    text: '<%= message %>',
    confirmButtonColor: '#d33'
  });
</script>
<% } %>

<script>

  const nameid = document.getElementById("username");
  const emailid = document.getElementById("email");
  const phoneid = document.getElementById("phone")
  const passid = document.getElementById("password")
  const cpassid = document.getElementById("cpassword")
  const error1 = document.getElementById("error1")
  const error2 = document.getElementById("error2")
  const error3 = document.getElementById("error3")
  const error4 = document.getElementById("error4")
  const error5 = document.getElementById("error5")
  const signform = document.getElementById("signform");

  function nameValidateChecking(e){
    const nameval = nameid.value;
    const namepattern = /^[A-Za-z\s]+$/;

    if(nameval.trim() === ""){
      error1.style.display="block";
      error1.innerHTML="please enter a valid name";
    }else if (!namepattern.test(nameval)){
      error1.style.display = "block";
      error1.innerHTML = "Name can only contain alphabets and spaces"
    }else{
      error1.style.display = "none";
      error1.innerHTML = "";
    }
  }

  function emailValidateChecking(e){
    const emailval = emailid.value;
    const emailpattern = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;

    if(!emailpattern.test(emailval)){
      error2.style.display = "block";
      error2.innerHTML="invalid format";
    }else{
      error2.style.display = "none";
      error2.innerHTML = "";
    }

  }

  function phoneValidateChecking(e) {
  const phoneval = phoneid.value.trim();

  if (phoneval === "") {
    error3.style.display = "block";
    error3.innerHTML = "Enter valid phone number";

  } else if (!/^(?!0{10})\d{10}$/.test(phoneval)) {
    error3.style.display = "block";
    error3.innerHTML = "Enter a valid 10-digit phone number";

  } else {
    error3.style.display = "none";
    error3.innerHTML = "";
  }
}

function passValidateChecking(e) {
  const passval = passid.value.trim();
  const cpassval = cpassid.value.trim();

  const strongPassword =
    /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/;

  // password strength check
  if (passval === "") {
    error4.style.display = "block";
    error4.innerHTML = "Enter password";

  } else if (!strongPassword.test(passval)) {
    error4.style.display = "block";
    error4.innerHTML =
      "Password must have uppercase, lowercase, number & special character";

  } else {
    error4.style.display = "none";
    error4.innerHTML = "";
  }

  // confirm password check
  if (cpassval !== "" && passval !== cpassval) {
    error5.style.display = "block";
    error5.innerHTML = "Password does not match";
  } else {
    error5.style.display = "none";
    error5.innerHTML = "";
  }
}


  

  document.addEventListener("DOMContentLoaded",function(){
    signform.addEventListener("submit",function(e){

      nameValidateChecking();
      emailValidateChecking();
      phoneValidateChecking();
      passValidateChecking();

      // if(
      //   !nameid ||
      //   !emailid ||
      //   !phoneid ||
      //   !passid ||
      //   !error1 ||
      //   !error2 ||
      //   !error3 ||
      //   !error4 ||
      //   !error5 ||
      //   !signform
      // ){
      //   console.error("one or more elements noyt found")
      // }
      if(
        error1.innerHTML || 
        error2.innerHTML ||
        error3.innerHTML ||            //If any input has an error message showing,   the form submission will be blocked until all validations are fixed.
        error4.innerHTML ||
        error5.innerHTML 
      ){
        e.preventDefault()
      }

    })
  })

  function togglePassword(inputId, icon) {
  const pwd = document.getElementById(inputId);

  if (pwd.type === "password") {
    pwd.type = "text";
    icon.classList.replace("fa-eye-slash", "fa-eye"); // FIXED
  } else {
    pwd.type = "password";
    icon.classList.replace("fa-eye", "fa-eye-slash"); // FIXED
  }
}


</script>

