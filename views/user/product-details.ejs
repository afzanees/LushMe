<%- include('../partials/user/header') %>

<!-- ============ STYLES ============ -->
<style>
  .thumbs-col img{
    cursor:pointer;
    border-radius:6px;
    margin-bottom:10px;
    width:100%;
    height:90px;
    object-fit:cover;
    border:1px solid #e9ecef;
    transition:transform .15s ease, border-color .15s ease;
  }
  .thumbs-col img:hover{ transform:scale(1.03); border-color:#0d6efd; }
  #main-image{
    width:100%;
    max-height:470px;
    object-fit:cover;
    border-radius:10px;
    border:1px solid #e9ecef;
  }
  /* elevateZoom overlay sits in .zoomContainer (added at runtime) */
  .zoomContainer{ z-index:10000 !important; }

  .qty-wrap{
    display:inline-flex; align-items:center; gap:6px; border:1px solid #ced4da;
    border-radius:8px; padding:4px 8px;
  }
  .qty-btn{
    width:34px; height:34px; border:none; background:#f2f2f2; font-weight:700;
  }
  .qty-input{
    width:60px; text-align:center; border:none; outline:none;
  }
</style>

<section class="sec-product-detail bg0 p-t-65 p-b-60 mt-4">
  <div class="container">
    <div class="row g-4">
      <!-- ============ LEFT IMAGES ============ -->
      <div class="col-lg-7">
        <div class="row g-3 align-items-start">
          <!-- Thumbnails -->
          <div class="col-3 thumbs-col">
            <% 
              // Get first variant's images or empty array
              let displayImages = [];
              if (product.variants && product.variants.length > 0 && product.variants[0].productImage) {
                displayImages = product.variants[0].productImage;
              }
            %>
            <% if (displayImages && displayImages.length) { %>
              <% displayImages.forEach(function(img){ %>
                <img
                  src="/<%= img %>"
                  alt="thumb"
                  onclick="changeImage('/<%= img %>')"
                />
              <% }) %>
            <% } else { %>
              <div class="text-muted small">No images</div>
            <% } %>
          </div>

          <!-- Main image (hover zoom) -->
          <div class="col-9">
            <% 
              let mainImageUrl = 'images/placeholder-800x800.png';
              if (displayImages && displayImages.length > 0) {
                mainImageUrl = displayImages[0];
              }
            %>
            <img
              id="main-image"
              src="/<%= mainImageUrl %>"
              data-zoom-image="/<%= mainImageUrl %>"
              alt="<%= product.name %>"
              class="img-fluid shadow-sm"
            />
            <div class="mt-2 text-muted small">Hover to zoom</div>
          </div>
        </div>
      </div>

      <!-- ============ RIGHT INFO ============ -->
      <div class="col-lg-5">
        <div class="p-2 p-lg-3">
          <h1 class="h3 mb-2"><%= product.name %></h1>

          <!-- Price from variants: show min salePrice vs regularPrice -->
          <% 
            let minVar = null;
            if (product.variants && product.variants.length) {
              minVar = product.variants.reduce((a,b)=> (a.salePrice < b.salePrice ? a : b));
            }
          %>
          <div class="mb-3">
            <% if (minVar) { %>
              <% if (minVar.salePrice < minVar.regularPrice) { %>
                <div class="fs-4 fw-bold text-danger">₹ <%= Math.round(minVar.salePrice) %></div>
                <div class="text-muted">
                  <del>₹ <%= Math.round(minVar.regularPrice) %></del>
                </div>
              <% } else { %>
                <div class="fs-4 fw-bold">₹ <%= Math.round(minVar.regularPrice) %></div>
              <% } %>
            <% } else { %>
              <div class="fs-6 text-muted">No price available</div>
            <% } %>
          </div>

          <p class="mb-2">Brand: <span class="fw-semibold text-danger"><%= product.brand?.name || 'N/A' %></span></p>

          <!-- Color selector -->
          <div class="mb-3">
            <label class="form-label">Color</label>
            <select class="form-select" id="colorSelect" name="color" required>
              <option value="" disabled selected>Choose color</option>
              <% 
                const colors = [];
                (product.variants||[]).forEach(v => { if (v.color && !colors.includes(v.color)) colors.push(v.color) });
                colors.forEach(c => { %>
                  <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>

          <!-- Availability (sum quantities) -->
          <div class="mb-3">
            <% 
              const totalQty = (product.variants||[]).reduce((s,v)=> s + (Number(v.quantity)||0), 0);
            %>
            <span>Availability: </span>
            <% if (totalQty > 0) { %>
              <span class="text-success fw-semibold">In stock</span>
            <% } else { %>
              <span class="text-danger fw-semibold">Out of stock</span>
            <% } %>
          </div>

          <!-- Quantity + Add to Cart -->
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="qty-wrap">
              <button class="qty-btn" type="button" onclick="decQty()">−</button>
              <input class="qty-input" id="qtyInput" type="number" min="1" max="3" value="1" readonly />
              <button class="qty-btn" type="button" onclick="incQty()">+</button>
            </div>

            <button
              type="button"
              class="btn btn-primary px-4"
              onclick="addToCart('<%= product._id %>')"
              <%= totalQty > 0 ? '' : 'disabled' %>>
              Add to Cart
            </button>
          </div>

          <!-- Wishlist -->
          <div class="d-flex align-items-center gap-2">
            <button
              class="btn btn-outline-secondary btn-sm"
              onclick="addToWishlist('<%= product._id %>', event)">
              ♥ Add to Wishlist
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="mt-5">
      <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#desc" role="tab">Description</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#info" role="tab">Additional Info</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#reviews" role="tab">Reviews (<%= product.ratings ? product.ratings.length : 0 %>)</a></li>
      </ul>

      <div class="tab-content p-3 border border-top-0 rounded-bottom">
        <div class="tab-pane fade show active" id="desc" role="tabpanel">
          <p class="mb-0"><%= product.description %></p>
        </div>

        <div class="tab-pane fade" id="info" role="tabpanel">
          <ul class="mb-0">
            <li><strong>Colors:</strong>
              <% const uniqueColors = [];
                 (product.variants||[]).forEach(v => { if(v.color && !uniqueColors.includes(v.color)) uniqueColors.push(v.color) });
              %>
              <%= uniqueColors.length ? uniqueColors.join(', ') : 'N/A' %>
            </li>
          </ul>
        </div>

        <div class="tab-pane fade" id="reviews" role="tabpanel">
          <% if(product.ratings && product.ratings.length){ %>
            <% product.ratings.forEach(r => { %>
              <div class="border-bottom py-3">
                <div class="fw-semibold"><%= r.userId ? (r.userId.name || 'User') : 'User' %></div>
                <div class="text-warning small mb-1">
                  <% for(let i=1;i<=5;i++){ %>
                    <i class="zmdi <%= i<=r.rating ? 'zmdi-star' : 'zmdi-star-outline' %>"></i>
                  <% } %>
                </div>
                <div><%= r.review %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-muted">No reviews yet.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ElevateZoom plugin -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/elevatezoom/3.0.8/jquery.elevateZoom.min.js"></script>

<script>
  // Store all variants data for quick access
  const allVariants = <%- JSON.stringify(product.variants || []) %>;
  
  // Init lens-zoom on main image
  $(function(){
     $('#main-image').removeData('elevateZoom');
    $('#main-image').elevateZoom({
      zoomType: "lens",
      lensShape: "round",
      lensSize: 170,
      containLensZoom: true,
      borderSize: 1,
      cursor: "crosshair"
    });
  });

  // Update images when color is selected
  document.getElementById('colorSelect').addEventListener('change', function() {
    const selectedColor = this.value;
    const variant = allVariants.find(v => v.color === selectedColor);
    
    if (variant && variant.productImage && variant.productImage.length > 0) {
      // Update thumbnails
      const thumbsCol = document.querySelector('.thumbs-col');
      thumbsCol.innerHTML = '';
      
      variant.productImage.forEach(img => {
        const imgElement = document.createElement('img');
        imgElement.src = '/' + img;
        imgElement.alt = 'thumb';
        imgElement.onclick = function() { changeImage('/' + img); };
        thumbsCol.appendChild(imgElement);
      });
      
      // Update main image
      changeImage('/' + variant.productImage[0]);
    }
  });

  // Switch image from thumbnail
  function changeImage(newSrc){
    const $img = $('#main-image');

    // update src + zoom image
    $img.attr('src', newSrc);
    $img.attr('data-zoom-image', newSrc);

    // remove old zoom container & re-init
    $('.zoomContainer').remove();
    $img.removeData('elevateZoom'); // clear plugin data
    $img.elevateZoom({
      zoomType: "lens",
      lensShape: "round",
      lensSize: 170,
      containLensZoom: true,
      borderSize: 1,
      cursor: "crosshair"
    });
  }

  // Qty controls (1..3)
  function incQty(){
    const el = document.getElementById('qtyInput');
    const v = parseInt(el.value||'1',10);
    el.value = Math.min(3, v+1);
  }
  function decQty(){
    const el = document.getElementById('qtyInput');
    const v = parseInt(el.value||'1',10);
    el.value = Math.max(1, v-1);
  }

  // Add to cart (no size)
  async function addToCart(productId){
    const color = document.getElementById('colorSelect').value;
    const qty = parseInt(document.getElementById('qtyInput').value, 10);

    if(!color){ return alert('Please choose a color'); }
    if(!qty || qty<1){ return alert('Invalid quantity'); }

    try{
      const res = await fetch('/addToCart', {
        method:'POST',
        headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ productId, color, quantity: qty })
      });

      const ct = res.headers.get('content-type')||'';
      if(!ct.includes('application/json')){
        const text = await res.text();
        console.error('Non-JSON:', text);
        alert('Unexpected response');
        return;
      }
      const data = await res.json();
      if(res.ok && data.status){
        alert('Added to cart');
      }else{
        alert(data.message || 'Failed to add to cart');
      }
    }catch(err){
      console.error(err);
      alert('Something went wrong');
    }
  }

  // Wishlist
  function addToWishlist(productId, e){
    e && e.preventDefault();
    $.post('/addToWishlist', { productId })
      .done(resp => {
        if(resp.status){ alert('Added to wishlist'); }
        else{ alert(resp.message || 'Already in wishlist'); }
      })
      .fail(()=> alert('Failed to add to wishlist'));
  }
</script>

<%- include('../partials/user/footer') %>
