<%- include("../partials/user/header") -%>

<!-- ============ STYLES ============ -->
<style>
  .thumbs-col img{
    cursor:pointer;
    border-radius:6px;
    margin-bottom:10px;
    width:100%;
    height:90px;
    object-fit:cover;
    border:1px solid #e9ecef;
    transition:transform .15s ease, border-color .15s ease;
  }
  .thumbs-col img:hover{ transform:scale(1.03); border-color:#0d6efd; }
  #main-image{
    width:100%;
    max-height:470px;
    object-fit:cover;
    border-radius:10px;
    border:1px solid #e9ecef;
    cursor: crosshair;
  }
  /* elevateZoom overlay sits in .zoomContainer (added at runtime) */
  .zoomContainer{ 
    z-index:10000 !important; 
  }
  .zoomLens {
    border: 2px solid #888;
    background-color: rgba(255, 255, 255, 0.4);
  }
  .qty-wrap{
    display:inline-flex; align-items:center; gap:6px; border:1px solid #ced4da;
    border-radius:8px; padding:4px 8px;
  }
  .qty-btn{
    width:34px; height:34px; border:none; background:#f2f2f2; font-weight:700;
  }
  .qty-input{
    width:60px; text-align:center; border:none; outline:none;
  }
  .wishlist-btn.wishlisted {
    background-color: #6c757d;
    border-color: #6c757d;
    color: #fff;
  }
  .wishlist-btn.wishlisted:hover {
    background-color: #5c636a;
    border-color: #565e64;
    color: #fff;
  }
</style>

<section class="sec-product-detail bg0 p-t-65 p-b-60 mt-4">
  <div class="container">
    <div class="row g-4">
      <!-- ============ LEFT IMAGES ============ -->
      <div class="col-lg-7">
        <div class="row g-3 align-items-start">
          <!-- Thumbnails -->
          <div class="col-3 thumbs-col">
            <% 
              // Get first variant's images or empty array
              let displayImages = [];
              if (product.variants && product.variants.length > 0 && product.variants[0].productImage) {
                displayImages = product.variants[0].productImage;
              }
            %>
            <% if (displayImages && displayImages.length) { %>
              <% displayImages.forEach(function(img){ %>
                <img
                  src="/<%= img %>"
                  alt="thumb"
                  onmouseover="changeImage('/<%= img %>')"
                />
              <% }) %>
            <% } else { %>
              <div class="text-muted small">No images</div>
            <% } %>
          </div>

          <!-- Main image (hover zoom) -->
          <div class="col-9">
            <% 
              let mainImageUrl = 'images/placeholder-800x800.png';
              if (displayImages && displayImages.length > 0) {
                mainImageUrl = displayImages[0];
              }
            %>
            <img
              id="main-image"
              src="/<%= mainImageUrl %>"
              data-zoom-image="/<%= mainImageUrl %>"
              alt="<%= product.name %>"
              class="img-fluid shadow-sm"
            />
            <div class="mt-2 text-muted small">Hover to zoom</div>
          </div>
        </div>
      </div>

      <!-- ============ RIGHT INFO ============ -->
      <div class="col-lg-5">
        <div class="p-2 p-lg-3">
          <h1 class="h3 mb-2"><%= product.name %></h1>

          <!-- Price from variants: show min salePrice vs regularPrice -->
          <% 
            let minVar = null;
            if (product.variants && product.variants.length) {
              minVar = product.variants.reduce((a,b)=> (a.salePrice < b.salePrice ? a : b));
            }
          %>

          <div class="mb-3" id="priceDisplay">
            <% if (minVar) { %>
          
              <% if (effectiveOffer > 0) { %>
                <span class="badge bg-danger mb-2"><%= effectiveOffer %>% OFF</span>
              <% } %>
          
              <% if (minVar.salePrice < minVar.regularPrice) { %>
                <div class="text-muted mb-1">
                  <del style="font-size:15px;">₹ <%= Math.round(minVar.regularPrice).toLocaleString('en-IN') %></del>
                </div>
                <div class="fs-4 fw-bold text-success" id="salePrice">
                  ₹ <%= Math.round(minVar.salePrice).toLocaleString('en-IN') %>
                </div>
              <% } else { %>
                <div class="fs-4 fw-bold" id="salePrice">
                  ₹ <%= Math.round(minVar.regularPrice).toLocaleString('en-IN') %>
                </div>
              <% } %>
          
            <% } else { %>
              <div class="fs-6 text-muted">No price available</div>
            <% } %>
          </div>

          <p class="mb-2">Brand: <span class="fw-semibold text-danger"><%= product.brand?.name || 'N/A' %></span></p>

          <!-- Color selector -->
          <div class="mb-3">
            <label class="form-label">Color</label>
            <select class="form-select" id="colorSelect" name="color" required>
              <option value="" disabled selected>Choose color</option>
              <% 
                const colors = [];
                (product.variants||[]).forEach(v => { if (v.color && !colors.includes(v.color)) colors.push(v.color) });
                colors.forEach(c => { %>
                  <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>

          <!-- Availability (check product status and quantity) -->
          <div class="mb-3">
            <% 
              const totalQty = (product.variants||[]).reduce((s,v)=> s + (Number(v.quantity)||0), 0);
              const isOutOfStock = totalQty === 0 || product.status === "Out Of Stock";
              const isBlocked = product.isBlocked;
            %>
            <span>Availability: </span>
            <% if (isBlocked) { %>
              <span class="text-secondary fw-semibold">Unavailable</span>
            <% } else if (isOutOfStock) { %>
              <span class="text-danger fw-semibold">Out of stock</span>
            <% } else { %>
              <span class="text-success fw-semibold">In stock (<%= totalQty %> available)</span>
            <% } %>
          </div>

          <!-- Quantity + Add to Cart -->
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="qty-wrap">
              <button class="qty-btn" type="button" onclick="decQty()" <%= isOutOfStock || isBlocked ? 'disabled' : '' %>>−</button>
              <input class="qty-input" id="qtyInput" type="number" min="1" max="3" value="1" readonly />
              <button class="qty-btn" type="button" onclick="incQty()" <%= isOutOfStock || isBlocked ? 'disabled' : '' %>>+</button>
            </div>

            <button
              type="button"
              class="btn <%= isOutOfStock || isBlocked ? 'btn-secondary' : 'btn-primary' %> px-4"
              onclick="addToCart('<%= product._id %>')"
              <%= isOutOfStock || isBlocked ? 'disabled' : '' %>>
              Add to Cart
            </button>
          </div>

          <!-- Wishlist -->
          <div class="d-flex align-items-center gap-2">
            <% const isWishlisted = wishlistIds && wishlistIds.includes(product._id.toString()); %>
            <button
              id="wishlistBtn"
              class="btn btn-sm wishlist-btn <%= isWishlisted ? 'btn-dark wishlisted' : 'btn-outline-secondary' %>"
              data-wishlisted="<%= isWishlisted ? 'true' : 'false' %>"
              title="<%= isWishlisted ? 'Already in wishlist' : 'Add to wishlist' %>"
              onclick="addToWishlist('<%= product._id %>', event)">
              <%= isWishlisted ? '♥ Wishlisted' : '♥ Add to Wishlist' %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="mt-5">
      <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#desc" role="tab">Description</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#info" role="tab">Additional Info</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#reviews" role="tab">Reviews (<%= product.ratings ? product.ratings.length : 0 %>)</a></li>
      </ul>

      <div class="tab-content p-3 border border-top-0 rounded-bottom">
        <div class="tab-pane fade show active" id="desc" role="tabpanel">
          <p class="mb-0"><%= product.description %></p>
        </div>

        <div class="tab-pane fade" id="info" role="tabpanel">
          <ul class="mb-0">
            <li><strong>Colors:</strong>
              <% const uniqueColors = [];
                 (product.variants||[]).forEach(v => { if(v.color && !uniqueColors.includes(v.color)) uniqueColors.push(v.color) });
              %>
              <%= uniqueColors.length ? uniqueColors.join(', ') : 'N/A' %>
            </li>
          </ul>
        </div>

        <div class="tab-pane fade" id="reviews" role="tabpanel">
          <% if(product.ratings && product.ratings.length){ %>
            <% product.ratings.forEach(r => { %>
              <div class="border-bottom py-3">
                <div class="fw-semibold"><%= r.userId ? (r.userId.name || 'User') : 'User' %></div>
                <div class="text-warning small mb-1">
                  <% for(let i=1;i<=5;i++){ %>
                    <i class="zmdi <%= i<=r.rating ? 'zmdi-star' : 'zmdi-star-outline' %>"></i>
                  <% } %>
                </div>
                <div><%= r.review %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-muted">No reviews yet.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  // Store all variants data for quick access
  const allVariants = <%- JSON.stringify(product.variants || []) %>;
  
  // Init lens-zoom on main image (using elevatezoom-plus from header)
  $(document).ready(function(){
    $('#main-image').ezPlus({
      zoomType: "lens",
      lensShape: "round",
      lensSize: 200,
      borderSize: 2,
      cursor: "crosshair",
      responsive: true,
      easing: true,
      lensFadeIn: 300,
      lensFadeOut: 300
    });
  });

  // Update images when color is selected
  let selectedVariantIndex = null;

document.getElementById('colorSelect').addEventListener('change', function () {
  const selectedColor = this.value;

  selectedVariantIndex = allVariants.findIndex(
    v => v.color === selectedColor
  );

  if (selectedVariantIndex === -1) {
    selectedVariantIndex = null;
    return;
  }

  const variant = allVariants[selectedVariantIndex];
    
    // Update price based on selected variant
    if (variant) {
      const priceDisplay = document.getElementById('priceDisplay');
      const salePrice = Math.round(variant.salePrice);
      const regularPrice = Math.round(variant.regularPrice);
      
      if (salePrice < regularPrice) {
        priceDisplay.innerHTML = `
          <div class="fs-4 fw-bold text-success" id="salePrice">₹ ${salePrice}</div>
          <div class="text-muted" id="regularPrice">
            <del>₹ ${regularPrice}</del>
          </div>
        `;
      } else {
        priceDisplay.innerHTML = `
          <div class="fs-4 fw-bold" id="salePrice">₹ ${regularPrice}</div>
        `;
      }
    }
    
    if (variant && variant.productImage && variant.productImage.length > 0) {
      // Update thumbnails
      const thumbsCol = document.querySelector('.thumbs-col');
      thumbsCol.innerHTML = '';
      
      variant.productImage.forEach(img => {
  const imgElement = document.createElement('img');
  imgElement.src = '/' + img;
  imgElement.alt = 'thumb';

  // ✅ Hover event added
  imgElement.onmouseover = function() {
    changeImage('/' + img);
  };

  thumbsCol.appendChild(imgElement);
});
      // Update main image
      changeImage('/' + variant.productImage[0]);
    }
  });

  // Switch image from thumbnail
  function changeImage(newSrc){
    if(!newSrc.startsWith('/')){
      newSrc = '/' + newSrc;
    }
    const $img = $('#main-image');

    // update src + zoom image
    $img.attr('src', newSrc);
    $img.attr('data-zoom-image', newSrc);

    // remove old zoom and re-init with ezPlus
    const ezApi = $img.data('ezPlus');
    if (ezApi) {
      ezApi.destroy();
    }
    
    $img.ezPlus({
      zoomType: "lens",
      lensShape: "round",
      lensSize: 200,
      borderSize: 2,
      cursor: "crosshair",
      responsive: true,
      easing: true,
      lensFadeIn: 300,
      lensFadeOut: 300
    });
  }

  // Qty controls (1..3)
  function incQty(){
    const btn = event.target;
    if (btn.disabled) return;
    const el = document.getElementById('qtyInput');
    const v = parseInt(el.value||'1',10);
    el.value = Math.min(3, v+1);
  }
  function decQty(){
    const btn = event.target;
    if (btn.disabled) return;
    const el = document.getElementById('qtyInput');
    const v = parseInt(el.value||'1',10);
    el.value = Math.max(1, v-1);
  }

  // Add to cart (no size)
  async function addToCart(productId){
    const color = document.getElementById('colorSelect').value;
    const qty = parseInt(document.getElementById('qtyInput').value, 10);

    if (selectedVariantIndex === null) {
      return Swal.fire({
        icon: 'warning',
        title: 'Color Required',
        text: 'Please choose a color first'
      });
    }
    
    if(!qty || qty<1){ 
      return Swal.fire({
        icon: 'warning',
        title: 'Invalid Quantity',
        text: 'Please enter a valid quantity'
      });
    }

    try{
      const res = await fetch('/addToCart', {
        method:'POST',
        headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ productId, variantIndex: selectedVariantIndex, quantity: qty })
      });

      const ct = res.headers.get('content-type')||'';
      if(!ct.includes('application/json')){
        const text = await res.text();
        console.error('Non-JSON:', text);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Unexpected response from server'
        });
        return;
      }
      const data = await res.json();
      if(res.ok && data.status){
        Swal.fire({
          icon: 'success',
          title: 'Success!',
          text: 'Product added to cart',
          showConfirmButton: false,
          timer: 1500
        });
      }else{
        Swal.fire({
          icon: 'error',
          title: 'Failed',
          text: data.message || 'Failed to add to cart'
        });
      }
    }catch(err){
      console.error(err);
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Something went wrong. Please try again.'
      });
    }
  }

  // Wishlist
  function setWishlistButtonState(btn, wishlisted){
    if(!btn) return;
    btn.dataset.wishlisted = wishlisted ? 'true' : 'false';
    btn.classList.toggle('wishlisted', wishlisted);
    btn.classList.toggle('btn-dark', wishlisted);
    btn.classList.toggle('btn-outline-secondary', !wishlisted);
    btn.title = wishlisted ? 'Already in wishlist' : 'Add to wishlist';
    btn.textContent = wishlisted ? '♥ Wishlisted' : '♥ Add to Wishlist';
  }

  function addToWishlist(productId, e){
    e && e.preventDefault();
    const btn = e?.currentTarget || document.getElementById('wishlistBtn');
    const alreadyWishlisted = btn?.dataset?.wishlisted === 'true';

    if (alreadyWishlisted) {
      return Swal.fire({
        icon: 'info',
        title: 'Info',
        text: 'Already in wishlist'
      });
    }

    $.post('/addToWishlist', { productId })
      .done(resp => {
        if(resp.status){ 
          setWishlistButtonState(btn, true);
          Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: 'Added to wishlist',
            showConfirmButton: false,
            timer: 1500
          });
        }
        else{ 
          setWishlistButtonState(btn, true);
          Swal.fire({
            icon: 'info',
            title: 'Info',
            text: resp.message || 'Already in wishlist'
          });
        }
      })
      .fail((xhr, status, error) => {
        console.error('Wishlist error:', xhr, status, error);
        if (xhr.status === 401) {
          Swal.fire({
            icon: 'warning',
            title: 'Please Login',
            text: 'You need to login to add items to wishlist',
            confirmButtonText: 'Go to Login'
          }).then(() => {
            window.location.href = '/login';
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Failed',
            text: xhr.responseJSON?.message || 'Failed to add to wishlist'
          });
        }
      });
  }
</script>

<%- include('../partials/user/footer') %>
