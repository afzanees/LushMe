<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css"> 
</head>
<body>

<div class="container login-container row">
    <!-- Left Section -->
    <div class="col-md-6 form-section">

        <div class="text-center mb-4">
            <img src="/images/logo.png" height="40">
        </div>

        <h3 class="text-center mb-4">Reset Your Password</h3>

        <p class="text-center text-muted">Enter your new password below</p>

        <!-- Reset Password Form -->
        <form action="/update-password" method="post" id="resetForm" onsubmit="return validateResetForm()">

            <input type="hidden" name="email" value="<%= email %>">

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password" id="newPassword" name="newPassword" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required>
            </div>

            <button type="submit" class="login-btn">Update Password</button>

        </form>

        <div class="signup text-center mt-3">
            <a href="/login">Back to Login</a>
        </div>

    </div>

    <!-- Right Image -->
    <div class="col-md-6 image-section p-0">
        <img src="/images/login3.jpg" alt="">
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function validateResetForm() {
    let pass = document.getElementById("newPassword").value.trim();
    let cpass = document.getElementById("confirmPassword").value.trim();

    if (pass !== cpass) {
        Swal.fire({
            icon: "error",
            title: "Passwords do not match",
            text: "Please enter matching passwords"
        });
        return false;
    }

    if (pass.length < 6) {
        Swal.fire({
            icon: "warning",
            title: "Weak Password",
            text: "Password must be at least 6 characters"
        });
        return false;
    }

    return true;
}
</script>

</body>
</html>
