
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Page</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
  <link href="/css/login.css" rel="stylesheet">
</head>
<style>
  .password-box {
  position: relative;
}

.eye {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  color: gray;
}
</style>
<body>

  <div class="container login-container row">
    <!-- Left Form Section -->
    <div class="col-md-6 form-section">
      <div class="text-center mb-4">
        <img class="p-0 " src="./images/logo.png" width="auto" height="40px"><use xlink:href=""></use> </a>
      </div>

      <!-- Google Login -->
      <a href="/auth/google" class="google-btn">
        <img src="https://www.google.com/favicon.ico" width="20" alt="Google Logo" />
        Login with Google
      </a>

      <!-- Divider -->
      <div class="divider">or</div>

      <!-- Email/Password Form -->
      <form id="signinform" method="post" action="/login">
        <div class="mb-3">
          <input id="emailid" name="email" type="email" class="form-control" placeholder="Email"  />
          <div id="error1" class="error-message"></div>
        </div>
        <div class="mb-1 password-box" >
          <input id="passid" type="password" name="password" class="form-control" placeholder="Password" />

          <i class="fa fa-eye-slash eye" onclick="togglePassword()"></i>

          <div id="error2" class="error-message"></div>
        </div>

        <a href="/forgot-password" class="forgot-password">Forgot password?</a>

        <button type="submit" class="login-btn">Login</button>
      </form>

      <div class="signup">
        New User? <a href="/sign-up">Sign up now..!</a>
      </div>
    </div>

    <!-- Right Image Section -->
    <div class="col-md-6 image-section p-0 ">
      <img src="./images/login3.jpg" alt="Beauty Model" />
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>

    
    document.addEventListener("DOMContentLoaded", function() {
      const signform = document.getElementById("signinform");
      const emailid = document.getElementById("emailid");
      const passid = document.getElementById("passid");
    
      signform.addEventListener("submit", function(e){
        const emailVal = emailid.value.trim();
        const passVal = passid.value.trim();
    
        if(!emailVal || !passVal){
          e.preventDefault();
          alert("Please enter both email and password");
        }
      });
    });

    function togglePassword() {
      const pwd = document.getElementById("passid"); // ← FIXED
      const eye = document.querySelector(".eye");
  if (pwd.type === "password") {
    pwd.type = "text";
    eye.classList.replace("fa-eye-slash", "fa-eye");
  } else {
    pwd.type = "password";
    eye.classList.replace("fa-eye", "fa-eye-slash");
  }
}
    </script>
    

  
  

</body>
</html>
<script>
