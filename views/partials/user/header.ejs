  <style>
    .lush-header .profile-pic {
      width: 34px;
      height: 34px;
      object-fit: cover;
      border-radius: 50%;
      cursor: pointer;
    }

    .lush-header .icon-btn i {
      font-size: 20px;
      color: #222;
      transition: color 0.2s ease;
    }

    .lush-header .icon-btn:hover i {
      color: #e63946;
    }

    .lush-header .header-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .lush-header .desktop-search {
      width: 280px;
    }

    .lush-header .desktop-nav .nav-link {
      color: #212529;
    }

    .lush-header .desktop-nav .nav-link.active-link {
      color: #6c757d;
    }

    .lush-header .mobile-search {
      margin-top: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .lush-header .mobile-actions {
      width: 100%;
      justify-content: flex-start;
    }
  </style>
</head>
<body>
  <% const navProfileImage = !user?.profileImage
    ? '/images/profile.png'
    : (user.profileImage.startsWith('http') || user.profileImage.startsWith('/')
      ? user.profileImage
      : '/uploads/profile/' + user.profileImage); %>
  <header class="lush-header border-bottom mb-3">
    <div class="container py-2">
      <div class="d-none d-lg-flex flex-wrap align-items-center justify-content-between">
        <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 link-body-emphasis text-decoration-none">
          <img src="/images/logo.png" height="40" alt="Logo">
        </a>

        <ul class="nav desktop-nav col-12 col-lg-auto mb-2 mb-md-0 justify-content-center">
          <li><a href="/shop" class="nav-link px-2">Products</a></li>
        </ul>

        <form class="desktop-search me-lg-3" role="search">
          <input type="search" class="form-control" placeholder="Search..." aria-label="Search">
        </form>

        <div class="header-actions">
          <% if (user){ %>
            <div class="dropdown">
              <img
                src="<%= navProfileImage %>"
                alt="Profile"
                class="profile-pic dropdown-toggle"
                id="profileDropdownDesktop"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                role="button"
              >
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdownDesktop">
                <li><a class="dropdown-item" href="/profile">My Profile</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/logout">Logout</a></li>
              </ul>
            </div>
          <% } else { %>
            <a href="/login" aria-label="Login">
              <img src="/images/profile.png" alt="Login" class="profile-pic">
            </a>
          <% } %>

          <a href="/wishlist" class="icon-btn position-relative" aria-label="Wishlist">
            <i class="far fa-heart"></i>
            <% if (wishlistCount > 0) { %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= wishlistCount %>
              </span>
            <% } %>
          </a>

          <a href="/cart" class="icon-btn position-relative" aria-label="Cart">
            <i class="fas fa-shopping-cart"></i>
            <% if (cartCount > 0) { %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= cartCount %>
              </span>
            <% } %>
          </a>
        </div>
      </div>

      <nav class="navbar navbar-expand-lg bg-white d-lg-none p-0">
        <a href="/" class="navbar-brand d-flex align-items-center">
          <img src="/images/logo.png" height="34" alt="Logo">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userHeaderNavMobile" aria-controls="userHeaderNavMobile" aria-expanded="false" aria-label="Toggle navigation">
          <i class="fas fa-bars"></i>
        </button>

        <div class="collapse navbar-collapse" id="userHeaderNavMobile">
          <ul class="navbar-nav me-lg-3 mb-2 mb-lg-0">
            <li class="nav-item"><a href="#" class="nav-link">What's new</a></li>
            <li class="nav-item"><a href="/shop" class="nav-link">Products</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Brands</a></li>
            <li class="nav-item"><a href="#" class="nav-link">Offers</a></li>
          </ul>

          <form class="mobile-search d-flex w-100" role="search">
            <input type="search" class="form-control" placeholder="Search..." aria-label="Search">
          </form>

          <div class="header-actions mobile-actions">
            <% if (user){ %>
              <div class="dropdown">
                <img
                  src="<%= navProfileImage %>"
                  alt="Profile"
                  class="profile-pic dropdown-toggle"
                  id="profileDropdownMobile"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  role="button"
                >
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdownMobile">
                  <li><a class="dropdown-item" href="/profile">My Profile</a></li>
                  <li><a class="dropdown-item" href="/orders">My Orders</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/logout">Logout</a></li>
                </ul>
              </div>
            <% } else { %>
              <a href="/login" aria-label="Login">
                <img src="/images/profile.png" alt="Login" class="profile-pic">
              </a>
            <% } %>

            <a href="/wishlist" class="icon-btn position-relative" aria-label="Wishlist">
              <i class="far fa-heart"></i>
              <% if (wishlistCount > 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= wishlistCount %>
                </span>
              <% } %>
            </a>

            <a href="/cart" class="icon-btn position-relative" aria-label="Cart">
              <i class="fas fa-shopping-cart"></i>
              <% if (cartCount > 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= cartCount %>
                </span>
              <% } %>
            </a>
          </div>
        </div>
      </nav>
    </div>
  </header>
