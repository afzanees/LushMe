<body>
  <header class="p-3 mb-3 border-bottom">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between">

      <!-- Logo -->
      <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 link-body-emphasis text-decoration-none">
        <img src="./images/logo.png" height="40" alt="Logo">
      </a>

      <!-- Nav links -->
      <ul class="nav col-12 col-lg-auto mb-2 mb-md-0 justify-content-center">
        <li><a href="#" class="nav-link px-2 link-secondary">What's new</a></li>
        <li><a href="/shop" class="nav-link px-2 link-body-emphasis">Products</a></li>
        <li><a href="#" class="nav-link px-2 link-body-emphasis">Brands</a></li>
        <li><a href="#" class="nav-link px-2 link-body-emphasis">Offers</a></li>
      </ul>

      <!-- Search -->
      <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
        <input type="search" class="form-control" placeholder="Search..." aria-label="Search">
      </form>

      <!-- Profile + Icons -->
      <div class="d-flex align-items-center gap-3">

        <% if (user){ %>
          <!-- ✅ Logged-in user with dropdown -->
          <div class="dropdown">
            <img src="<%= user.profileImage || '/images/profile.png' %>"  alt="Profile" class="profile-pic dropdown-toggle" id="profileDropdown" data-bs-toggle="dropdown" />
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
              <li><a class="dropdown-item" href="/profile">My Profile</a></li>
              <li><a class="dropdown-item" href="/orders">My Orders</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/logout">Logout</a></li>
            </ul>
          </div>
        <% } else { %>
          <!-- 🚫 Not logged in — default icon -->
          <a href="/login">
            <img src="/images/profile.png" alt="Login" class="profile-pic" />
          </a>
        <% } %>

        <!-- ❤️ Wishlist -->
        <a href="#" class="icon-btn">
          <i class="far fa-heart"></i>
        </a>

        <!-- 🛒 Cart -->
        <a href="#" class="icon-btn">
          <i class="fas fa-shopping-cart"></i>
        </a>

      </div>

    </div>
  </div>
</header>

<!-- Bottom Navbar -->
