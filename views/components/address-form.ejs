<form action="/address/save" method="POST" id="addressForm" novalidate>

  <!-- Redirect target -->
  <input type="hidden" name="redirectTo" value="<%= redirectTo %>">

  <!-- Edit only -->
  <% if (address && address._id) { %>
    <input type="hidden" name="addressId" value="<%= address._id %>">
  <% } %>

  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label fw-semibold">Address Type</label>
      <select name="addressType" class="form-select">
        <option value="Home" <%= address?.addressType === 'Home' ? 'selected' : '' %>>Home</option>
        <option value="Office" <%= address?.addressType === 'Office' ? 'selected' : '' %>>Office</option>
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold">Full Name</label>
      <input
        type="text"
        name="name"
        class="form-control"
        value="<%= address?.name || '' %>"
        placeholder="John Doe"
      >
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold">Phone Number</label>
      <input
        type="tel"
        name="phone"
        class="form-control"
        value="<%= address?.phone || '' %>"
        placeholder="9876543210"
      >
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold">Alternate Phone (Optional)</label>
      <input
        type="tel"
        name="altPhone"
        class="form-control"
        value="<%= address?.altPhone || '' %>"
        placeholder="9876543210"
      >
    </div>

    <div class="col-12">
      <label class="form-label fw-semibold">House No / Building / Street</label>
      <input
        type="text"
        name="houseNo"
        class="form-control"
        value="<%= address?.houseNo || '' %>"
        placeholder="House No. 123, Main Street"
      >
    </div>

    <div class="col-12">
      <label class="form-label fw-semibold">Landmark</label>
      <input
        type="text"
        name="landMark"
        class="form-control"
        value="<%= address?.landMark || '' %>"
        placeholder="Near City Mall"
      >
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold">City</label>
      <input
        type="text"
        name="city"
        class="form-control"
        value="<%= address?.city || '' %>"
        placeholder="Mumbai"
      >
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold">State</label>
      <input
        type="text"
        name="state"
        class="form-control"
        value="<%= address?.state || '' %>"
        placeholder="Maharashtra"
      >
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold">Pincode</label>
      <input
        type="text"
        name="pincode"
        class="form-control"
        value="<%= address?.pincode || '' %>"
        placeholder="400001"
      >
    </div>

    <div class="col-12">
      <button type="submit" class="btn btn-primary w-100 mt-2">
        <%= address ? 'Update Address' : 'Save Address' %>
      </button>
    </div>
  </div>
</form>

<script>
  (function () {
    const form = document.getElementById('addressForm');
    if (!form) return;

    const fields = {
      addressType: form.querySelector('[name="addressType"]'),
      name: form.querySelector('[name="name"]'),
      phone: form.querySelector('[name="phone"]'),
      altPhone: form.querySelector('[name="altPhone"]'),
      houseNo: form.querySelector('[name="houseNo"]'),
      landMark: form.querySelector('[name="landMark"]'),
      city: form.querySelector('[name="city"]'),
      state: form.querySelector('[name="state"]'),
      pincode: form.querySelector('[name="pincode"]')
    };

    function getErrorEl(input) {
      let errorEl = input.parentElement.querySelector('.invalid-feedback');
      if (!errorEl) {
        errorEl = document.createElement('div');
        errorEl.className = 'invalid-feedback';
        input.parentElement.appendChild(errorEl);
      }
      return errorEl;
    }

    function setError(input, message) {
      const errorEl = getErrorEl(input);
      input.classList.add('is-invalid');
      input.classList.remove('is-valid');
      errorEl.textContent = message;
    }

    function clearError(input) {
      const errorEl = getErrorEl(input);
      input.classList.remove('is-invalid');
      if (String(input.value || '').trim()) {
        input.classList.add('is-valid');
      } else {
        input.classList.remove('is-valid');
      }
      errorEl.textContent = '';
    }

    function onlyDigits(value) {
      return String(value || '').replace(/\D/g, '');
    }

    function validateField(input) {
      const name = input.name;
      const value = String(input.value || '').trim();

      if (name === 'addressType') {
        if (!value) return setError(input, 'Please select address type'), false;
        clearError(input);
        return true;
      }

      if (name === 'name') {
        if (!value) return setError(input, 'Full name is required'), false;
        if (value.length < 2) return setError(input, 'Enter a valid name'), false;
        clearError(input);
        return true;
      }

      if (name === 'phone') {
        const digits = onlyDigits(value);
        if (!digits) return setError(input, 'Phone number is required'), false;
        if (!/^\d{10}$/.test(digits)) return setError(input, 'Phone number must be 10 digits'), false;
        clearError(input);
        return true;
      }

      if (name === 'altPhone') {
        if (!value) {
          clearError(input);
          return true;
        }
        const digits = onlyDigits(value);
        if (!/^\d{10}$/.test(digits)) return setError(input, 'Alternate phone must be 10 digits'), false;
        if (digits === onlyDigits(fields.phone.value)) return setError(input, 'Alternate phone should be different'), false;
        clearError(input);
        return true;
      }

      if (name === 'houseNo') {
        if (!value) return setError(input, 'Address line is required'), false;
        clearError(input);
        return true;
      }

      if (name === 'landMark') {
        if (!value) return setError(input, 'Landmark is required'), false;
        clearError(input);
        return true;
      }

      if (name === 'city') {
        if (!value) return setError(input, 'City is required'), false;
        clearError(input);
        return true;
      }

      if (name === 'state') {
        if (!value) return setError(input, 'State is required'), false;
        clearError(input);
        return true;
      }

      if (name === 'pincode') {
        const digits = onlyDigits(value);
        if (!digits) return setError(input, 'Pincode is required'), false;
        if (!/^\d{6}$/.test(digits)) return setError(input, 'Pincode must be 6 digits'), false;
        clearError(input);
        return true;
      }

      return true;
    }

    Object.values(fields).forEach((input) => {
      if (!input) return;
      input.addEventListener('input', function () {
        validateField(this);
      });
      input.addEventListener('change', function () {
        validateField(this);
      });
    });

    form.addEventListener('submit', function (e) {
      let isValid = true;

      Object.values(fields).forEach((input) => {
        if (!input) return;
        if (!validateField(input)) isValid = false;
      });

      if (!isValid) {
        e.preventDefault();
        const firstInvalid = form.querySelector('.is-invalid');
        if (firstInvalid) firstInvalid.focus();
      }
    });
  })();
</script>
